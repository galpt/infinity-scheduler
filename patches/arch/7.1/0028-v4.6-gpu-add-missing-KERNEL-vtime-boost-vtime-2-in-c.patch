From e6de359e714f2435a6fefe077c6f7c583c3f30c8 Mon Sep 17 00:00:00 2001
From: Galih Tama <galpt@v.recipes>
Date: Wed, 8 Jul 2026 07:51:30 +0700
Subject: [PATCH] v4.6-gpu: add missing KERNEL vtime boost (vtime >>= 2) in
 calc_vtime

Signed-off-by: Galih Tama <galpt@v.recipes>
---
 drivers/gpu/drm/scheduler/sched_main.c | 3 +++
 1 file changed, 3 insertions(+)

diff --git a/drivers/gpu/drm/scheduler/sched_main.c b/drivers/gpu/drm/scheduler/sched_main.c
index 31d9df8d8..70e8359e8 100644
--- a/drivers/gpu/drm/scheduler/sched_main.c
+++ b/drivers/gpu/drm/scheduler/sched_main.c
@@ -158,6 +158,9 @@ static inline u64 drm_sched_entity_calc_vtime(struct drm_sched_entity *entity)
 	vtime = effective_total;
 
 	switch (entity->priority) {
+	case DRM_SCHED_PRIORITY_KERNEL:
+		vtime >>= 2;
+		break;
 	case DRM_SCHED_PRIORITY_HIGH:
 		break;
 	case DRM_SCHED_PRIORITY_NORMAL:
-- 
2.55.0

