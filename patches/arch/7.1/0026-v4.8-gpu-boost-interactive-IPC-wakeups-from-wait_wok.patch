From 8c41ba5ddbd700d6a55a7ff72ac4e828042fbf6e Mon Sep 17 00:00:00 2001
From: Galih Tama <galpt@v.recipes>
Date: Mon, 3 Aug 2026 23:03:32 +0700
Subject: [PATCH 26/32] v4.8-gpu: boost interactive IPC wakeups from
 wait_woken()

Extend the interactive-wakeup vslice boost to wait_woken(): the flag is
set/cleared strictly around schedule_timeout() inside the WQ_FLAG_WOKEN
fast-path check, so the fast path never leaves a stale flag, and a wake
that arrives between set_current_state() and __schedule() never dequeues
(no ENQUEUE_WAKEUP) and is cleared on resume -- no boost, no stale flag.

The wait_woken() hook covers socket RX (TCP/UDP/UNIX via sk_wait_event,
TIPC, VSOCK, rtnetlink), the six Bluetooth protocols, NFSv4, Ceph,
fsnotify (inotify/fanotify), tty, md/raid5, i915 GVT, xe, DRM DP tunnel,
TPM, CDX, DVB and IIO; pipes/eventfd/io_uring/select/poll/epoll use
different wait paths and are unaffected.

The futex path keeps its unconditional binary 2x; the IPC path is gated
on ema == 0 (interactive) and !PF_KTHREAD, and emits no cpufreq hint
for IPC wakes (energy).  The gradient is fixed-point and monotone
non-increasing in sleep duration: full 2x at sleep <= 1ms, linear
falloff to 1x at >= 8ms.

Signed-off-by: Galih Tama <galpt@v.recipes>
---
 include/linux/sched.h         |  1 +
 kernel/sched/fair.c           | 18 ++++++++++++++++++
 kernel/sched/infinity_sched.c | 20 +++++++++++++++++++-
 kernel/sched/infinity_sched.h | 27 +++++++++++++++++++++++++++
 kernel/sched/wait.c           |  6 +++++-
 5 files changed, 70 insertions(+), 2 deletions(-)

diff --git a/include/linux/sched.h b/include/linux/sched.h
index 5c7d97f9a..c8de2ebd5 100644
--- a/include/linux/sched.h
+++ b/include/linux/sched.h
@@ -823,6 +823,7 @@ struct infinity_ctx {
 	u64		last_sleep_ns;
 	u64		rt_last_sleep_ns; /* Sleep timestamp for RT EMA decay */
 	bool		futex_waiting;
+	bool		ipc_waiting;
 
 	/**
 	 * @gpu_passovers: GPU scheduling pass-over count.
diff --git a/kernel/sched/fair.c b/kernel/sched/fair.c
index b0aa3ecc9..1ad884de5 100644
--- a/kernel/sched/fair.c
+++ b/kernel/sched/fair.c
@@ -5603,6 +5603,23 @@ place_entity(struct cfs_rq *cfs_rq, struct sched_entity *se, int flags)
 		atomic64_inc(this_cpu_ptr(&infinity_futex_boost_count));
 	}
 
+	if (entity_is_task(se) && (flags & ENQUEUE_WAKEUP) &&
+	    task_of(se)->infinity.ipc_waiting &&
+	    READ_ONCE(task_of(se)->infinity.ema) == 0 &&
+	    !(task_of(se)->flags & PF_KTHREAD)) {
+		/* Infinity: IPC gradient -- full 2x at sleep <= 1ms,
+		 * linear falloff to 1x at >= 8ms. */
+		u64 now = rq_clock(rq_of(cfs_rq));
+		u64 last = READ_ONCE(task_of(se)->infinity.last_sleep_ns);
+		u64 sleep_ns = (last && now > last) ? now - last : 0;
+		u64 red = infinity_ipc_gradient(sleep_ns);
+
+		if (red) {
+			vslice -= (vslice * red) >> INFINITY_FP_SHIFT;
+			atomic64_inc(this_cpu_ptr(&infinity_ipc_boost_count));
+		}
+	}
+
 	/*
 	 * EEVDF: vd_i = ve_i + r_i/w_i
 	 */
@@ -7458,6 +7475,7 @@ enqueue_task_fair(struct rq *rq, struct task_struct *p, int flags)
 			cpufreq_update_util(rq, SCHED_CPUFREQ_IOWAIT);
 
 		p->infinity.futex_waiting = false;
+		p->infinity.ipc_waiting = false;
 
 		if (p->in_iowait)
 			cpufreq_update_util(rq, SCHED_CPUFREQ_IOWAIT);
diff --git a/kernel/sched/infinity_sched.c b/kernel/sched/infinity_sched.c
index 5ac60566d..2a47ec3de 100644
--- a/kernel/sched/infinity_sched.c
+++ b/kernel/sched/infinity_sched.c
@@ -38,6 +38,8 @@
  */
 DEFINE_PER_CPU(atomic64_t, infinity_futex_boost_count);
 EXPORT_PER_CPU_SYMBOL(infinity_futex_boost_count);
+DEFINE_PER_CPU(atomic64_t, infinity_ipc_boost_count);
+EXPORT_PER_CPU_SYMBOL(infinity_ipc_boost_count);
 DEFINE_PER_CPU(atomic64_t, infinity_ema_climb_count);
 EXPORT_PER_CPU_SYMBOL(infinity_ema_climb_count);
 DEFINE_PER_CPU(atomic64_t, infinity_wakeup_count);
@@ -224,7 +226,7 @@ static int infinity_stats_proc_handler(const struct ctl_table *ctl, int write,
 {
 	char *buf;
 	u64 fbc, emc, wkc, rtc, gcb, gapp, gskp;
-	u64 gic, gcca, gpbo, gldr, icf, ismt;
+	u64 gic, gcca, gpbo, gldr, icf, ismt, ipb;
 	char v1[16];
 	const size_t bufsz = 4096;
 
@@ -257,6 +259,7 @@ static int infinity_stats_proc_handler(const struct ctl_table *ctl, int write,
 	gldr = infinity_stats_total(&infinity_gpu_lock_drain_rounds);
 	icf  = infinity_stats_total(&infinity_cpufreq_interactive_count);
 	ismt = infinity_stats_total(&infinity_smt_interactive_count);
+	ipb  = infinity_stats_total(&infinity_ipc_boost_count);
 
 	buf[0] = '\0';
 	scnprintf(buf + strlen(buf), bufsz - strlen(buf),
@@ -308,7 +311,21 @@ static int infinity_stats_proc_handler(const struct ctl_table *ctl, int write,
 		  fill_pretty_llu(v1, sizeof(v1), ismt),
 		  "interactive moves to idle core");
 
+	if (emc) {
+		char pct[16];
 
+		scnprintf(pct, sizeof(pct), "%llu%% of tasks",
+			  mul_u64_u32_div(ipb, 100, emc));
+		scnprintf(buf + strlen(buf), bufsz - strlen(buf), ROW,
+			  "IPC boosts",
+			  fill_pretty_llu(v1, sizeof(v1), ipb),
+			  pct);
+	} else {
+		scnprintf(buf + strlen(buf), bufsz - strlen(buf), ROW,
+			  "IPC boosts",
+			  fill_pretty_llu(v1, sizeof(v1), ipb),
+			  "interactive IPC wakeups boosted");
+	}
 
 	strlcat(buf, SEP, bufsz);
 	strlcat(buf, "\n\n", bufsz);
@@ -573,6 +590,7 @@ void infinity_fork_init(struct infinity_ctx *ctx, u64 now)
 	ctx->rt_last_sleep_ns = 0;
 	atomic_set(&ctx->gpu_passovers, 0);
 	ctx->futex_waiting = false;
+	ctx->ipc_waiting = false;
 }
 /* ------------------------------------------------------------------ */
 /* (Removed in v4.5: carriage_ns, auto_carriage_ns, two-pole,          *
diff --git a/kernel/sched/infinity_sched.h b/kernel/sched/infinity_sched.h
index 9dda107e2..aa3663a27 100644
--- a/kernel/sched/infinity_sched.h
+++ b/kernel/sched/infinity_sched.h
@@ -39,6 +39,7 @@
 #ifndef __INFINITY_SCHED_H
 #define __INFINITY_SCHED_H
 #include <linux/sched.h>
+#include <linux/math64.h>
 /* ------------------------------------------------------------------ */
 /* Constants                                                           */
 /* ------------------------------------------------------------------ */
@@ -59,6 +60,9 @@
  */
 #define INFINITY_WEIGHT_SLOPE_NUM	98
 #define INFINITY_WEIGHT_SLOPE_DEN	100
+/** IPC boost gradient: full 2x below 1ms sleep, linear falloff to 1x at 8ms. */
+#define INFINITY_IPC_GRADIENT_FULL_NS	1000000ULL
+#define INFINITY_IPC_GRADIENT_MAX_NS	8000000ULL
 /* ------------------------------------------------------------------ */
 /* SMT divisor bounds                                                  */
 /* ------------------------------------------------------------------ */
@@ -115,6 +119,28 @@ static inline u32 infinity_calc_weight(struct task_struct *p, u64 ema)
 	}
 	return base;
 }
+
+/**
+ * infinity_ipc_gradient -- IPC-wakeup vslice reduction, by sleep duration.
+ * @sleep_ns:  Time the task slept (ns), 0 if unknown.
+ *
+ * Full 2x boost (red = FP_ONE/2) at sleep <= 1ms, linear falloff to no
+ * boost (red = 0) at >= 8ms.  div64_u64 truncates down, so the result
+ * is monotone non-increasing in sleep_ns -- no boost oscillation.
+ *
+ * Return: Reduction [0, FP_ONE/2] in fixed-point units.
+ */
+static inline u64 infinity_ipc_gradient(u64 sleep_ns)
+{
+	u64 span = INFINITY_IPC_GRADIENT_MAX_NS - INFINITY_IPC_GRADIENT_FULL_NS;
+
+	if (sleep_ns <= INFINITY_IPC_GRADIENT_FULL_NS)
+		return INFINITY_FP_ONE / 2;
+	if (sleep_ns >= INFINITY_IPC_GRADIENT_MAX_NS)
+		return 0;
+	return div64_u64((span - (sleep_ns - INFINITY_IPC_GRADIENT_FULL_NS)) *
+			 INFINITY_FP_ONE / 2, span);
+}
 /* ------------------------------------------------------------------ */
 /* Cgroup EMA constants                                                */
 /* ------------------------------------------------------------------ */
@@ -151,6 +177,7 @@ extern unsigned long infinity_tune_smt_divisor;
 /* Stats counters                                                      */
 /* ------------------------------------------------------------------ */
 DECLARE_PER_CPU(atomic64_t, infinity_futex_boost_count);
+DECLARE_PER_CPU(atomic64_t, infinity_ipc_boost_count);
 DECLARE_PER_CPU(atomic64_t, infinity_ema_climb_count);
 DECLARE_PER_CPU(atomic64_t, infinity_wakeup_count);
 DECLARE_PER_CPU(atomic64_t, infinity_rt_throttle_count);
diff --git a/kernel/sched/wait.c b/kernel/sched/wait.c
index 20f27e2cf..f66b804e6 100644
--- a/kernel/sched/wait.c
+++ b/kernel/sched/wait.c
@@ -438,8 +438,12 @@ long wait_woken(struct wait_queue_entry *wq_entry, unsigned mode, long timeout)
 	 * or woken_wake_function() sees our store to current->state.
 	 */
 	set_current_state(mode); /* A */
-	if (!(wq_entry->flags & WQ_FLAG_WOKEN) && !kthread_should_stop_or_park())
+	if (!(wq_entry->flags & WQ_FLAG_WOKEN) && !kthread_should_stop_or_park()) {
+		/* Infinity: flag IPC wait for the vslice boost on wakeup */
+		current->infinity.ipc_waiting = true;
 		timeout = schedule_timeout(timeout);
+		current->infinity.ipc_waiting = false;
+	}
 	__set_current_state(TASK_RUNNING);
 
 	/*
