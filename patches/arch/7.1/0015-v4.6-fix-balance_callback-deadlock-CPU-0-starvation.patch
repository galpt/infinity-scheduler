From 76bedc0acf51becfa6ec8cc09b58acefd040cb83 Mon Sep 17 00:00:00 2001
From: Galih Tama <galpt@v.recipes>
Date: Mon, 6 Jul 2026 23:31:19 +0700
Subject: [PATCH] v4.6: fix balance_callback deadlock + CPU 0 starvation

Two boot fixes:

1. balance_callback deadlock: do_balance_callbacks() runs with rq->lock
   held (lockdep_assert_rq_held in core.c:5016 confirms).  The RT safety
   valve workers called sched_setattr_nocheck() which calls task_rq_lock()
   and deadlocks re-acquiring rq->lock.  Fix: drop rq->lock before
   sched_setattr_nocheck(), re-acquire after.

2. CPU 0 starvation: The can_migrate_task EMA=0 gate blocked ALL newly
   forked tasks (EMA=0) from migrating off CPU 0 during boot.  systemd
   forks hundreds of services on CPU 0, all with EMA=0, and the load
   balancer couldn't spread them.  Fix: add sum_exec_runtime > 2ms
   guard so only tasks with a real execution history get cache-pinned.

Signed-off-by: Galih Tama <galpt@v.recipes>
---
 kernel/sched/fair.c           |  6 +++++-
 kernel/sched/infinity_sched.c | 28 ++++++++++++++++++++++++----
 2 files changed, 29 insertions(+), 5 deletions(-)

diff --git a/kernel/sched/fair.c b/kernel/sched/fair.c
index fa46dee33..e4c00138a 100644
--- a/kernel/sched/fair.c
+++ b/kernel/sched/fair.c
@@ -10038,7 +10038,11 @@ int can_migrate_task(struct task_struct *p, struct lb_env *env)
 	 */
 	if (!(env->flags & LBF_ACTIVE_LB) &&
 	    env->sd->nr_balance_failed <= env->sd->cache_nice_tries &&
-	    p->infinity.ema == 0) {
+	    READ_ONCE(p->infinity.ema) == 0 &&
+	    /* Only protect tasks with a real runtime history.  Newly forked
+	     * tasks start with EMA=0 and must be free to spread across CPUs
+	     * during boot, otherwise CPU 0 becomes a bottleneck. */
+	    p->se.sum_exec_runtime > 2000000ULL) {
 		return 0;
 	}
 
diff --git a/kernel/sched/infinity_sched.c b/kernel/sched/infinity_sched.c
index 4fe70e858..33da34363 100644
--- a/kernel/sched/infinity_sched.c
+++ b/kernel/sched/infinity_sched.c
@@ -30,11 +30,21 @@ DEFINE_PER_CPU(struct llist_head, infinity_rt_demote_list);
 DEFINE_PER_CPU(struct llist_head, infinity_rt_restore_list);
 
 /* Drain the demote list and demote each task to SCHED_NORMAL.
- * Called after rq->lock is released via balance_callback — safe to
- * take task_rq_lock() in sched_setattr_nocheck(). */
+ * balance_callback runs with rq->lock held.  We must drop it before
+ * calling sched_setattr_nocheck() which takes task_rq_lock(). */
 void infinity_rt_demote_worker(struct rq *rq)
 {
-	struct llist_node *node = llist_del_all(this_cpu_ptr(&infinity_rt_demote_list));
+	struct llist_node *node = llist_del_all(&per_cpu(infinity_rt_demote_list, cpu_of(rq)));
+
+	if (!node)
+		return;
+
+	/* Drop rq->lock to avoid deadlock in sched_setattr_nocheck()
+	 * (it calls __sched_setscheduler → task_rq_lock which re-acquires
+	 * rq->lock).  Follow the pattern used elsewhere for balance_callback
+	 * workers that need to take inverted locks. */
+	raw_spin_rq_unlock(rq);
+
 	struct infinity_ctx *ctx, *next;
 
 	llist_for_each_entry_safe(ctx, next, node, demote_node) {
@@ -49,12 +59,20 @@ void infinity_rt_demote_worker(struct rq *rq)
 		if (sched_setattr_nocheck(p, &attr) == 0)
 			set_bit(INFINITY_RT_DEMOTED, &ctx->flags);
 	}
+
+	raw_spin_rq_lock(rq);
 }
 
 /* Drain the restore list and restore each task to its saved RT policy. */
 void infinity_rt_restore_worker(struct rq *rq)
 {
-	struct llist_node *node = llist_del_all(this_cpu_ptr(&infinity_rt_restore_list));
+	struct llist_node *node = llist_del_all(&per_cpu(infinity_rt_restore_list, cpu_of(rq)));
+
+	if (!node)
+		return;
+
+	raw_spin_rq_unlock(rq);
+
 	struct infinity_ctx *ctx, *next;
 
 	llist_for_each_entry_safe(ctx, next, node, restore_node) {
@@ -69,6 +87,8 @@ void infinity_rt_restore_worker(struct rq *rq)
 		if (sched_setattr_nocheck(p, &attr) == 0)
 			clear_bit(INFINITY_RT_DEMOTED, &ctx->flags);
 	}
+
+	raw_spin_rq_lock(rq);
 }
 /* ------------------------------------------------------------------ */
 /* Sysctl tunables                                                     */
