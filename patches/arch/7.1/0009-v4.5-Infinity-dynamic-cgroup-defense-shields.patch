From a9732f29923095f168bc1516a317256127d7f812 Mon Sep 17 00:00:00 2001
From: Galih Tama <galpt@v.recipes>
Date: Mon, 6 Jul 2026 19:27:00 +0700
Subject: [PATCH] v4.5: Infinity dynamic cgroup defense shields

Introduce aggregate group EMA at the cfs_rq level for graduated,
automatic cgroup weight modulation:

- Add group_ema and group_ema_sleep_start fields to struct cfs_rq
  (under CONFIG_FAIR_GROUP_SCHED)
- group_ema climbs in update_curr() when a group entity runs
- group_ema decays only when the entire cfs_rq goes idle
  (tracked via nr_queued == 0 / nr_queued > 0 transition)
- update_cfs_group() reduces local shares output based on
  aggregate EMA, avoiding races on the global tg->shares

The cgroup defense is automatic -- no user configuration needed.
A noisy cgroup (e.g., browser with many CPU-hungry tabs) sees
graduated weight reduction, protecting other cgroups without
binary throttle/unthrottle.

Link: https://github.com/galpt/infinity-scheduler
Signed-off-by: Galih Tama <galpt@v.recipes>
---
 kernel/sched/fair.c           | 55 ++++++++++++++++++++++++++++++++++-
 kernel/sched/infinity_sched.h | 11 +++++++
 kernel/sched/sched.h          |  4 +++
 3 files changed, 69 insertions(+), 1 deletion(-)

diff --git a/kernel/sched/fair.c b/kernel/sched/fair.c
index 4d178960b..53508afb5 100644
--- a/kernel/sched/fair.c
+++ b/kernel/sched/fair.c
@@ -1482,6 +1482,18 @@ static void update_curr(struct cfs_rq *cfs_rq)
 		struct task_struct *p__ = task_of(curr);
 		infinity_consume(&p__->infinity, delta_exec,
 				 rq_of(cfs_rq)->cpu_capacity);
+	} else {
+		/* Group entity: climb group_ema for cgroup defense */
+		struct cfs_rq *gcfs_rq = group_cfs_rq(curr);
+		if (gcfs_rq) {
+			u64 delta = delta_exec;
+			if (delta > INFINITY_CGROUP_EMA_CLIMB_NS)
+				delta = INFINITY_CGROUP_EMA_CLIMB_NS;
+			gcfs_rq->group_ema += div64_u64(
+				(INFINITY_CGROUP_EMA_CLIMB_NS - gcfs_rq->group_ema) *
+				delta * INFINITY_CGROUP_EMA_ALPHA,
+				INFINITY_CGROUP_EMA_CLIMB_NS * INFINITY_FP_ONE);
+		}
 	}
 
 	curr->vruntime += calc_delta_fair(delta_exec, curr);
@@ -4313,6 +4325,20 @@ static void update_cfs_group(struct sched_entity *se)
 		return;
 
 	shares = calc_group_shares(gcfs_rq);
+
+	/* Infinity: reduce group shares when aggregate EMA is elevated.
+	 * Modulating the local 'shares' output (not tg->shares) is safe —
+	 * it only affects this CPU's se->load.weight via reweight_entity()
+	 * under rq->lock.  No cross-CPU race on tg->shares. */
+	if (gcfs_rq->group_ema > 0) {
+		u64 ema_pct = div64_u64(gcfs_rq->group_ema * 100ULL,
+					INFINITY_CGROUP_EMA_CLIMB_NS);
+		if (ema_pct > 50) {
+			long reduced = shares * (100 - INFINITY_CGROUP_WEIGHT_REDUCE_PCT) / 100;
+			shares = max(reduced, (long)MIN_SHARES);
+		}
+	}
+
 	if (unlikely(se->load.weight != shares))
 		reweight_entity(cfs_rq_of(se), se, shares);
 }
@@ -7290,6 +7316,26 @@ enqueue_task_fair(struct rq *rq, struct task_struct *p, int flags)
 		u64 now = rq_clock(rq_of(task_cfs_rq(p)));
 		if (p->infinity.last_sleep_ns && now > p->infinity.last_sleep_ns)
 			infinity_wakeup(&p->infinity, now - p->infinity.last_sleep_ns);
+#ifdef CONFIG_FAIR_GROUP_SCHED
+		/*
+		 * Group EMA decay: if this cfs_rq was idle (sleep_start set)
+		 * and we're the first task re-entering, apply exponential decay
+		 * using the elapsed idle time.
+		 */
+		{
+			struct cfs_rq *pcfs_rq = cfs_rq_of(&p->se);
+			if (pcfs_rq->group_ema_sleep_start) {
+				u64 sleep_ns = now - pcfs_rq->group_ema_sleep_start;
+				u64 periods = div64_u64(sleep_ns,
+					INFINITY_CGROUP_EMA_HALFLIFE_NS);
+				if (periods > 63)
+					pcfs_rq->group_ema = 0;
+				else
+					pcfs_rq->group_ema >>= periods;
+				pcfs_rq->group_ema_sleep_start = 0;
+			}
+		}
+#endif
 	}
 	int h_nr_idle = task_has_idle_policy(p);
 	int h_nr_runnable = 1;
@@ -7535,7 +7581,14 @@ static int dequeue_entities(struct rq *rq, struct sched_entity *se, int flags)
 static bool dequeue_task_fair(struct rq *rq, struct task_struct *p, int flags)
 {
 	/* Infinity: record sleep start */
-	if (flags & DEQUEUE_SLEEP) p->infinity.last_sleep_ns = rq_clock(rq_of(task_cfs_rq(p)));
+	if (flags & DEQUEUE_SLEEP) {
+		p->infinity.last_sleep_ns = rq_clock(rq_of(task_cfs_rq(p)));
+#ifdef CONFIG_FAIR_GROUP_SCHED
+		/* If this cfs_rq becomes empty, record idle start for group EMA decay */
+		if (cfs_rq_of(&p->se)->nr_queued == 0)
+			cfs_rq_of(&p->se)->group_ema_sleep_start = rq_clock(rq);
+#endif
+	}
 	if (task_is_throttled(p)) {
 		dequeue_throttled_task(p, flags);
 		return true;
diff --git a/kernel/sched/infinity_sched.h b/kernel/sched/infinity_sched.h
index 8f96c7554..7fed5d01a 100644
--- a/kernel/sched/infinity_sched.h
+++ b/kernel/sched/infinity_sched.h
@@ -116,6 +116,17 @@ static inline u32 infinity_calc_weight(struct task_struct *p, u64 ema)
 	return base;
 }
 /* ------------------------------------------------------------------ */
+/* Cgroup EMA constants                                                */
+/* ------------------------------------------------------------------ */
+/** Cgroup aggregate EMA ceiling (2ms — groups converge faster). */
+#define INFINITY_CGROUP_EMA_CLIMB_NS	2000000ULL
+/** Cgroup EMA alpha — gentle slope to avoid oscillation. */
+#define INFINITY_CGROUP_EMA_ALPHA	1
+/** Cgroup EMA half-life for idle decay (16ms). */
+#define INFINITY_CGROUP_EMA_HALFLIFE_NS	16000000ULL
+/** Maximum group weight reduction (50% — never fully starves). */
+#define INFINITY_CGROUP_WEIGHT_REDUCE_PCT 50
+/* ------------------------------------------------------------------ */
 /* RT EMA constants                                                    */
 /* ------------------------------------------------------------------ */
 /** RT budget ceiling (10ms). */
diff --git a/kernel/sched/sched.h b/kernel/sched/sched.h
index 9f63b15d3..22f34f7fd 100644
--- a/kernel/sched/sched.h
+++ b/kernel/sched/sched.h
@@ -749,6 +749,10 @@ struct cfs_rq {
 	/* Locally cached copy of our task_group's idle value */
 	int			idle;
 
+	/* Infinity: aggregate group EMA and idle timestamp */
+	u64			group_ema;
+	u64			group_ema_sleep_start;
+
 # ifdef CONFIG_CFS_BANDWIDTH
 	int			runtime_enabled;
 	s64			runtime_remaining;
-- 
