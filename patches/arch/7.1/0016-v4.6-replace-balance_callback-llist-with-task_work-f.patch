From 94421c46617fde6ee2629d598448be06f78e6902 Mon Sep 17 00:00:00 2001
From: Galih Tama <galpt@v.recipes>
Date: Tue, 7 Jul 2026 00:35:12 +0700
Subject: [PATCH] v4.6: replace balance_callback/llist with task_work for RT
 safety valve

The balance_callback infrastructure used for RT demotion and restoration
had two fundamental problems that made it unsafe for calling
sched_setattr_nocheck():

1. rq->lock deadlock: do_balance_callbacks runs with rq->lock held.
   sched_setattr_nocheck -> __sched_setscheduler -> task_rq_lock
   re-acquires rq->lock -- deadlock on the same CPU.

2. IRQ-disabled execution: balance_callback runs inside
   finish_lock_switch, before raw_spin_rq_unlock_irq re-enables
   interrupts.  Calling sched_setattr_nocheck with IRQs disabled
   is fragile even when it doesn't deadlock.

Fix: use task_work_add with TWA_RESUME.  The callback runs on the
task's return-to-userspace path where IRQs are enabled, no scheduler
locks are held, and sched_setattr_nocheck can safely take all needed
locks in the correct order.

This eliminates:
- The balance_callback infrastructure entirely
- All llist per-CPU lists and node fields
- The cross-CPU llist routing bug (work runs on the task's own CPU)
- The raw_spin_rq_unlock/lock workaround in workers
- All DEFINE_PER_CPU for balance_callback slots and llist heads

Signed-off-by: Galih Tama <galpt@v.recipes>
---
 include/linux/sched.h         |  7 ++-
 kernel/sched/fair.c           | 13 ++----
 kernel/sched/infinity_sched.c | 85 ++++++++++-------------------------
 kernel/sched/infinity_sched.h | 13 +++---
 kernel/sched/rt.c             | 12 ++---
 5 files changed, 39 insertions(+), 91 deletions(-)

diff --git a/include/linux/sched.h b/include/linux/sched.h
index 8d0c61685..2c759af26 100644
--- a/include/linux/sched.h
+++ b/include/linux/sched.h
@@ -35,7 +35,6 @@
 #include <linux/sched/types.h>
 #include <linux/signal_types.h>
 #include <linux/spinlock.h>
-#include <linux/llist.h>
 #include <linux/syscall_user_dispatch_types.h>
 #include <linux/mm_types_task.h>
 #include <linux/netdevice_xmit.h>
@@ -827,9 +826,9 @@ struct infinity_ctx {
 	unsigned long	flags;
 	u32		saved_rt_priority;
 	u32		saved_rt_policy;
-	/* Lockless list nodes for deferred RT demotion/restoration callbacks */
-	struct llist_node	demote_node;
-	struct llist_node	restore_node;
+	/* task_work entries for deferred RT demotion/restoration */
+	struct callback_head	demote_work;
+	struct callback_head	restore_work;
 };
 
 struct task_struct {
diff --git a/kernel/sched/fair.c b/kernel/sched/fair.c
index e4c00138a..806f56f1d 100644
--- a/kernel/sched/fair.c
+++ b/kernel/sched/fair.c
@@ -7445,15 +7445,10 @@ enqueue_task_fair(struct rq *rq, struct task_struct *p, int flags)
 		    p->infinity.rt_ema < INFINITY_RT_RESTORE_WATERMARK &&
 		    !test_bit(INFINITY_RT_RESTORE_PENDING, &p->infinity.flags)) {
 			set_bit(INFINITY_RT_RESTORE_PENDING, &p->infinity.flags);
-			/* llist_add target must match cpu_of(rq) — during a
-			 * cross-CPU wakeup the current CPU (this_cpu_ptr)
-			 * may differ from the target runqueue's CPU. */
-			if (llist_add(&p->infinity.restore_node,
-				      &per_cpu(infinity_rt_restore_list, cpu_of(rq)))) {
-				queue_balance_callback(rq,
-					&per_cpu(infinity_rt_restore_cb, cpu_of(rq)),
-					infinity_rt_restore_worker);
-			}
+			/* Schedule restoration on return to userspace.
+			 * task_work_add is safe from scheduler context —
+			 * it uses cmpxchg and set_notify_resume, no locks. */
+			task_work_add(p, &p->infinity.restore_work, TWA_RESUME);
 		}
 
 		if (p->in_iowait)
diff --git a/kernel/sched/infinity_sched.c b/kernel/sched/infinity_sched.c
index 33da34363..b2edf5705 100644
--- a/kernel/sched/infinity_sched.c
+++ b/kernel/sched/infinity_sched.c
@@ -18,77 +18,40 @@
  */
 #include <linux/math64.h>
 #include <linux/sysctl.h>
-#include <linux/llist.h>
 #include <uapi/linux/sched/types.h>
 #include "sched.h"
 #include "infinity_sched.h"
-/* Per-CPU balance_callback slots for deferred RT demotion/restoration */
-DEFINE_PER_CPU(struct balance_callback, infinity_rt_demote_cb);
-DEFINE_PER_CPU(struct balance_callback, infinity_rt_restore_cb);
-/* Lockless per-CPU queues for tasks needing deferred policy changes */
-DEFINE_PER_CPU(struct llist_head, infinity_rt_demote_list);
-DEFINE_PER_CPU(struct llist_head, infinity_rt_restore_list);
 
-/* Drain the demote list and demote each task to SCHED_NORMAL.
- * balance_callback runs with rq->lock held.  We must drop it before
- * calling sched_setattr_nocheck() which takes task_rq_lock(). */
-void infinity_rt_demote_worker(struct rq *rq)
+/* Called on return to userspace.  IRQs enabled, no scheduler locks held.
+ * Safe to call sched_setattr_nocheck which takes task_rq_lock(). */
+void infinity_rt_demote_cb(struct callback_head *work)
 {
-	struct llist_node *node = llist_del_all(&per_cpu(infinity_rt_demote_list, cpu_of(rq)));
+	struct infinity_ctx *ctx = container_of(work, struct infinity_ctx, demote_work);
+	struct task_struct *p = container_of(ctx, struct task_struct, infinity);
 
-	if (!node)
-		return;
-
-	/* Drop rq->lock to avoid deadlock in sched_setattr_nocheck()
-	 * (it calls __sched_setscheduler → task_rq_lock which re-acquires
-	 * rq->lock).  Follow the pattern used elsewhere for balance_callback
-	 * workers that need to take inverted locks. */
-	raw_spin_rq_unlock(rq);
-
-	struct infinity_ctx *ctx, *next;
-
-	llist_for_each_entry_safe(ctx, next, node, demote_node) {
-		struct task_struct *p = container_of(ctx, struct task_struct, infinity);
-
-		clear_bit(INFINITY_RT_DEMOTE_PENDING, &ctx->flags);
-
-		struct sched_attr attr = {
-			.sched_policy = SCHED_NORMAL,
-			.sched_nice = INFINITY_RT_DEMOTE_PRIORITY,
-		};
-		if (sched_setattr_nocheck(p, &attr) == 0)
-			set_bit(INFINITY_RT_DEMOTED, &ctx->flags);
-	}
+	clear_bit(INFINITY_RT_DEMOTE_PENDING, &ctx->flags);
 
-	raw_spin_rq_lock(rq);
+	struct sched_attr attr = {
+		.sched_policy = SCHED_NORMAL,
+		.sched_nice = INFINITY_RT_DEMOTE_PRIORITY,
+	};
+	if (sched_setattr_nocheck(p, &attr) == 0)
+		set_bit(INFINITY_RT_DEMOTED, &ctx->flags);
 }
 
-/* Drain the restore list and restore each task to its saved RT policy. */
-void infinity_rt_restore_worker(struct rq *rq)
+void infinity_rt_restore_cb(struct callback_head *work)
 {
-	struct llist_node *node = llist_del_all(&per_cpu(infinity_rt_restore_list, cpu_of(rq)));
+	struct infinity_ctx *ctx = container_of(work, struct infinity_ctx, restore_work);
+	struct task_struct *p = container_of(ctx, struct task_struct, infinity);
 
-	if (!node)
-		return;
-
-	raw_spin_rq_unlock(rq);
-
-	struct infinity_ctx *ctx, *next;
-
-	llist_for_each_entry_safe(ctx, next, node, restore_node) {
-		struct task_struct *p = container_of(ctx, struct task_struct, infinity);
-
-		clear_bit(INFINITY_RT_RESTORE_PENDING, &ctx->flags);
-
-		struct sched_attr attr = {
-			.sched_policy = ctx->saved_rt_policy,
-			.sched_priority = ctx->saved_rt_priority,
-		};
-		if (sched_setattr_nocheck(p, &attr) == 0)
-			clear_bit(INFINITY_RT_DEMOTED, &ctx->flags);
-	}
+	clear_bit(INFINITY_RT_RESTORE_PENDING, &ctx->flags);
 
-	raw_spin_rq_lock(rq);
+	struct sched_attr attr = {
+		.sched_policy = ctx->saved_rt_policy,
+		.sched_priority = ctx->saved_rt_priority,
+	};
+	if (sched_setattr_nocheck(p, &attr) == 0)
+		clear_bit(INFINITY_RT_DEMOTED, &ctx->flags);
 }
 /* ------------------------------------------------------------------ */
 /* Sysctl tunables                                                     */
@@ -221,8 +184,8 @@ void infinity_fork_init(struct infinity_ctx *ctx, u64 now)
 	ctx->rt_ema = 0;
 	ctx->last_sleep_ns = now;
 	ctx->rt_last_sleep_ns = 0;
-	init_llist_node(&ctx->demote_node);
-	init_llist_node(&ctx->restore_node);
+	init_task_work(&ctx->demote_work, infinity_rt_demote_cb);
+	init_task_work(&ctx->restore_work, infinity_rt_restore_cb);
 }
 /* ------------------------------------------------------------------ */
 /* (Removed in v4.5: carriage_ns, auto_carriage_ns, two-pole,          *
diff --git a/kernel/sched/infinity_sched.h b/kernel/sched/infinity_sched.h
index d37ebb45a..8ff2089c4 100644
--- a/kernel/sched/infinity_sched.h
+++ b/kernel/sched/infinity_sched.h
@@ -39,6 +39,7 @@
 #ifndef __INFINITY_SCHED_H
 #define __INFINITY_SCHED_H
 #include <linux/sched.h>
+#include <linux/task_work.h>
 /* ------------------------------------------------------------------ */
 /* Constants                                                           */
 /* ------------------------------------------------------------------ */
@@ -161,13 +162,9 @@ void infinity_rt_wakeup(struct infinity_ctx *ctx, u64 sleep_ns);
 unsigned int infinity_rr_timeslice(struct task_struct *p,
 				   unsigned int rr_default);
 /* ------------------------------------------------------------------ */
-/* RT safety valve — balance_callback + llist workers                  */
-/* (Called from rt.c, fair.c — entries are in infinity_sched.c)       */
+/* RT safety valve — task_work callbacks                                */
+/* (Called from rt.c, fair.c — implementations in infinity_sched.c)    */
 /* ------------------------------------------------------------------ */
-DECLARE_PER_CPU(struct balance_callback, infinity_rt_demote_cb);
-DECLARE_PER_CPU(struct balance_callback, infinity_rt_restore_cb);
-DECLARE_PER_CPU(struct llist_head, infinity_rt_demote_list);
-DECLARE_PER_CPU(struct llist_head, infinity_rt_restore_list);
-void infinity_rt_demote_worker(struct rq *rq);
-void infinity_rt_restore_worker(struct rq *rq);
+void infinity_rt_demote_cb(struct callback_head *work);
+void infinity_rt_restore_cb(struct callback_head *work);
 #endif /* __INFINITY_SCHED_H */
diff --git a/kernel/sched/rt.c b/kernel/sched/rt.c
index cf29548b2..abb0c6679 100644
--- a/kernel/sched/rt.c
+++ b/kernel/sched/rt.c
@@ -999,15 +999,9 @@ static void update_curr_rt(struct rq *rq)
 		set_bit(INFINITY_RT_DEMOTE_PENDING, &donor->infinity.flags);
 		donor->infinity.saved_rt_policy = donor->policy;
 		donor->infinity.saved_rt_priority = donor->rt_priority;
-		/* llist_add returns true if the list was previously empty.
-		 * Queue the balance_callback only on the first addition to
-		 * avoid redundant callbacks — the worker drains the entire list. */
-		if (llist_add(&donor->infinity.demote_node,
-			      &per_cpu(infinity_rt_demote_list, cpu_of(rq)))) {
-			queue_balance_callback(rq,
-				&per_cpu(infinity_rt_demote_cb, cpu_of(rq)),
-				infinity_rt_demote_worker);
-		}
+		/* Schedule demotion on return to userspace — avoids
+		 * all rq->lock deadlocks and IRQ-disabled issues. */
+		task_work_add(donor, &donor->infinity.demote_work, TWA_RESUME);
 	}
 
 #ifdef CONFIG_RT_GROUP_SCHED
-- 
2.55.0

