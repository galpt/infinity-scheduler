From a197b56b279d2d8155e0f99766e8bd6f82f80e9d Mon Sep 17 00:00:00 2001
From: Galih Tama <galpt@v.recipes>
Date: Mon, 27 Jul 2026 19:00:07 +0700
Subject: [PATCH v4.6-gpu] v4.6-gpu: fix RT throttles description in stats
 output

The description '0 rogue SCHED_FIFO' was a static string that never
changed, making it look like the displayed value should be zero when
it actually tracks the real count of SCHED_FIFO rogue demotions.
Replace with 'FIFO rogue demotions' to accurately describe what the
counter measures.

Signed-off-by: Galih Tama <galpt@v.recipes>
---
 kernel/sched/infinity_sched.c | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/kernel/sched/infinity_sched.c b/kernel/sched/infinity_sched.c
index 4233dabd0..b91d23892 100644
--- a/kernel/sched/infinity_sched.c
+++ b/kernel/sched/infinity_sched.c
@@ -278,7 +278,7 @@ static int infinity_stats_proc_handler(const struct ctl_table *ctl, int write,
 	scnprintf(buf + strlen(buf), bufsz - strlen(buf), ROW,
 		  "RT throttles",
 		  fill_pretty_llu(v1, sizeof(v1), rtc),
-		  "0 rogue SCHED_FIFO");
+		  "FIFO rogue demotions");
 
 	strlcat(buf, SEP, bufsz);
 	strlcat(buf, "\n\n", bufsz);
-- 
2.55.0

