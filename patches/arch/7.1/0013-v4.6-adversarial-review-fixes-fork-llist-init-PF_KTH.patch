From 4f207cb06144c152cc51ca8bd00211aefa7e0d22 Mon Sep 17 00:00:00 2001
From: Galih Tama <galpt@v.recipes>
Date: Mon, 6 Jul 2026 21:22:08 +0700
Subject: [PATCH] v4.6: adversarial review fixes -- fork llist init, PF_KTHREAD
 guard, EEVDF cgroup modulation, atomic flags

Four fixes addressing findings from adversarial code review:

1. Fork safety: init_llist_node() in infinity_fork_init() prevents
   dup_task_struct from copying dirty llist_node pointers into child
   tasks, which would corrupt the per-CPU lockless queues.

2. RT safety: PF_KTHREAD guard in update_curr_rt() exempts kernel
   threads (migration/n, watchdog/n, irq handlers) from RT demotion.
   These run SCHED_FIFO by design and must never be demoted.

3. PELT integrity: move cgroup weight modulation from update_cfs_group()
   to update_deadline() alongside the per-task EMA modulation.
   The old approach distorted calc_group_shares() output which feeds
   into PELT load tracking; the new approach modulates the group
   entity's EEVDF weight directly, affecting only deadline computation.

4. Atomic flags: change flags from u32 to unsigned long, replace
   non-atomic |=/&= with set_bit()/clear_bit()/test_bit().
   balance_callback workers run after rq->lock is released, so
   read-modify-write on flags would race with concurrent flag
   modifications.

Link: https://github.com/galpt/infinity-scheduler
Signed-off-by: Galih Tama <galpt@v.recipes>
---
 include/linux/sched.h         |  2 +-
 kernel/sched/fair.c           | 41 +++++++++++++++++++++--------------
 kernel/sched/infinity_sched.c | 12 ++++++----
 kernel/sched/infinity_sched.h |  8 +++----
 kernel/sched/rt.c             | 12 ++++++----
 5 files changed, 46 insertions(+), 29 deletions(-)

diff --git a/include/linux/sched.h b/include/linux/sched.h
index 79c0e043d..8d0c61685 100644
--- a/include/linux/sched.h
+++ b/include/linux/sched.h
@@ -824,7 +824,7 @@ struct infinity_ctx {
 	u64		last_sleep_ns;
 	u64		rt_last_sleep_ns; /* Sleep timestamp for RT EMA decay */
 	bool		futex_waiting;
-	u32		flags;
+	unsigned long	flags;
 	u32		saved_rt_priority;
 	u32		saved_rt_policy;
 	/* Lockless list nodes for deferred RT demotion/restoration callbacks */
diff --git a/kernel/sched/fair.c b/kernel/sched/fair.c
index b52125537..ae82906ba 100644
--- a/kernel/sched/fair.c
+++ b/kernel/sched/fair.c
@@ -1298,6 +1298,28 @@ static bool update_deadline(struct cfs_rq *cfs_rq, struct sched_entity *se)
 
 			/* Update EEVDF weight from EMA */
 			infinity_update_weight(cfs_rq, se, p__);
+		} else {
+			/*
+			 * Group entity: modulate EEVDF weight based on
+			 * cgroup aggregate EMA.  This affects the deadline
+			 * computation ONLY — unlike the old update_cfs_group
+			 * approach, it does NOT distort PELT load tracking
+			 * used by the load balancer.
+			 */
+#ifdef CONFIG_FAIR_GROUP_SCHED
+			struct cfs_rq *gcfs_rq = group_cfs_rq(se);
+			if (gcfs_rq && gcfs_rq->group_ema > 0) {
+				u64 ema_pct = div64_u64(gcfs_rq->group_ema * 100ULL,
+							INFINITY_CGROUP_EMA_CLIMB_NS);
+				if (ema_pct > 50) {
+					unsigned long new_w = se->load.weight;
+					new_w = new_w * (100 - INFINITY_CGROUP_WEIGHT_REDUCE_PCT) / 100;
+					new_w = max(new_w, (unsigned long)MIN_SHARES);
+					if (new_w != se->load.weight)
+						reweight_entity(cfs_rq, se, new_w);
+				}
+			}
+#endif
 		}
 	}
 
@@ -4326,19 +4348,6 @@ static void update_cfs_group(struct sched_entity *se)
 
 	shares = calc_group_shares(gcfs_rq);
 
-	/* Infinity: reduce group shares when aggregate EMA is elevated.
-	 * Modulating the local 'shares' output (not tg->shares) is safe —
-	 * it only affects this CPU's se->load.weight via reweight_entity()
-	 * under rq->lock.  No cross-CPU race on tg->shares. */
-	if (gcfs_rq->group_ema > 0) {
-		u64 ema_pct = div64_u64(gcfs_rq->group_ema * 100ULL,
-					INFINITY_CGROUP_EMA_CLIMB_NS);
-		if (ema_pct > 50) {
-			long reduced = shares * (100 - INFINITY_CGROUP_WEIGHT_REDUCE_PCT) / 100;
-			shares = max(reduced, (long)MIN_SHARES);
-		}
-	}
-
 	if (unlikely(se->load.weight != shares))
 		reweight_entity(cfs_rq_of(se), se, shares);
 }
@@ -7432,10 +7441,10 @@ enqueue_task_fair(struct rq *rq, struct task_struct *p, int flags)
 		 * and its rt_ema has decayed below the restoration watermark.
 		 * llist_add returns true if the list was previously empty —
 		 * queue balance_callback only once per batch. */
-		if ((p->infinity.flags & INFINITY_RT_DEMOTED) &&
+		if (test_bit(INFINITY_RT_DEMOTED, &p->infinity.flags) &&
 		    p->infinity.rt_ema < INFINITY_RT_RESTORE_WATERMARK &&
-		    !(p->infinity.flags & INFINITY_RT_RESTORE_PENDING)) {
-			p->infinity.flags |= INFINITY_RT_RESTORE_PENDING;
+		    !test_bit(INFINITY_RT_RESTORE_PENDING, &p->infinity.flags)) {
+			set_bit(INFINITY_RT_RESTORE_PENDING, &p->infinity.flags);
 			if (llist_add(&p->infinity.restore_node,
 				      this_cpu_ptr(&infinity_rt_restore_list))) {
 				queue_balance_callback(rq,
diff --git a/kernel/sched/infinity_sched.c b/kernel/sched/infinity_sched.c
index 9c62c9cc6..4fe70e858 100644
--- a/kernel/sched/infinity_sched.c
+++ b/kernel/sched/infinity_sched.c
@@ -39,14 +39,15 @@ void infinity_rt_demote_worker(struct rq *rq)
 
 	llist_for_each_entry_safe(ctx, next, node, demote_node) {
 		struct task_struct *p = container_of(ctx, struct task_struct, infinity);
-		ctx->flags &= ~INFINITY_RT_DEMOTE_PENDING;
+
+		clear_bit(INFINITY_RT_DEMOTE_PENDING, &ctx->flags);
 
 		struct sched_attr attr = {
 			.sched_policy = SCHED_NORMAL,
 			.sched_nice = INFINITY_RT_DEMOTE_PRIORITY,
 		};
 		if (sched_setattr_nocheck(p, &attr) == 0)
-			ctx->flags |= INFINITY_RT_DEMOTED;
+			set_bit(INFINITY_RT_DEMOTED, &ctx->flags);
 	}
 }
 
@@ -58,14 +59,15 @@ void infinity_rt_restore_worker(struct rq *rq)
 
 	llist_for_each_entry_safe(ctx, next, node, restore_node) {
 		struct task_struct *p = container_of(ctx, struct task_struct, infinity);
-		ctx->flags &= ~INFINITY_RT_RESTORE_PENDING;
+
+		clear_bit(INFINITY_RT_RESTORE_PENDING, &ctx->flags);
 
 		struct sched_attr attr = {
 			.sched_policy = ctx->saved_rt_policy,
 			.sched_priority = ctx->saved_rt_priority,
 		};
 		if (sched_setattr_nocheck(p, &attr) == 0)
-			ctx->flags &= ~INFINITY_RT_DEMOTED;
+			clear_bit(INFINITY_RT_DEMOTED, &ctx->flags);
 	}
 }
 /* ------------------------------------------------------------------ */
@@ -199,6 +201,8 @@ void infinity_fork_init(struct infinity_ctx *ctx, u64 now)
 	ctx->rt_ema = 0;
 	ctx->last_sleep_ns = now;
 	ctx->rt_last_sleep_ns = 0;
+	init_llist_node(&ctx->demote_node);
+	init_llist_node(&ctx->restore_node);
 }
 /* ------------------------------------------------------------------ */
 /* (Removed in v4.5: carriage_ns, auto_carriage_ns, two-pole,          *
diff --git a/kernel/sched/infinity_sched.h b/kernel/sched/infinity_sched.h
index d5d0cd245..d37ebb45a 100644
--- a/kernel/sched/infinity_sched.h
+++ b/kernel/sched/infinity_sched.h
@@ -142,10 +142,10 @@ static inline u32 infinity_calc_weight(struct task_struct *p, u64 ema)
 #define INFINITY_RT_RESTORE_WATERMARK   5000ULL
 /** Nice value when demoted to SCHED_NORMAL. */
 #define INFINITY_RT_DEMOTE_PRIORITY     0
-/** Infinity RT context flags */
-#define INFINITY_RT_DEMOTED             BIT(0)
-#define INFINITY_RT_DEMOTE_PENDING      BIT(1)
-#define INFINITY_RT_RESTORE_PENDING     BIT(2)
+/** Infinity RT context flags (bit numbers for atomic bitops) */
+#define INFINITY_RT_DEMOTED             0
+#define INFINITY_RT_DEMOTE_PENDING      1
+#define INFINITY_RT_RESTORE_PENDING     2
 /* ------------------------------------------------------------------ */
 /* External sysctl tunables                                            */
 /* ------------------------------------------------------------------ */
diff --git a/kernel/sched/rt.c b/kernel/sched/rt.c
index 6d952a5fa..33bb4eaab 100644
--- a/kernel/sched/rt.c
+++ b/kernel/sched/rt.c
@@ -989,10 +989,14 @@ static void update_curr_rt(struct rq *rq)
 
 	/* Infinity: RT safety valve — flag demotion if EMA exceeds threshold.
 	 * Deferred via balance_callback — calling sched_setattr_nocheck()
-	 * from here would deadlock (__sched_setscheduler re-acquires rq->lock). */
-	if (donor->infinity.rt_ema >= INFINITY_RT_DEMOTE_THRESHOLD &&
-	    !(donor->infinity.flags & (INFINITY_RT_DEMOTED | INFINITY_RT_DEMOTE_PENDING))) {
-		donor->infinity.flags |= INFINITY_RT_DEMOTE_PENDING;
+	 * from here would deadlock (__sched_setscheduler re-acquires rq->lock).
+	 * Kernel threads (migration, watchdog, IRQ handlers) are exempt —
+	 * they must never be demoted from SCHED_FIFO. */
+	if (!(donor->flags & PF_KTHREAD) &&
+	    donor->infinity.rt_ema >= INFINITY_RT_DEMOTE_THRESHOLD &&
+	    !test_bit(INFINITY_RT_DEMOTED, &donor->infinity.flags) &&
+	    !test_bit(INFINITY_RT_DEMOTE_PENDING, &donor->infinity.flags)) {
+		set_bit(INFINITY_RT_DEMOTE_PENDING, &donor->infinity.flags);
 		donor->infinity.saved_rt_policy = donor->policy;
 		donor->infinity.saved_rt_priority = donor->rt_priority;
 		/* llist_add returns true if the list was previously empty.
