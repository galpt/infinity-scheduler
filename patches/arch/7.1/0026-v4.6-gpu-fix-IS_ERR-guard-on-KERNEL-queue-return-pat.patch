From 38348a98a78f80219681bb44efd89e478c39435c Mon Sep 17 00:00:00 2001
From: Galih Tama <galpt@v.recipes>
Date: Wed, 8 Jul 2026 00:53:23 +0700
Subject: [PATCH] v4.6-gpu: fix IS_ERR guard on KERNEL queue return path

Signed-off-by: Galih Tama <galpt@v.recipes>
---
 drivers/gpu/drm/scheduler/sched_main.c | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/drivers/gpu/drm/scheduler/sched_main.c b/drivers/gpu/drm/scheduler/sched_main.c
index b11aafe80..deb33990f 100644
--- a/drivers/gpu/drm/scheduler/sched_main.c
+++ b/drivers/gpu/drm/scheduler/sched_main.c
@@ -1246,7 +1246,7 @@ drm_sched_select_entity(struct drm_gpu_scheduler *sched)
 	entity = drm_sched_rq_select_entity_fifo(sched,
 				sched->sched_rq[DRM_SCHED_PRIORITY_KERNEL]);
 	if (entity)
-		return entity;
+		return IS_ERR(entity) ? NULL : entity;
 
 	if (drm_sched_policy == DRM_SCHED_POLICY_INFINITY) {
 		/* Unified queue dynamically bounds to the highest available user queue */
-- 
