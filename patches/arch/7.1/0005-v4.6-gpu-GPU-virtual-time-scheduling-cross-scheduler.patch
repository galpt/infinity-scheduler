From 73b27c7c3de65df93d7fcc1f884917d1866ec5e9 Mon Sep 17 00:00:00 2001
From: Galih Tama <galpt@v.recipes>
Date: Sun, 26 Jul 2026 01:09:52 +0700
Subject: [PATCH 5/5] v4.6-gpu: replace em dash with ASCII -- in stats Verdict
 lines

Some terminals cannot render the Unicode em dash (U+2014) and show
a replacement character instead.  Replace with plain ASCII '--' for
compatibility.  Box-drawing characters in the table separator and
tree branches are kept -- those render reliably on the test terminal.

Signed-off-by: Galih Tama <galpt@v.recipes>
---
 kernel/sched/infinity_sched.c | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/kernel/sched/infinity_sched.c b/kernel/sched/infinity_sched.c
index 65ed690ef..a4faed1d6 100644
--- a/kernel/sched/infinity_sched.c
+++ b/kernel/sched/infinity_sched.c
@@ -259,11 +259,11 @@ static int infinity_stats_proc_handler(const struct ctl_table *ctl, int write,
 
 	if (gcb && gapp == gcb)
 		strlcat(buf,
-			"Verdict: All counters healthy \xe2\x80\x94 system operating normally\n",
+			"Verdict: All counters healthy -- system operating normally\n",
 			sizeof(buf));
 	else if (gcb && gapp < gcb)
 		strlcat(buf,
-			"Verdict: Accounting mismatch detected \xe2\x80\x94 see above for details\n",
+			"Verdict: Accounting mismatch detected -- see above for details\n",
 			sizeof(buf));
 	else
 		strlcat(buf, "Verdict: No GPU jobs recorded yet\n",
-- 
2.55.0

