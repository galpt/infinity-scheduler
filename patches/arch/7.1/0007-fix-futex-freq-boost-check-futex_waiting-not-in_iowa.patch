From 8c70ba279e8360388f963d2f711696553b79d356 Mon Sep 17 00:00:00 2001
From: Galih Tama <galpt@v.recipes>
Date: Mon, 6 Jul 2026 09:26:32 +0700
Subject: [PATCH] fix futex freq boost: check futex_waiting, not in_iowait

Signed-off-by: Galih Tama <galpt@v.recipes>
---
 kernel/sched/fair.c | 9 ++++-----
 1 file changed, 4 insertions(+), 5 deletions(-)

diff --git a/kernel/sched/fair.c b/kernel/sched/fair.c
index fd808d454..2076fb537 100644
--- a/kernel/sched/fair.c
+++ b/kernel/sched/fair.c
@@ -7376,13 +7376,12 @@ enqueue_task_fair(struct rq *rq, struct task_struct *p, int flags)
 	}
 
 	if (flags & ENQUEUE_WAKEUP) {
+		/* Check futex_waiting before clearing — triggers freq ramp for IPC wakeups */
+		if (p->infinity.futex_waiting)
+			cpufreq_update_util(rq, SCHED_CPUFREQ_IOWAIT);
+
 		p->infinity.futex_waiting = false;
 
-		/*
-		 * Immediately request maximum frequency when a futex-woken
-		 * task is enqueued, bypassing PELT ramp delay for IPC
-		 * wakeups.
-		 */
 		if (p->in_iowait)
 			cpufreq_update_util(rq, SCHED_CPUFREQ_IOWAIT);
 	}
-- 
