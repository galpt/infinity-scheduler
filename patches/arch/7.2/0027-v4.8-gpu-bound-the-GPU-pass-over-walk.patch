From 4821d5b0aaa8fc0e2d23f45a4ff383d11a58efab Mon Sep 17 00:00:00 2001
From: Galih Tama <galpt@v.recipes>
Date: Tue, 4 Aug 2026 18:24:34 +0700
Subject: [PATCH 27/38] v4.8-gpu: bound the GPU pass-over walk

drm_sched_rq_select_entity_infinity() credited gpu_passovers to every
ready right-neighbor in the vtime rbtree, an O(N) walk under rq->lock
for clients with many contexts.  The walk is now bounded to the K nearest
right-neighbors (INFINITY_GPU_PASSOVER_MAX_ENTITIES = 32) -- the entities
closest to the next pick and therefore the most relevant for starvation
feedback; entities deeper than K are credited on subsequent selections as
the winner moves.  Per-selection cost is O(K) instead of O(N).

Signed-off-by: Galih Tama <galpt@v.recipes>
---
 drivers/gpu/drm/scheduler/sched_rq.c | 17 ++++++++++++++---
 include/drm/gpu_scheduler.h          |  2 ++
 2 files changed, 16 insertions(+), 3 deletions(-)

diff --git a/drivers/gpu/drm/scheduler/sched_rq.c b/drivers/gpu/drm/scheduler/sched_rq.c
index c684ffaf4..f7c1ee899 100644
--- a/drivers/gpu/drm/scheduler/sched_rq.c
+++ b/drivers/gpu/drm/scheduler/sched_rq.c
@@ -483,13 +483,20 @@ drm_sched_select_entity(struct drm_gpu_scheduler *sched)
 			reinit_completion(&entity->entity_idle);
 
 			/* Infinity: GPU-to-CPU feedback.  Increment
-			 * gpu_passovers on all other ready entities further
-			 * right in the rbtree (higher vruntime), so their
-			 * owning tasks' CPU-side infinity_wakeup() can detect
+			 * gpu_passovers on the K nearest right-neighbors in
+			 * the rbtree (higher vruntime), so their owning
+			 * tasks' CPU-side infinity_wakeup() can detect
 			 * GPU-side starvation and accelerate EMA decay.
+			 * The K nearest entities are the closest to the next
+			 * pick (most relevant for starvation feedback);
+			 * entities deeper than K are credited on subsequent
+			 * selections as the winner moves.  This keeps
+			 * per-selection cost O(K) under rq->lock instead of
+			 * O(N) for clients with many contexts.
 			 */
 			if (entity->infinity_pid) {
 				struct rb_node *rb2;
+				int credited = 0;
 
 				rcu_read_lock();
 				for (rb2 = rb_next(rb); rb2;
@@ -515,7 +522,11 @@ drm_sched_select_entity(struct drm_gpu_scheduler *sched)
 						atomic_inc(&p->infinity.gpu_passovers);
 						atomic64_inc(this_cpu_ptr(
 							&infinity_gpu_passover_boosts));
+						++credited;
 					}
+					if (credited >=
+					    INFINITY_GPU_PASSOVER_MAX_ENTITIES)
+						break;
 				}
 				rcu_read_unlock();
 			}
diff --git a/include/drm/gpu_scheduler.h b/include/drm/gpu_scheduler.h
index 3b0468a76..7d04102f0 100644
--- a/include/drm/gpu_scheduler.h
+++ b/include/drm/gpu_scheduler.h
@@ -769,6 +769,8 @@ class_drm_sched_pending_job_iter_lock_ptr(class_drm_sched_pending_job_iter_t *_T
 #define INFINITY_GPU_EMA_ALPHA          4
 #define INFINITY_GPU_EMA_HALFLIFE_NS    32000000ULL
 #define INFINITY_GPU_FAST_SUBMIT_NS     8000000ULL
+/** GPU->CPU pass-over feedback: max entities credited per selection (bounds the O(N) walk). */
+#define INFINITY_GPU_PASSOVER_MAX_ENTITIES 32
 
 #include <linux/atomic.h>
 #include <linux/percpu.h>
