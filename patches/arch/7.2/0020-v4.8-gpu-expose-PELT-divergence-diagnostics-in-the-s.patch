From 2727c5cf9f8967e1dc0a7b13493f0ddda4611b6f Mon Sep 17 00:00:00 2001
From: Galih Tama <galpt@v.recipes>
Date: Tue, 4 Aug 2026 15:05:32 +0700
Subject: [PATCH 20/37] v4.8-gpu: expose PELT divergence diagnostics in the
 stats surfaces

Observability only, no control path.  Three per-task PELT fields are
appended to /proc/<pid>/infinity (util_avg, runnable_avg, util_est with
the UTIL_AVG_UNCHANGED bit masked).  A per-CPU counter flags sleep
transitions where |ema_pct - util_pct| exceeds 50 percentage points;
EMA reacts in ms and PELT in hundreds of ms, so transient divergence is
expected, and the harness's ema-pelt-trace scenario validates the
diagnostic end to end.  Proc handler reads use READ_ONCE with no
rq->lock (deadlock rule), tolerating 32-bit tearing per the existing
precedent.

7.2-series placement: the divergence block sits right after
util_est_dequeue() in dequeue_task_fair() -- this tree has no inline
util_est_update() call between util_est_dequeue() and
dequeue_entities() (the 7.0/6.18/fedora series did), so the 7.1 hunk
applies unchanged.

Signed-off-by: Galih Tama <galpt@v.recipes>
---
 fs/proc/base.c                |  4 ++++
 kernel/sched/fair.c           | 15 +++++++++++++++
 kernel/sched/infinity_sched.c | 12 ++++++++++--
 kernel/sched/infinity_sched.h |  9 +++++++++
 4 files changed, 38 insertions(+), 2 deletions(-)

diff --git a/fs/proc/base.c b/fs/proc/base.c
index 841f5261e..7f33e4933 100644
--- a/fs/proc/base.c
+++ b/fs/proc/base.c
@@ -3283,6 +3283,10 @@ static int proc_infinity_show(struct seq_file *m, struct pid_namespace *ns,
 	seq_printf(m, "futex_waiting:\t%d\n", ctx->futex_waiting);
 	seq_printf(m, "gpu_passovers:\t%d\n",
 		   atomic_read(&ctx->gpu_passovers));
+	seq_printf(m, "util_avg:\t%lu\n", READ_ONCE(task->se.avg.util_avg));
+	seq_printf(m, "runnable_avg:\t%lu\n", READ_ONCE(task->se.avg.runnable_avg));
+	seq_printf(m, "util_est:\t%u\n",
+		   READ_ONCE(task->se.avg.util_est) & ~UTIL_AVG_UNCHANGED);
 	return 0;
 }
 
diff --git a/kernel/sched/fair.c b/kernel/sched/fair.c
index 4f3ecd433..869acc676 100644
--- a/kernel/sched/fair.c
+++ b/kernel/sched/fair.c
@@ -8338,6 +8338,21 @@ static bool dequeue_task_fair(struct rq *rq, struct task_struct *p, int flags)
 	if (!p->se.sched_delayed)
 		util_est_dequeue(&rq->cfs, p);
 
+	/* Infinity: EMA vs PELT divergence diagnostic (observability only).
+	 * One compare per sleep; flags tasks whose EMA classification
+	 * (hog vs interactive) differs from PELT by > 50pp.
+	 */
+	if (flags & DEQUEUE_SLEEP) {
+		u64 ema = READ_ONCE(p->infinity.ema);
+		unsigned long util = task_util_est(p);
+		u64 ema_units = mul_u64_u32_div(ema, SCHED_CAPACITY_SCALE,
+						INFINITY_BUDGET_MAX_NS);
+		u64 diff = ema_units > util ? ema_units - util : util - ema_units;
+
+		if (diff > INFINITY_DIVERGENCE_THRESHOLD_UNITS)
+			atomic64_inc(this_cpu_ptr(&infinity_divergence_count));
+	}
+
 	if (dequeue_entities(rq, &p->se, flags) < 0)
 		return false;
 
diff --git a/kernel/sched/infinity_sched.c b/kernel/sched/infinity_sched.c
index 165226015..8815b5a67 100644
--- a/kernel/sched/infinity_sched.c
+++ b/kernel/sched/infinity_sched.c
@@ -61,6 +61,8 @@ DEFINE_PER_CPU(atomic64_t, infinity_smt_interactive_count);
 EXPORT_PER_CPU_SYMBOL(infinity_smt_interactive_count);
 DEFINE_PER_CPU(atomic64_t, infinity_shield_engage_count);
 EXPORT_PER_CPU_SYMBOL(infinity_shield_engage_count);
+DEFINE_PER_CPU(atomic64_t, infinity_divergence_count);
+EXPORT_PER_CPU_SYMBOL(infinity_divergence_count);
 
 /* ------------------------------------------------------------------ */
 /* Sysctl tunables                                                     */
@@ -213,14 +215,15 @@ static int infinity_stats_proc_handler(const struct ctl_table *ctl, int write,
 	 * buffer is sized from the same measurements, so the output can
 	 * never be truncated either.
 	 */
-	struct infinity_stats_row cpu_rows[9], rt_rows[1], gpu_rows[5];
+	struct infinity_stats_row cpu_rows[10], rt_rows[1], gpu_rows[5];
 	struct infinity_stats_section sections[3] = {
-		{ "CPU", cpu_rows, 9 },
+		{ "CPU", cpu_rows, 10 },
 		{ "RT",  rt_rows,  1 },
 		{ "GPU", gpu_rows, 5 },
 	};
 	u64 fbc, emc, wkc, rtc, gcb, gapp;
 	u64 gic, gcca, gpbo, icf, ismt, ipb, sec;
+	u64 dvg;
 	u64 ipw;
 	char *buf;
 	size_t bufsz, off = 0;
@@ -243,6 +246,7 @@ static int infinity_stats_proc_handler(const struct ctl_table *ctl, int write,
 	ipb  = infinity_stats_total(&infinity_ipc_boost_count);
 	ipw  = infinity_stats_total(&infinity_ipc_wakeup_count);
 	sec  = infinity_stats_total(&infinity_shield_engage_count);
+	dvg  = infinity_stats_total(&infinity_divergence_count);
 
 	/* ---- CPU rows ---- */
 	cpu_rows[0].label = "Futex boosts";
@@ -312,6 +316,10 @@ static int infinity_stats_proc_handler(const struct ctl_table *ctl, int write,
 			sizeof(cpu_rows[8].note));
 	}
 
+	cpu_rows[9].label = "EMA vs PELT divergence";
+	fill_pretty_llu(cpu_rows[9].value, sizeof(cpu_rows[9].value), dvg);
+	strscpy(cpu_rows[9].note, "tasks flagged", sizeof(cpu_rows[9].note));
+
 	/* ---- RT rows ---- */
 	rt_rows[0].label = "RT throttles";
 	fill_pretty_llu(rt_rows[0].value, sizeof(rt_rows[0].value), rtc);
diff --git a/kernel/sched/infinity_sched.h b/kernel/sched/infinity_sched.h
index 7c4d35850..3aade060c 100644
--- a/kernel/sched/infinity_sched.h
+++ b/kernel/sched/infinity_sched.h
@@ -190,6 +190,14 @@ static inline u64 infinity_ipc_gradient(u64 sleep_ns)
  */
 #define INFINITY_RT_REQUEUE_DECAY_NS	100000000ULL
 
+/* ------------------------------------------------------------------ */
+/* PELT divergence diagnostic                                          */
+/* ------------------------------------------------------------------ */
+/** PELT divergence diagnostic: |ema_pct - util_pct| threshold (pp). */
+#define INFINITY_DIVERGENCE_THRESHOLD		50
+#define INFINITY_DIVERGENCE_THRESHOLD_UNITS \
+	(INFINITY_DIVERGENCE_THRESHOLD * SCHED_CAPACITY_SCALE / 100)
+
 /* ------------------------------------------------------------------ */
 /* External sysctl tunables                                            */
 /* ------------------------------------------------------------------ */
@@ -211,6 +219,7 @@ DECLARE_PER_CPU(atomic64_t, infinity_gpu_passover_boosts);
 DECLARE_PER_CPU(atomic64_t, infinity_cpufreq_interactive_count);
 DECLARE_PER_CPU(atomic64_t, infinity_smt_interactive_count);
 DECLARE_PER_CPU(atomic64_t, infinity_shield_engage_count);
+DECLARE_PER_CPU(atomic64_t, infinity_divergence_count);
 /* ------------------------------------------------------------------ */
 /* API -- called from fair.c and rt.c                                   */
 /* ------------------------------------------------------------------ */
-- 
