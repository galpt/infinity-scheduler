From 135b5d88e8b696b5933b226d0ebce3d9b8ceee02 Mon Sep 17 00:00:00 2001
From: Galih Tama <galpt@v.recipes>
Date: Tue, 4 Aug 2026 00:37:49 +0700
Subject: [PATCH 20/22] v4.8-gpu: guard the shield climb publish under
 CONFIG_FAIR_GROUP_SCHED

The upward-only publish of the shield high-water mark reads gcfs_rq->tg,
which only exists under CONFIG_FAIR_GROUP_SCHED.  Without the guard an
alternative-config build (CGROUP_SCHED disabled) fails on
'struct cfs_rq' has no member named 'tg'; verified both configs compile
after this fix.

Signed-off-by: Galih Tama <galpt@v.recipes>
(cherry picked from commit fc6f7bc0f662e0237f8e91d1a16c8ebd50cf460b)
---
 kernel/sched/fair.c | 2 ++
 1 file changed, 2 insertions(+)

diff --git a/kernel/sched/fair.c b/kernel/sched/fair.c
index b85c33493..a7816c2bc 100644
--- a/kernel/sched/fair.c
+++ b/kernel/sched/fair.c
@@ -2079,6 +2079,7 @@ static void update_curr(struct cfs_rq *cfs_rq)
 			 * a regression here indicates wraparound/corruption.
 			 */
 			WARN_ON_ONCE(gcfs_rq->group_ema < old);
+#ifdef CONFIG_FAIR_GROUP_SCHED
 			/* Shield v2: publish the new high-water mark upward only
 			 * (no contention: most ticks find local <= max and take one
 			 * READ_ONCE + compare).
@@ -2091,6 +2092,7 @@ static void update_curr(struct cfs_rq *cfs_rq)
 					WRITE_ONCE(tg->infinity_shield.shield_ema_max,
 						   gcfs_rq->group_ema);
 			}
+#endif
 		}
 	}
 
