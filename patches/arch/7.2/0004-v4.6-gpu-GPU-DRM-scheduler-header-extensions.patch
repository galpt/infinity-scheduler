From 7b4dbf63598d2f466d5ab39aa52c9dfe4cb1865e Mon Sep 17 00:00:00 2001
From: Galih Tama <galpt@v.recipes>
Date: Sat, 1 Aug 2026 11:39:21 +0700
Subject: [PATCH 04/12] v4.6-gpu: GPU DRM scheduler header extensions for
 kernel 7.2

Extend the 7.2 scheduler structures for Infinity's GPU virtual time
scheduling: the entity carries the owning process PID for CPU-to-GPU
coupling (captured via get_task_pid() in entity_init, released in
entity_fini), the entity stats object gains the GPU-time EMA, the last
active timestamp and the submission interval for job-type awareness,
the task's infinity_ctx gains the GPU passover feedback counter, and
the Infinity GPU scheduling constants are defined alongside the
per-CPU observability counter declarations.

Signed-off-by: Galih Tama <galpt@v.recipes>
---
 drivers/gpu/drm/scheduler/sched_internal.h | 17 ++++++++++++++
 include/drm/gpu_scheduler.h                | 26 ++++++++++++++++++++++
 include/linux/sched.h                      |  1 +
 kernel/sched/infinity_sched.h              | 12 ++++++++++
 4 files changed, 56 insertions(+)

diff --git a/drivers/gpu/drm/scheduler/sched_internal.h b/drivers/gpu/drm/scheduler/sched_internal.h
index 13ecb771d..3f47209df 100644
--- a/drivers/gpu/drm/scheduler/sched_internal.h
+++ b/drivers/gpu/drm/scheduler/sched_internal.h
@@ -28,6 +28,23 @@ struct drm_sched_entity_stats {
 	ktime_t		prev_runtime;
 	ktime_t		vruntime;
 
+	/*
+	 * Infinity EMA of GPU time consumed.  Ceiling is
+	 * INFINITY_GPU_EMA_CLIMB_NS; decays by half-lives while the entity
+	 * is idle.  Protected by @lock.
+	 */
+	u64		gpu_time_ema;
+
+	/* ktime of the last job submission, for idle decay.  Protected by @lock. */
+	ktime_t		gpu_time_last_active;
+
+	/*
+	 * Interval between job submissions, used for job-type awareness
+	 * (compositor-like fast submitters get a reduced burst penalty).
+	 * Protected by @lock.
+	 */
+	u64		gpu_last_submit_interval;
+
 	struct ewma_drm_sched_avgtime   avg_job_us;
 };
 
diff --git a/include/drm/gpu_scheduler.h b/include/drm/gpu_scheduler.h
index d61c19e78..c79bf46c2 100644
--- a/include/drm/gpu_scheduler.h
+++ b/include/drm/gpu_scheduler.h
@@ -244,6 +244,15 @@ struct drm_sched_entity {
 	 */
 	struct rb_node			rb_tree_node;
 
+	/**
+	 * @infinity_pid: PID of the owning process.
+	 *
+	 * Captured in drm_sched_entity_init() via get_task_pid() and released
+	 * in drm_sched_entity_fini(), used by the Infinity CPU-to-GPU coupling
+	 * to read the owning task's CPU-side interactivity signals.  No
+	 * mid-life changes.
+	 */
+	struct pid			*infinity_pid;
 };
 
 /**
@@ -753,4 +762,21 @@ class_drm_sched_pending_job_iter_lock_ptr(class_drm_sched_pending_job_iter_t *_T
 		list_for_each_entry((__job), &(__sched)->pending_list, list)	\
 			for_each_if(!(__entity) || (__job)->entity == (__entity))
 
+/* ------------------------------------------------------------------ */
+/* Infinity GPU scheduling constants                                   */
+/* ------------------------------------------------------------------ */
+#define INFINITY_GPU_EMA_CLIMB_NS       10000000ULL
+#define INFINITY_GPU_EMA_ALPHA          4
+#define INFINITY_GPU_EMA_HALFLIFE_NS    32000000ULL
+#define INFINITY_GPU_FAST_SUBMIT_NS     8000000ULL
+
+#include <linux/atomic.h>
+#include <linux/percpu.h>
+#include <linux/pid.h>
+DECLARE_PER_CPU(atomic_t, infinity_gpu_completion_callbacks);
+DECLARE_PER_CPU(atomic_t, infinity_gpu_accounting_applied);
+DECLARE_PER_CPU(atomic_t, infinity_gpu_idle_compensations);
+DECLARE_PER_CPU(atomic_t, infinity_gpu_cpu_coupling_activations);
+DECLARE_PER_CPU(atomic_t, infinity_gpu_passover_boosts);
+
 #endif
diff --git a/include/linux/sched.h b/include/linux/sched.h
index 4889481e1..a42d835eb 100644
--- a/include/linux/sched.h
+++ b/include/linux/sched.h
@@ -829,6 +829,7 @@ struct infinity_ctx {
 	u64		last_sleep_ns;
 	u64		rt_last_sleep_ns; /* Sleep timestamp for RT EMA decay */
 	bool		futex_waiting;
+	atomic_t	gpu_passovers; /* GPU->CPU feedback counter */
 
 };
 
diff --git a/kernel/sched/infinity_sched.h b/kernel/sched/infinity_sched.h
index e6a9db06b..314a23c03 100644
--- a/kernel/sched/infinity_sched.h
+++ b/kernel/sched/infinity_sched.h
@@ -143,6 +143,18 @@ static inline u32 infinity_calc_weight(struct task_struct *p, u64 ema)
 /* External sysctl tunables                                            */
 /* ------------------------------------------------------------------ */
 extern unsigned long infinity_tune_smt_divisor;
+
+/* Stats counters                                                      */
+/* ------------------------------------------------------------------ */
+DECLARE_PER_CPU(atomic_t, infinity_futex_boost_count);
+DECLARE_PER_CPU(atomic_t, infinity_ema_climb_count);
+DECLARE_PER_CPU(atomic_t, infinity_wakeup_count);
+DECLARE_PER_CPU(atomic_t, infinity_rt_throttle_count);
+DECLARE_PER_CPU(atomic_t, infinity_gpu_completion_callbacks);
+DECLARE_PER_CPU(atomic_t, infinity_gpu_accounting_applied);
+DECLARE_PER_CPU(atomic_t, infinity_gpu_idle_compensations);
+DECLARE_PER_CPU(atomic_t, infinity_gpu_cpu_coupling_activations);
+DECLARE_PER_CPU(atomic_t, infinity_gpu_passover_boosts);
 /* ------------------------------------------------------------------ */
 /* API -- called from fair.c and rt.c                                   */
 /* ------------------------------------------------------------------ */
-- 
