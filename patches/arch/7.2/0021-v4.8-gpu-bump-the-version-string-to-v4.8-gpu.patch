From 8bcce97b28fa0dab01397ee2822000c89688dec1 Mon Sep 17 00:00:00 2001
From: Galih Tama <galpt@v.recipes>
Date: Tue, 4 Aug 2026 15:05:39 +0700
Subject: [PATCH 21/37] v4.8-gpu: bump the version string to v4.8-gpu

The kernel reports its scheduler version through the read-only
infinity_version sysctl and the infinity_stats header; bump it for the
v4.8-gpu series.

Signed-off-by: Galih Tama <galpt@v.recipes>
---
 kernel/sched/infinity_sched.c | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/kernel/sched/infinity_sched.c b/kernel/sched/infinity_sched.c
index 8815b5a67..5026e203d 100644
--- a/kernel/sched/infinity_sched.c
+++ b/kernel/sched/infinity_sched.c
@@ -69,7 +69,7 @@ EXPORT_PER_CPU_SYMBOL(infinity_divergence_count);
 /* ------------------------------------------------------------------ */
 unsigned long infinity_tune_smt_divisor = INFINITY_SMT_DIVISOR_DEFAULT;
 static int infinity_running_flag = 1;
-static const char infinity_version[] = "v4.7-gpu";
+static const char infinity_version[] = "v4.8-gpu";
 static int clamp_smt_divisor(const struct ctl_table *table, int write,
 			     void *buf, size_t *lenp, loff_t *ppos)
 {
-- 
2.55.0

