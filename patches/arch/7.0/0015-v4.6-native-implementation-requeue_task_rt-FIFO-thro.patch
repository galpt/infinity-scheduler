From e2062843ba3865aa9a59fec1d8651ba31dbc6bcd Mon Sep 17 00:00:00 2001
From: Galih Tama <galpt@v.recipes>
Date: Tue, 7 Jul 2026 10:29:06 +0700
Subject: [PATCH] v4.6: native implementation -- requeue_task_rt FIFO throttle
 + update_cfs_group cgroup modulation

Signed-off-by: Galih Tama <galpt@v.recipes>
---
 include/linux/sched.h         |  7 +----
 init/init_task.c              |  4 +--
 kernel/sched/fair.c           | 48 ++++++++++-------------------------
 kernel/sched/infinity_sched.c | 37 ---------------------------
 kernel/sched/infinity_sched.h | 19 +++++---------
 kernel/sched/rt.c             | 27 ++++++++------------
 6 files changed, 33 insertions(+), 109 deletions(-)

diff --git a/include/linux/sched.h b/include/linux/sched.h
index 1c5fde246..88cebf967 100644
--- a/include/linux/sched.h
+++ b/include/linux/sched.h
@@ -823,12 +823,7 @@ struct infinity_ctx {
 	u64		last_sleep_ns;
 	u64		rt_last_sleep_ns; /* Sleep timestamp for RT EMA decay */
 	bool		futex_waiting;
-	unsigned long		flags;
-	u32		saved_rt_priority;
-	u32		saved_rt_policy;
-	/* task_work entries for deferred RT demotion/restoration */
-	struct callback_head	demote_work;
-	struct callback_head	restore_work;
+
 };
 
 struct task_struct {
diff --git a/init/init_task.c b/init/init_task.c
index ecd1f4d72..f487386ca 100644
--- a/init/init_task.c
+++ b/init/init_task.c
@@ -153,9 +153,7 @@ struct task_struct init_task __aligned(L1_CACHE_BYTES) = {
 				.rt_ema		= 0,
 				.last_sleep_ns	= 0,
 				.rt_last_sleep_ns = 0,
-				.flags		= 0,
-				.saved_rt_priority = 0,
-				.saved_rt_policy = 0,
+
 	},
 	RCU_POINTER_INITIALIZER(real_cred, &init_cred),
 	RCU_POINTER_INITIALIZER(cred, &init_cred),
diff --git a/kernel/sched/fair.c b/kernel/sched/fair.c
index 5ce29f711..ed7f0429e 100644
--- a/kernel/sched/fair.c
+++ b/kernel/sched/fair.c
@@ -1172,26 +1172,6 @@ static bool update_deadline(struct cfs_rq *cfs_rq, struct sched_entity *se)
 
 			/* Update EEVDF weight from EMA */
 			infinity_update_weight(cfs_rq, se, p__);
-		} else {
-			/*
-			 * Group entity: modulate EEVDF weight based on
-			 * cgroup aggregate EMA — affects deadline only,
-			 * not PELT load-balancer telemetry.
-			 */
-#ifdef CONFIG_FAIR_GROUP_SCHED
-			struct cfs_rq *gcfs_rq = group_cfs_rq(se);
-			if (gcfs_rq && gcfs_rq->group_ema > 0) {
-				u64 ema_pct = div64_u64(gcfs_rq->group_ema * 100ULL,
-							INFINITY_CGROUP_EMA_CLIMB_NS);
-				if (ema_pct > 50) {
-					unsigned long new_w = se->load.weight;
-					new_w = new_w * (100 - INFINITY_CGROUP_WEIGHT_REDUCE_PCT) / 100;
-					new_w = max(new_w, (unsigned long)MIN_SHARES);
-					if (new_w != se->load.weight)
-						reweight_entity(cfs_rq, se, new_w);
-				}
-			}
-#endif
 		}
 	}
 
@@ -4125,6 +4105,20 @@ static void update_cfs_group(struct sched_entity *se)
 
 	shares = calc_group_shares(gcfs_rq);
 
+	/* Infinity: reduce group shares when aggregate EMA is elevated.
+	 * This feeds directly into the PELT-aware reweight_entity(), so the
+	 * load balancer sees the reduced weight consistently — unlike the old
+	 * update_deadline() approach which created a tug-of-war with
+	 * update_cfs_group() on every tick. */
+	if (gcfs_rq->group_ema > 0) {
+		u64 ema_pct = div64_u64(gcfs_rq->group_ema * 100ULL,
+					INFINITY_CGROUP_EMA_CLIMB_NS);
+		if (ema_pct > 50) {
+			long reduced = shares * (100 - INFINITY_CGROUP_WEIGHT_REDUCE_PCT) / 100;
+			shares = max(reduced, (long)MIN_SHARES);
+		}
+	}
+
 	if (unlikely(se->load.weight != shares))
 		reweight_entity(cfs_rq_of(se), se, shares);
 }
@@ -7149,20 +7143,6 @@ enqueue_task_fair(struct rq *rq, struct task_struct *p, int flags)
 
 		p->infinity.futex_waiting = false;
 
-		/* Infinity: restore RT scheduling if the task was demoted
-		 * and its rt_ema has decayed below the restoration watermark.
-		 * llist_add returns true if the list was previously empty —
-		 * queue balance_callback only once per batch. */
-		if (test_bit(INFINITY_RT_DEMOTED, &p->infinity.flags) &&
-		    p->infinity.rt_ema < INFINITY_RT_RESTORE_WATERMARK &&
-		    !test_bit(INFINITY_RT_RESTORE_PENDING, &p->infinity.flags)) {
-			set_bit(INFINITY_RT_RESTORE_PENDING, &p->infinity.flags);
-			/* Schedule restoration on return to userspace.
-			 * task_work_add is safe from scheduler context —
-			 * it uses cmpxchg and set_notify_resume, no locks. */
-			task_work_add(p, &p->infinity.restore_work, TWA_RESUME);
-		}
-
 		if (p->in_iowait)
 			cpufreq_update_util(rq, SCHED_CPUFREQ_IOWAIT);
 	}
diff --git a/kernel/sched/infinity_sched.c b/kernel/sched/infinity_sched.c
index 17844b111..ad43fe57e 100644
--- a/kernel/sched/infinity_sched.c
+++ b/kernel/sched/infinity_sched.c
@@ -22,38 +22,6 @@
 #include "sched.h"
 #include "infinity_sched.h"
 
-/* Called on return to userspace.  IRQs enabled, no scheduler locks held.
- * Safe to call sched_setattr_nocheck which takes task_rq_lock(). */
-void infinity_rt_demote_cb(struct callback_head *work)
-{
-	struct infinity_ctx *ctx = container_of(work, struct infinity_ctx, demote_work);
-	struct task_struct *p = container_of(ctx, struct task_struct, infinity);
-
-	clear_bit(INFINITY_RT_DEMOTE_PENDING, &ctx->flags);
-
-	struct sched_attr attr = {
-		.sched_policy = SCHED_NORMAL,
-		.sched_nice = INFINITY_RT_DEMOTE_PRIORITY,
-	};
-	if (sched_setattr_nocheck(p, &attr) == 0)
-		set_bit(INFINITY_RT_DEMOTED, &ctx->flags);
-}
-
-void infinity_rt_restore_cb(struct callback_head *work)
-{
-	struct infinity_ctx *ctx = container_of(work, struct infinity_ctx, restore_work);
-	struct task_struct *p = container_of(ctx, struct task_struct, infinity);
-
-	clear_bit(INFINITY_RT_RESTORE_PENDING, &ctx->flags);
-
-	struct sched_attr attr = {
-		.sched_policy = ctx->saved_rt_policy,
-		.sched_priority = ctx->saved_rt_priority,
-	};
-	if (sched_setattr_nocheck(p, &attr) == 0)
-		clear_bit(INFINITY_RT_DEMOTED, &ctx->flags);
-}
-
 /* ------------------------------------------------------------------ */
 /* Sysctl tunables                                                     */
 /* ------------------------------------------------------------------ */
@@ -185,11 +153,6 @@ void infinity_fork_init(struct infinity_ctx *ctx, u64 now)
 	ctx->rt_ema = 0;
 	ctx->last_sleep_ns = now;
 	ctx->rt_last_sleep_ns = 0;
-	ctx->flags = 0;
-	ctx->saved_rt_priority = 0;
-	ctx->saved_rt_policy = 0;
-	init_task_work(&ctx->demote_work, infinity_rt_demote_cb);
-	init_task_work(&ctx->restore_work, infinity_rt_restore_cb);
 }
 /* ------------------------------------------------------------------ */
 /* (Removed in v4.5: carriage_ns, auto_carriage_ns, two-pole,          *
diff --git a/kernel/sched/infinity_sched.h b/kernel/sched/infinity_sched.h
index e0af5a238..908537b5f 100644
--- a/kernel/sched/infinity_sched.h
+++ b/kernel/sched/infinity_sched.h
@@ -39,7 +39,7 @@
 #ifndef __INFINITY_SCHED_H
 #define __INFINITY_SCHED_H
 #include <linux/sched.h>
-#include <linux/task_work.h>
+
 /* ------------------------------------------------------------------ */
 /* Constants                                                           */
 /* ------------------------------------------------------------------ */
@@ -139,19 +139,7 @@ static inline u32 infinity_calc_weight(struct task_struct *p, u64 ema)
 /* ------------------------------------------------------------------ */
 /** rt_ema threshold for demotion (>95% of 10ms ceiling). */
 #define INFINITY_RT_DEMOTE_THRESHOLD    9500ULL
-/** rt_ema watermark for restoration (<50% of ceiling). */
-#define INFINITY_RT_RESTORE_WATERMARK   5000ULL
-/** Nice value when demoted to SCHED_NORMAL. */
-#define INFINITY_RT_DEMOTE_PRIORITY     0
-/** Infinity RT context flags (bit numbers for atomic bitops) */
-#define INFINITY_RT_DEMOTED             0
-#define INFINITY_RT_DEMOTE_PENDING      1
-#define INFINITY_RT_RESTORE_PENDING     2
 
-/* RT safety valve — task_work callbacks                                */
-/* (Called from rt.c, fair.c — implementations in infinity_sched.c)    */
-void infinity_rt_demote_cb(struct callback_head *work);
-void infinity_rt_restore_cb(struct callback_head *work);
 
 /* ------------------------------------------------------------------ */
 /* External sysctl tunables                                            */
@@ -167,4 +155,9 @@ void infinity_rt_consume(struct infinity_ctx *ctx, u64 delta_ns);
 void infinity_rt_wakeup(struct infinity_ctx *ctx, u64 sleep_ns);
 unsigned int infinity_rr_timeslice(struct task_struct *p,
 				   unsigned int rr_default);
+/* ------------------------------------------------------------------ */
+/* RT safety valve constants                                           */
+/* ------------------------------------------------------------------ */
+/** rt_ema threshold: force rogue FIFO to yield. */
+#define INFINITY_RT_DEMOTE_THRESHOLD    9500ULL
 #endif /* __INFINITY_SCHED_H */
diff --git a/kernel/sched/rt.c b/kernel/sched/rt.c
index 613f74413..f01d005a5 100644
--- a/kernel/sched/rt.c
+++ b/kernel/sched/rt.c
@@ -987,22 +987,6 @@ static void update_curr_rt(struct rq *rq)
 	/* Infinity: RT EMA climbs with runtime for adaptive RR timeslice */
 	infinity_rt_consume(&donor->infinity, delta_exec);
 
-	/* Infinity: RT safety valve — flag demotion if EMA exceeds threshold.
-	 * Deferred via balance_callback — calling sched_setattr_nocheck()
-	 * from here would deadlock (__sched_setscheduler re-acquires rq->lock).
-	 * Kernel threads (migration, watchdog, IRQ handlers) are exempt —
-	 * they must never be demoted from SCHED_FIFO. */
-	if (!(donor->flags & PF_KTHREAD) &&
-	    donor->infinity.rt_ema >= INFINITY_RT_DEMOTE_THRESHOLD &&
-	    !test_bit(INFINITY_RT_DEMOTED, &donor->infinity.flags) &&
-	    !test_bit(INFINITY_RT_DEMOTE_PENDING, &donor->infinity.flags)) {
-		set_bit(INFINITY_RT_DEMOTE_PENDING, &donor->infinity.flags);
-		donor->infinity.saved_rt_policy = donor->policy;
-		donor->infinity.saved_rt_priority = donor->rt_priority;
-		/* Schedule demotion on return to userspace — avoids
-		 * all rq->lock deadlocks and IRQ-disabled issues. */
-		task_work_add(donor, &donor->infinity.demote_work, TWA_RESUME);
-	}
 
 #ifdef CONFIG_RT_GROUP_SCHED
 	struct sched_rt_entity *rt_se = &donor->rt;
@@ -2569,6 +2553,17 @@ static void task_tick_rt(struct rq *rq, struct task_struct *p, int queued)
 
 	watchdog(rq, p);
 
+	/* Infinity: force a rogue SCHED_FIFO (>95% rt_ema) to yield natively
+	 * within the RT class — no cross-class demotion needed.  Kernel
+	 * threads (migration, watchdog, IRQ handlers) are exempt. */
+	if (p->policy != SCHED_RR &&
+	    !(p->flags & PF_KTHREAD) &&
+	    p->infinity.rt_ema >= INFINITY_RT_DEMOTE_THRESHOLD) {
+		requeue_task_rt(rq, p, 0);
+		resched_curr(rq);
+		return;
+	}
+
 	/*
 	 * RR tasks need a special form of time-slice management.
 	 * FIFO tasks have no timeslices.
-- 
