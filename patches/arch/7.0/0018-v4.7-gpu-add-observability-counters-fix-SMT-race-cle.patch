From 28940a5e8856b1135027751c6a8e3258a0ad6258 Mon Sep 17 00:00:00 2001
From: Galih Tama <galpt@v.recipes>
Date: Sat, 1 Aug 2026 06:47:24 +0700
Subject: [PATCH 46/51] v4.7-gpu: add observability counters, fix SMT race,
 clean up exports

Add infinity_cpufreq_interactive_count and infinity_smt_interactive_count
to CPU stats for verifying v4.7 features trigger.  Fix SMT data race:
use available_idle_cpu() instead of unlocked cpu_rq read.  Remove
hardcoded Per-task EMA range row.  Reorganize all EXPORT_SYMBOL
declarations per kernel convention.  Update version to v4.7-gpu.

Signed-off-by: Galih Tama <galpt@v.recipes>
---
 fs/proc/base.c                |  4 ---
 kernel/sched/fair.c           | 10 +++++---
 kernel/sched/infinity_sched.c | 48 +++++++++++++++++++++--------------
 kernel/sched/infinity_sched.h |  4 ++-
 4 files changed, 38 insertions(+), 28 deletions(-)

diff --git a/fs/proc/base.c b/fs/proc/base.c
index f6f6b1aba..1b25a291d 100644
--- a/fs/proc/base.c
+++ b/fs/proc/base.c
@@ -3303,7 +3303,6 @@ static int proc_stack_depth(struct seq_file *m, struct pid_namespace *ns,
 }
 #endif /* CONFIG_KSTACK_ERASE_METRICS */
 
-#ifdef CONFIG_INFINITY_SCHED
 static int proc_infinity_show(struct seq_file *m, struct pid_namespace *ns,
 			      struct pid *pid, struct task_struct *task)
 {
@@ -3316,7 +3315,6 @@ static int proc_infinity_show(struct seq_file *m, struct pid_namespace *ns,
 		   atomic_read(&ctx->gpu_passovers));
 	return 0;
 }
-#endif
 
 /*
  * Thread groups
@@ -3342,9 +3340,7 @@ static const struct pid_entry tgid_base_stuff[] = {
 #ifdef CONFIG_SCHED_AUTOGROUP
 	REG("autogroup",  S_IRUGO|S_IWUSR, proc_pid_sched_autogroup_operations),
 #endif
-#ifdef CONFIG_INFINITY_SCHED
 	ONE("infinity",   0444, proc_infinity_show),
-#endif
 #ifdef CONFIG_TIME_NS
 	REG("timens_offsets",  S_IRUGO|S_IWUSR, proc_timens_offsets_operations),
 #endif
diff --git a/kernel/sched/fair.c b/kernel/sched/fair.c
index 9710e1ef3..a7eb211e7 100644
--- a/kernel/sched/fair.c
+++ b/kernel/sched/fair.c
@@ -5658,8 +5658,10 @@ pick_next_entity(struct rq *rq, struct cfs_rq *cfs_rq, bool protect)
 	 */
 	if (entity_is_task(se)) {
 		struct task_struct *p = task_of(se);
-		if (p->infinity.ema == 0)
+		if (p->infinity.ema == 0) {
 			cpufreq_update_util(rq, SCHED_CPUFREQ_INTERACTIVE);
+			atomic_inc(&infinity_cpufreq_interactive_count);
+		}
 	}
 
 	return se;
@@ -8828,7 +8830,6 @@ select_task_rq_fair(struct task_struct *p, int prev_cpu, int wake_flags)
 		/* Fast path */
 		new_cpu = select_idle_sibling(p, prev_cpu, new_cpu);
 
-#ifdef CONFIG_INFINITY_SCHED
 		/* SMT interactive placement: if the selected CPU is an SMT
 		 * thread with a busy sibling, and the waking task has low
 		 * EMA, try the primary thread of the same core instead.
@@ -8840,10 +8841,11 @@ select_task_rq_fair(struct task_struct *p, int prev_cpu, int wake_flags)
 				topology_sibling_cpumask(new_cpu));
 
 			if (primary != new_cpu &&
-			    cpu_rq(primary)->nr_running == 0)
+			    available_idle_cpu(primary)) {
 				new_cpu = primary;
+				atomic_inc(&infinity_smt_interactive_count);
+			}
 		}
-#endif
 	}
 	rcu_read_unlock();
 
diff --git a/kernel/sched/infinity_sched.c b/kernel/sched/infinity_sched.c
index b91d23892..aca481ce8 100644
