From 07676772b19eb0c8d480dd42c425a04b2f3a647f Mon Sep 17 00:00:00 2001
From: Galih Tama <galpt@v.recipes>
Date: Tue, 4 Aug 2026 13:28:33 +0700
Subject: [PATCH 36/37] v4.8-gpu: widen the IPC boost gate to BUDGET/16

The 'IPC gate blocks' probe counter showed a 100% rejection rate at
BUDGET/32 (about 12us of recent runtime) on real workloads: every IPC
candidate wakeup was blocked, so the boost never fired.  Widen the
gate to BUDGET/16 (about 23us), the next notch agreed in the tuning
plan, and keep the probe counters in place to re-measure.

Signed-off-by: Galih Tama <galpt@v.recipes>
---
 kernel/sched/infinity_sched.h | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/kernel/sched/infinity_sched.h b/kernel/sched/infinity_sched.h
index 0e8b45118..3405847bd 100644
--- a/kernel/sched/infinity_sched.h
+++ b/kernel/sched/infinity_sched.h
@@ -64,11 +64,11 @@
 #define INFINITY_IPC_GRADIENT_FULL_NS	1000000ULL
 #define INFINITY_IPC_GRADIENT_MAX_NS	8000000ULL
 /** IPC boost EMA gate: only wakees with at most this much recent runtime
- *  (about 12us at BUDGET/32) get the IPC boost, so busy wakeups are
+ *  (about 23us at BUDGET/16) get the IPC boost, so busy wakeups are
  *  rejected and per-packet boost flooding stays bounded.  The rejected
  *  count is visible as the 'IPC gate blocks' row in infinity_stats.
  */
-#define INFINITY_IPC_EMA_GATE_NS	(INFINITY_BUDGET_MAX_NS / 32)
+#define INFINITY_IPC_EMA_GATE_NS	(INFINITY_BUDGET_MAX_NS / 16)
 /* ------------------------------------------------------------------ */
 /* SMT divisor bounds                                                  */
 /* ------------------------------------------------------------------ */
