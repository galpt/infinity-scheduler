From b2c07d7193b29fdcf20b09b4f3e403398b22661e Mon Sep 17 00:00:00 2001
From: Galih Tama <galpt@v.recipes>
Date: Mon, 6 Jul 2026 19:34:10 +0700
Subject: [PATCH] v4.5: Infinity cross-class RT safety valve

Signed-off-by: Galih Tama <galpt@v.recipes>
---
 include/linux/sched.h         |  3 +++
 init/init_task.c              |  4 +++-
 kernel/sched/fair.c           | 11 +++++++++
 kernel/sched/infinity_sched.c | 43 +++++++++++++++++++++++++++++++++++
 kernel/sched/infinity_sched.h | 21 +++++++++++++++++
 kernel/sched/rt.c             | 13 +++++++++++
 6 files changed, 94 insertions(+), 1 deletion(-)

diff --git a/include/linux/sched.h b/include/linux/sched.h
index 5c99a27bd..9c88417a9 100644
--- a/include/linux/sched.h
+++ b/include/linux/sched.h
@@ -823,6 +823,9 @@ struct infinity_ctx {
 	u64		last_sleep_ns;
 	u64		rt_last_sleep_ns; /* Sleep timestamp for RT EMA decay */
 	bool		futex_waiting;
+	u32		flags;
+	u32		saved_rt_priority;
+	u32		saved_rt_policy;
 };
 
 struct task_struct {
diff --git a/init/init_task.c b/init/init_task.c
index f487386ca..ecd1f4d72 100644
--- a/init/init_task.c
+++ b/init/init_task.c
@@ -153,7 +153,9 @@ struct task_struct init_task __aligned(L1_CACHE_BYTES) = {
 				.rt_ema		= 0,
 				.last_sleep_ns	= 0,
 				.rt_last_sleep_ns = 0,
-
+				.flags		= 0,
+				.saved_rt_priority = 0,
+				.saved_rt_policy = 0,
 	},
 	RCU_POINTER_INITIALIZER(real_cred, &init_cred),
 	RCU_POINTER_INITIALIZER(cred, &init_cred),
diff --git a/kernel/sched/fair.c b/kernel/sched/fair.c
index 02621bbc4..2cdeb72f0 100644
--- a/kernel/sched/fair.c
+++ b/kernel/sched/fair.c
@@ -7139,6 +7139,17 @@ enqueue_task_fair(struct rq *rq, struct task_struct *p, int flags)
 
 		p->infinity.futex_waiting = false;
 
+		/* Infinity: restore RT scheduling if the task was demoted
+		 * and its rt_ema has decayed below the restoration watermark. */
+		if ((p->infinity.flags & INFINITY_RT_DEMOTED) &&
+		    p->infinity.rt_ema < INFINITY_RT_RESTORE_WATERMARK &&
+		    !(p->infinity.flags & INFINITY_RT_RESTORE_PENDING)) {
+			p->infinity.flags |= INFINITY_RT_RESTORE_PENDING;
+			queue_balance_callback(rq,
+				&per_cpu(infinity_rt_restore_cb, cpu_of(rq)),
+				infinity_rt_restore_worker);
+		}
+
 		if (p->in_iowait)
 			cpufreq_update_util(rq, SCHED_CPUFREQ_IOWAIT);
 	}
diff --git a/kernel/sched/infinity_sched.c b/kernel/sched/infinity_sched.c
index 0321bf44e..0dbf75a64 100644
--- a/kernel/sched/infinity_sched.c
+++ b/kernel/sched/infinity_sched.c
@@ -18,8 +18,51 @@
  */
 #include <linux/math64.h>
 #include <linux/sysctl.h>
+#include <uapi/linux/sched/types.h>
 #include "sched.h"
 #include "infinity_sched.h"
+
+/* Per-CPU balance_callback slots for deferred RT demotion/restoration */
+DEFINE_PER_CPU(struct balance_callback, infinity_rt_demote_cb);
+DEFINE_PER_CPU(struct balance_callback, infinity_rt_restore_cb);
+
+/* Called after rq->lock is released — safe to take locks in order. */
+void infinity_rt_demote_worker(struct rq *rq)
+{
+	struct task_struct *p = rq->curr;
+
+	if (!(p->infinity.flags & INFINITY_RT_DEMOTE_PENDING))
+		return;
+
+	p->infinity.flags &= ~INFINITY_RT_DEMOTE_PENDING;
+
+	struct sched_attr attr = {
+		.sched_policy = SCHED_NORMAL,
+		.sched_nice = INFINITY_RT_DEMOTE_PRIORITY,
+	};
+
+	if (sched_setattr_nocheck(p, &attr) == 0)
+		p->infinity.flags |= INFINITY_RT_DEMOTED;
+}
+
+void infinity_rt_restore_worker(struct rq *rq)
+{
+	struct task_struct *p = rq->curr;
+
+	if (!(p->infinity.flags & INFINITY_RT_RESTORE_PENDING))
+		return;
+
+	p->infinity.flags &= ~INFINITY_RT_RESTORE_PENDING;
+
+	struct sched_attr attr = {
+		.sched_policy = p->infinity.saved_rt_policy,
+		.sched_priority = p->infinity.saved_rt_priority,
+	};
+
+	if (sched_setattr_nocheck(p, &attr) == 0)
+		p->infinity.flags &= ~INFINITY_RT_DEMOTED;
+}
+
 /* ------------------------------------------------------------------ */
 /* Sysctl tunables                                                     */
 /* ------------------------------------------------------------------ */
diff --git a/kernel/sched/infinity_sched.h b/kernel/sched/infinity_sched.h
index 7fed5d01a..d2985f801 100644
--- a/kernel/sched/infinity_sched.h
+++ b/kernel/sched/infinity_sched.h
@@ -133,6 +133,27 @@ static inline u32 infinity_calc_weight(struct task_struct *p, u64 ema)
 #define INFINITY_RT_BUDGET_NS		10000000ULL
 /** RT alpha. */
 #define INFINITY_RT_ALPHA		4
+/* ------------------------------------------------------------------ */
+/* RT safety valve constants                                           */
+/* ------------------------------------------------------------------ */
+/** rt_ema threshold for demotion (>95% of 10ms ceiling). */
+#define INFINITY_RT_DEMOTE_THRESHOLD    9500ULL
+/** rt_ema watermark for restoration (<50% of ceiling). */
+#define INFINITY_RT_RESTORE_WATERMARK   5000ULL
+/** Nice value when demoted to SCHED_NORMAL. */
+#define INFINITY_RT_DEMOTE_PRIORITY     0
+/** Infinity RT context flags */
+#define INFINITY_RT_DEMOTED             BIT(0)
+#define INFINITY_RT_DEMOTE_PENDING      BIT(1)
+#define INFINITY_RT_RESTORE_PENDING     BIT(2)
+
+/* balance_callback workers — need extern for rt.c and fair.c access */
+extern void infinity_rt_demote_worker(struct rq *rq);
+extern void infinity_rt_restore_worker(struct rq *rq);
+/* Per-CPU callback slots */
+DECLARE_PER_CPU(struct balance_callback, infinity_rt_demote_cb);
+DECLARE_PER_CPU(struct balance_callback, infinity_rt_restore_cb);
+
 /* ------------------------------------------------------------------ */
 /* External sysctl tunables                                            */
 /* ------------------------------------------------------------------ */
diff --git a/kernel/sched/rt.c b/kernel/sched/rt.c
index 29307b073..51d64ea7c 100644
--- a/kernel/sched/rt.c
+++ b/kernel/sched/rt.c
@@ -987,6 +987,19 @@ static void update_curr_rt(struct rq *rq)
 	/* Infinity: RT EMA climbs with runtime for adaptive RR timeslice */
 	infinity_rt_consume(&donor->infinity, delta_exec);
 
+	/* Infinity: RT safety valve — flag demotion if EMA exceeds threshold.
+	 * Deferred via balance_callback — calling sched_setattr_nocheck()
+	 * from here would deadlock (__sched_setscheduler re-acquires rq->lock). */
+	if (donor->infinity.rt_ema >= INFINITY_RT_DEMOTE_THRESHOLD &&
+	    !(donor->infinity.flags & (INFINITY_RT_DEMOTED | INFINITY_RT_DEMOTE_PENDING))) {
+		donor->infinity.flags |= INFINITY_RT_DEMOTE_PENDING;
+		donor->infinity.saved_rt_policy = donor->policy;
+		donor->infinity.saved_rt_priority = donor->rt_priority;
+		queue_balance_callback(rq,
+			&per_cpu(infinity_rt_demote_cb, cpu_of(rq)),
+			infinity_rt_demote_worker);
+	}
+
 #ifdef CONFIG_RT_GROUP_SCHED
 	struct sched_rt_entity *rt_se = &donor->rt;
 
-- 
