From 9b6695c5a2ac61a328ef2239e777bca4fb03bac4 Mon Sep 17 00:00:00 2001
From: Galih Tama <galpt@v.recipes>
Date: Mon, 6 Jul 2026 23:32:32 +0700
Subject: [PATCH] v4.6: fix balance_callback deadlock + CPU 0 starvation

Signed-off-by: Galih Tama <galpt@v.recipes>
---
 kernel/sched/fair.c           |  3 ++-
 kernel/sched/infinity_sched.c | 18 ++++++++++++++++--
 2 files changed, 18 insertions(+), 3 deletions(-)

diff --git a/kernel/sched/fair.c b/kernel/sched/fair.c
index 0cade72a8..d7b1b6ea0 100644
--- a/kernel/sched/fair.c
+++ b/kernel/sched/fair.c
@@ -9788,7 +9788,8 @@ int can_migrate_task(struct task_struct *p, struct lb_env *env)
 	 */
 	if (!(env->flags & LBF_ACTIVE_LB) &&
 	    env->sd->nr_balance_failed <= env->sd->cache_nice_tries &&
-	    p->infinity.ema == 0) {
+	    READ_ONCE(p->infinity.ema) == 0 &&
+	    p->se.sum_exec_runtime > 2000000ULL) {
 		return 0;
 	}
 
diff --git a/kernel/sched/infinity_sched.c b/kernel/sched/infinity_sched.c
index 4b6dd7dd0..9ad7d68ea 100644
--- a/kernel/sched/infinity_sched.c
+++ b/kernel/sched/infinity_sched.c
@@ -35,9 +35,14 @@ DEFINE_PER_CPU(struct llist_head, infinity_rt_restore_list);
  * take task_rq_lock() in sched_setattr_nocheck(). */
 void infinity_rt_demote_worker(struct rq *rq)
 {
-	struct llist_node *node = llist_del_all(this_cpu_ptr(&infinity_rt_demote_list));
+	struct llist_node *node = llist_del_all(&per_cpu(infinity_rt_demote_list, cpu_of(rq)));
 	struct infinity_ctx *ctx, *next;
 
+	if (!node)
+		return;
+
+	raw_spin_rq_unlock(rq);
+
 	llist_for_each_entry_safe(ctx, next, node, demote_node) {
 		struct task_struct *p = container_of(ctx, struct task_struct, infinity);
 
@@ -50,14 +55,21 @@ void infinity_rt_demote_worker(struct rq *rq)
 		if (sched_setattr_nocheck(p, &attr) == 0)
 			set_bit(INFINITY_RT_DEMOTED, &ctx->flags);
 	}
+
+	raw_spin_rq_lock(rq);
 }
 
 /* Drain the restore list and restore each task to its saved RT policy. */
 void infinity_rt_restore_worker(struct rq *rq)
 {
-	struct llist_node *node = llist_del_all(this_cpu_ptr(&infinity_rt_restore_list));
+	struct llist_node *node = llist_del_all(&per_cpu(infinity_rt_restore_list, cpu_of(rq)));
 	struct infinity_ctx *ctx, *next;
 
+	if (!node)
+		return;
+
+	raw_spin_rq_unlock(rq);
+
 	llist_for_each_entry_safe(ctx, next, node, restore_node) {
 		struct task_struct *p = container_of(ctx, struct task_struct, infinity);
 
@@ -70,6 +82,8 @@ void infinity_rt_restore_worker(struct rq *rq)
 		if (sched_setattr_nocheck(p, &attr) == 0)
 			clear_bit(INFINITY_RT_DEMOTED, &ctx->flags);
 	}
+
+	raw_spin_rq_lock(rq);
 }
 
 /* ------------------------------------------------------------------ */
-- 
2.55.0

