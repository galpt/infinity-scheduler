From 71f2f5b09218c2a400c2df76f849419825fc3893 Mon Sep 17 00:00:00 2001
From: Galih Tama <galpt@v.recipes>
Date: Sat, 25 Jul 2026 12:20:32 +0700
Subject: [PATCH 6/6] v4.6-gpu: add kernel.infinity_stats sysctl with
 human-readable health info

Signed-off-by: Galih Tama <galpt@v.recipes>
---
 drivers/gpu/drm/scheduler/sched_main.c |   5 +
 include/drm/gpu_scheduler.h            |  10 +-
 kernel/sched/fair.c                    |   4 +-
 kernel/sched/infinity_sched.c          | 157 ++++++++++++++++++++++++-
 kernel/sched/infinity_sched.h          |   6 +
 kernel/sched/rt.c                      |   1 +
 6 files changed, 179 insertions(+), 4 deletions(-)

diff --git a/drivers/gpu/drm/scheduler/sched_main.c b/drivers/gpu/drm/scheduler/sched_main.c
index bfe549a23..2de80e10e 100644
--- a/drivers/gpu/drm/scheduler/sched_main.c
+++ b/drivers/gpu/drm/scheduler/sched_main.c
@@ -195,6 +195,9 @@ static inline u64 drm_sched_entity_calc_vtime(struct drm_sched_entity *entity)
 				vtime >>= 1;
 			if (READ_ONCE(inf_p->infinity.ema) == 0)
 				vtime >>= 1;
+			if (READ_ONCE(inf_p->infinity.futex_waiting) ||
+			    READ_ONCE(inf_p->infinity.ema) == 0)
+				atomic_inc(&infinity_gpu_cross_couplings);
 		}
 		rcu_read_unlock();
 	}
@@ -395,6 +398,8 @@ static void drm_sched_job_done(struct drm_sched_job *s_job, int result)
 				 inf_entity->gpu_time_ema) *
 				gpu_ns * INFINITY_GPU_EMA_ALPHA,
 				INFINITY_GPU_EMA_CLIMB_NS * (1ULL << 8));
+			atomic_inc(&infinity_gpu_jobs_completed);
+			atomic_inc(&infinity_gpu_ema_updates);
 		}
 		spin_unlock_irqrestore(&sched->job_list_lock, __flags);
 	}
diff --git a/include/drm/gpu_scheduler.h b/include/drm/gpu_scheduler.h
index 2c8e8271b..fb2090433 100644
--- a/include/drm/gpu_scheduler.h
+++ b/include/drm/gpu_scheduler.h
@@ -632,8 +632,6 @@ struct drm_gpu_scheduler {
 	struct list_head		pending_list;
 	spinlock_t			job_list_lock;
 
-	/**
-
 	int				hang_limit;
 	atomic_t                        *score;
 	atomic_t                        _score;
@@ -753,4 +751,12 @@ void drm_sched_entity_modify_sched(struct drm_sched_entity *entity,
 #define INFINITY_GPU_EMA_HALFLIFE_NS    32000000ULL
 #define INFINITY_GPU_CATCHUP_BONUS_NS   5000000ULL
 
+/* ------------------------------------------------------------------ */
+/* Infinity stats counters (accessible from infinity_sched.c)          */
+/* ------------------------------------------------------------------ */
+#include <linux/atomic.h>
+extern atomic_t infinity_gpu_jobs_completed;
+extern atomic_t infinity_gpu_ema_updates;
+extern atomic_t infinity_gpu_cross_couplings;
+
 #endif
diff --git a/kernel/sched/fair.c b/kernel/sched/fair.c
index 5f3d0c1f0..768907cae 100644
--- a/kernel/sched/fair.c
+++ b/kernel/sched/fair.c
@@ -5316,8 +5316,10 @@ place_entity(struct cfs_rq *cfs_rq, struct sched_entity *se, int flags)
 	 * reducing IPC wakeup latency.
 	 */
 	if (entity_is_task(se) && (flags & ENQUEUE_WAKEUP) &&
-	    task_of(se)->infinity.futex_waiting)
+	    task_of(se)->infinity.futex_waiting) {
 		vslice >>= 1;
+		atomic_inc(&infinity_futex_boost_count);
+	}
 
 	/*
 	 * EEVDF: vd_i = ve_i + r_i/w_i
diff --git a/kernel/sched/infinity_sched.c b/kernel/sched/infinity_sched.c
index 682ddfb67..03d16cff4 100644
--- a/kernel/sched/infinity_sched.c
+++ b/kernel/sched/infinity_sched.c
@@ -18,11 +18,31 @@
  */
 #include <linux/math64.h>
 #include <linux/sysctl.h>
+#include <linux/string.h>
 #include <uapi/linux/sched/types.h>
+#include <drm/gpu_scheduler.h>
 #include "sched.h"
 #include "infinity_sched.h"
 
 
+/* ------------------------------------------------------------------ */
+/* Stats counters                                                      */
+/* ------------------------------------------------------------------ */
+atomic_t infinity_futex_boost_count	= ATOMIC_INIT(0);
+atomic_t infinity_ema_climb_count	= ATOMIC_INIT(0);
+atomic_t infinity_rt_throttle_count	= ATOMIC_INIT(0);
+EXPORT_SYMBOL(infinity_futex_boost_count);
+EXPORT_SYMBOL(infinity_ema_climb_count);
+EXPORT_SYMBOL(infinity_rt_throttle_count);
+atomic_t infinity_gpu_jobs_completed	= ATOMIC_INIT(0);
+EXPORT_SYMBOL(infinity_gpu_jobs_completed);
+EXPORT_SYMBOL(infinity_gpu_ema_updates);
+EXPORT_SYMBOL(infinity_gpu_cross_couplings);
+atomic_t infinity_gpu_ema_updates	= ATOMIC_INIT(0);
+atomic_t infinity_gpu_cross_couplings	= ATOMIC_INIT(0);
+/* ------------------------------------------------------------------ */
+
+
 /* ------------------------------------------------------------------ */
 /* Sysctl tunables                                                     */
 /* ------------------------------------------------------------------ */
@@ -47,7 +67,134 @@ static int clamp_smt_divisor(const struct ctl_table *table, int write,
 	}
 	return ret;
 }
-static struct ctl_table infinity_sysctl_table[] = {
+/* ------------------------------------------------------------------ */
+/* Human-readable number formatting                                    */
+/* ------------------------------------------------------------------ */
+static void fmt_human(char *buf, size_t sz, u64 val)
+{
+	static const struct {
+		u64 divisor;
+		const char *unit;
+	} table[] = {
+		{ 1000000000000000000ULL, "E" },
+		{ 1000000000000000ULL,    "P" },
+		{ 1000000000000ULL,       "T" },
+		{ 1000000000ULL,          "B" },
+		{ 1000000ULL,             "M" },
+		{ 1000ULL,                "K" },
+	};
+	int i;
+	char tmp[32];
+
+	for (i = 0; i < ARRAY_SIZE(table); i++) {
+		if (val >= table[i].divisor) {
+			u64 whole = val / table[i].divisor;
+			u64 frac = (val % table[i].divisor) /
+				   (table[i].divisor / 100);
+			scnprintf(tmp, sizeof(tmp), "%llu.%02llu %s",
+				  whole, frac, table[i].unit);
+			strlcat(buf, tmp, sz);
+			return;
+		}
+	}
+
+	scnprintf(tmp, sizeof(tmp), "%llu", (unsigned long long)val);
+	strlcat(buf, tmp, sz);
+}
+/* ------------------------------------------------------------------ */
+/* Stats display handler                                               */
+/* ------------------------------------------------------------------ */
+static int infinity_stats_proc_handler(const struct ctl_table *ctl, int write,
+				       void *buffer, size_t *lenp,
+				       loff_t *ppos)
+{
+	char buf[1024];
+
+	if (write)
+		return -EROFS;
+
+	buf[0] = '\0';
+
+	scnprintf(buf + strlen(buf), sizeof(buf) - strlen(buf),
+		  "Infinity Scheduler v4.6-gpu\n");
+	strlcat(buf, "----------------------------\n\n", sizeof(buf));
+	strlcat(buf, "CPU:\n", sizeof(buf));
+
+	strlcat(buf, "  Futex boosts      : ", sizeof(buf));
+	fmt_human(buf, sizeof(buf), (u64)atomic_read(&infinity_futex_boost_count));
+	strlcat(buf, "  Tasks boosted on IPC wakeup\n", sizeof(buf));
+
+	strlcat(buf, "  EMA climbs        : ", sizeof(buf));
+	fmt_human(buf, sizeof(buf), (u64)atomic_read(&infinity_ema_climb_count));
+	strlcat(buf, "  Burstiness events detected\n", sizeof(buf));
+
+	/* Sleep decays uses same counter as EMA climbs */
+	strlcat(buf, "  Sleep decays      : ", sizeof(buf));
+	fmt_human(buf, sizeof(buf), (u64)atomic_read(&infinity_ema_climb_count));
+	strlcat(buf, "  Wakeup performance improvements\n", sizeof(buf));
+
+	strlcat(buf, "  RT throttles      : ", sizeof(buf));
+	fmt_human(buf, sizeof(buf), (u64)atomic_read(&infinity_rt_throttle_count));
+	strlcat(buf, "  Rogue SCHED_FIFO safety valve\n\n", sizeof(buf));
+
+	strlcat(buf, "GPU:\n", sizeof(buf));
+
+	strlcat(buf, "  Jobs processed     : ", sizeof(buf));
+	fmt_human(buf, sizeof(buf), (u64)atomic_read(&infinity_gpu_jobs_completed));
+	strlcat(buf, "  Total GPU jobs completed\n", sizeof(buf));
+
+	strlcat(buf, "  EMA updates        : ", sizeof(buf));
+	fmt_human(buf, sizeof(buf), (u64)atomic_read(&infinity_gpu_ema_updates));
+	strlcat(buf, "  Burstiness tracking updates\n", sizeof(buf));
+
+	strlcat(buf, "  Cross-couplings    : ", sizeof(buf));
+	fmt_human(buf, sizeof(buf), (u64)atomic_read(&infinity_gpu_cross_couplings));
+	strlcat(buf, "  CPU->GPU interactivity signals\n\n", sizeof(buf));
+
+	strlcat(buf, "Health:\n", sizeof(buf));
+
+	if (atomic_read(&infinity_futex_boost_count) > 0)
+		strlcat(buf, "  1. CPU interactivity : GOOD\n", sizeof(buf));
+	else
+		strlcat(buf, "  1. CPU interactivity : IDLE (no futex events yet)\n",
+			sizeof(buf));
+
+	if (atomic_read(&infinity_rt_throttle_count) > 0)
+		strlcat(buf, "  2. RT throttling    : THROTTLED\n", sizeof(buf));
+	else
+		strlcat(buf, "  2. RT throttling    : GOOD\n", sizeof(buf));
+
+	if (atomic_read(&infinity_gpu_jobs_completed) > 0 &&
+	    atomic_read(&infinity_gpu_cross_couplings) > 0)
+		strlcat(buf, "  3. GPU scheduling   : GOOD\n", sizeof(buf));
+	else if (atomic_read(&infinity_gpu_jobs_completed) > 0)
+		strlcat(buf, "  3. GPU scheduling   : ACTIVE (no cross-coupling yet)\n",
+			sizeof(buf));
+	else
+		strlcat(buf, "  3. GPU scheduling   : IDLE (no GPU jobs tracked)\n",
+			sizeof(buf));
+
+	scnprintf(buf + strlen(buf), sizeof(buf) - strlen(buf),
+		  "\nSystem:\n");
+	scnprintf(buf + strlen(buf), sizeof(buf) - strlen(buf),
+		  "  Version     : %s\n", infinity_version);
+	scnprintf(buf + strlen(buf), sizeof(buf) - strlen(buf),
+		  "  Running     : %s\n",
+		  infinity_running_flag ? "yes" : "no");
+	scnprintf(buf + strlen(buf), sizeof(buf) - strlen(buf),
+		  "  SMT divisor : %lu\n",
+		  infinity_tune_smt_divisor);
+
+	{
+		struct ctl_table tmp = *ctl;
+		tmp.data = buf;
+		tmp.maxlen = sizeof(buf);
+		return proc_dostring(&tmp, write, buffer, lenp, ppos);
+	}
+}
+/* ------------------------------------------------------------------ */
+/* Sysctl table                                                        */
+/* ------------------------------------------------------------------ */
 	{
 		.procname	= "infinity_smt_divisor",
 		.data		= &infinity_tune_smt_divisor,
@@ -69,6 +216,13 @@ static struct ctl_table infinity_sysctl_table[] = {
 		.mode		= 0444,
 		.proc_handler	= proc_dostring,
 	},
+	{
+		.procname	= "infinity_stats",
+		.data		= NULL,
+		.maxlen		= 0,
+		.mode		= 0444,
+		.proc_handler	= infinity_stats_proc_handler,
+	},
 	{}
 };
 /* ------------------------------------------------------------------ */
@@ -119,6 +273,7 @@ void infinity_consume(struct infinity_ctx *ctx, u64 delta_ns,
 			 alpha,
 			 INFINITY_BUDGET_MAX_NS * INFINITY_FP_ONE);
 	ctx->ema += step;
+	atomic_inc(&infinity_ema_climb_count);
 }
 /* ------------------------------------------------------------------ */
 /* infinity_wakeup -- EMA decay on wakeup                               */
diff --git a/kernel/sched/infinity_sched.h b/kernel/sched/infinity_sched.h
index d0caf0586..1916b65cd 100644
--- a/kernel/sched/infinity_sched.h
+++ b/kernel/sched/infinity_sched.h
@@ -144,6 +144,12 @@ static inline u32 infinity_calc_weight(struct task_struct *p, u64 ema)
 /* ------------------------------------------------------------------ */
 extern unsigned long infinity_tune_smt_divisor;
 /* ------------------------------------------------------------------ */
+/* Stats counters                                                      */
+/* ------------------------------------------------------------------ */
+extern atomic_t infinity_futex_boost_count;
+extern atomic_t infinity_ema_climb_count;
+extern atomic_t infinity_rt_throttle_count;
+/* ------------------------------------------------------------------ */
 /* API -- called from fair.c and rt.c                                   */
 /* ------------------------------------------------------------------ */
 void infinity_consume(struct infinity_ctx *ctx, u64 delta_ns, unsigned long cpu_capacity);
diff --git a/kernel/sched/rt.c b/kernel/sched/rt.c
index 7b0444fb2..9eb8ec983 100644
--- a/kernel/sched/rt.c
+++ b/kernel/sched/rt.c
@@ -2539,6 +2539,7 @@ static void task_tick_rt(struct rq *rq, struct task_struct *p, int queued)
 	    p->infinity.rt_ema >= INFINITY_RT_DEMOTE_THRESHOLD) {
 		requeue_task_rt(rq, p, 0);
 		resched_curr(rq);
+		atomic_inc(&infinity_rt_throttle_count);
 		return;
 	}
 
