-static void drm_sched_rq_remove_fifo_locked(struct drm_sched_entity *entity,
+static inline u64 drm_sched_entity_calc_vtime(struct drm_sched_entity *entity)
+{
+	struct drm_sched_rq *rq = entity->rq;
+	u64 effective_total;
+	u64 vtime;
+
+	if (entity->gpu_time_total < rq->min_gpu_vtime) {
+		if (rq->min_gpu_vtime < INFINITY_GPU_CATCHUP_BONUS_NS)
+			effective_total = 0;
+		else
+			effective_total = rq->min_gpu_vtime - INFINITY_GPU_CATCHUP_BONUS_NS;
+	} else {
+		effective_total = entity->gpu_time_total;
+	}
+
+	vtime = effective_total;
+
+	switch (entity->priority) {
+	case DRM_SCHED_PRIORITY_KERNEL:
+		vtime >>= 2;
+		break;
+	case DRM_SCHED_PRIORITY_HIGH:
+		break;
+	case DRM_SCHED_PRIORITY_NORMAL:
+		vtime = vtime * 3 / 2;
+		break;
+	case DRM_SCHED_PRIORITY_LOW:
+		vtime *= 3;
+		break;
+	default:
+		break;
+	}
+
+	if (entity->gpu_time_ema > 0) {
+		u64 ema_pct = div64_u64(entity->gpu_time_ema * 100ULL,
+					INFINITY_GPU_EMA_CLIMB_NS);
+		u64 boost = vtime * ema_pct / 100;
+		vtime += boost >> 1;
+	}
+
+	/*
+	 * Cross-scheduler coupling: if the owning task is waiting on a futex
+	 * or has zero CPU EMA, it is likely interactive -- halve vtime so it
+	 * gets GPU priority.
+	 */
+	if (entity->last_user_pid) {
+		struct task_struct *inf_p;
+
+		rcu_read_lock();
+		inf_p = pid_task(entity->last_user_pid, PIDTYPE_PID);
+		if (inf_p) {
+			if (READ_ONCE(inf_p->infinity.futex_waiting))
+				vtime >>= 1;
+			if (READ_ONCE(inf_p->infinity.ema) == 0)
+				vtime >>= 1;
+			if (READ_ONCE(inf_p->infinity.futex_waiting) ||
+			    READ_ONCE(inf_p->infinity.ema) == 0)
+				atomic_inc(&infinity_gpu_cross_couplings);
+		}
+		rcu_read_unlock();
+	}
+
+	return vtime;
+}
