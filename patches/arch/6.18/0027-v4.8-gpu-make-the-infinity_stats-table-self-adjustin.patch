From 06815b675578ad08101841b0a173605d4550ef3a Mon Sep 17 00:00:00 2001
From: Galih Tama <galpt@v.recipes>
Date: Tue, 4 Aug 2026 14:30:31 +0700
Subject: [PATCH 27/50] v4.8-gpu: make the infinity_stats table self-adjusting

The stats table used hardcoded column widths, so a note longer than 30
characters overflowed its column and broke the borders.  Rows are now
collected first, the widest label, value and note in each column fix
the column widths, and the separators and buffer are sized from the
same measurements, so the borders always line up and the output can
never be truncated no matter how the numbers or descriptions grow or
shrink.  The climbs-per-wakeup annotation shows N/A when no wakeup
decays have been recorded instead of dividing by an implicit one.

Signed-off-by: Galih Tama <galpt@v.recipes>
---
 kernel/sched/infinity_sched.c | 334 +++++++++++++++++++---------------
 1 file changed, 187 insertions(+), 147 deletions(-)

diff --git a/kernel/sched/infinity_sched.c b/kernel/sched/infinity_sched.c
index eeb046d9b..941d808fd 100644
--- a/kernel/sched/infinity_sched.c
+++ b/kernel/sched/infinity_sched.c
@@ -218,32 +218,68 @@ static u64 infinity_stats_total(const atomic64_t __percpu *counter)
 	return total;
 }
 
+struct infinity_stats_row {
+	const char	*label;
+	char		value[16];
+	char		note[64];
+};
+
+struct infinity_stats_section {
+	const char		*name;
+	struct infinity_stats_row *rows;
+	int			nrows;
+};
+
+static size_t infinity_stats_emit_sep(char *buf, size_t sz, int lw, int vw, int nw)
+{
+	char *p = buf;
+	size_t need = (size_t)lw + vw + nw + 13;
+
+	if (sz < need)
+		return 0;
+
+	*p++ = '+';
+	memset(p, '-', lw + 2);
+	p += lw + 2;
+	*p++ = '+';
+	memset(p, '-', vw + 2);
+	p += vw + 2;
+	*p++ = '+';
+	memset(p, '-', nw + 2);
+	p += nw + 2;
+	*p++ = '+';
+	*p++ = '\n';
+	*p = '\0';
+
+	return need - 2;
+}
