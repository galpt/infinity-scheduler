 kernel/sched/infinity_sched.c            | 319 +++++++++++++++++++++++
 kernel/sched/infinity_sched.h            |   7 +
 kernel/sched/rt.c                        |   1 +
 7 files changed, 589 insertions(+), 136 deletions(-)

diff --git a/drivers/gpu/drm/scheduler/sched_entity.c b/drivers/gpu/drm/scheduler/sched_entity.c
