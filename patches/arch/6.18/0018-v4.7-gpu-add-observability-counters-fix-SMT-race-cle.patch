From 02fe766f40df74dc9e0d6ffc1a5d64ccb959c828 Mon Sep 17 00:00:00 2001
From: Galih Tama <galpt@v.recipes>
Date: Tue, 28 Jul 2026 08:03:46 +0700
Subject: [PATCH v4.7-gpu] v4.7-gpu: add observability counters, fix SMT race,
 clean up exports

- Add infinity_cpufreq_interactive_count and infinity_smt_interactive_count
  to CPU stats for verifying v4.7 features trigger.
- Fix SMT data race: use available_idle_cpu() instead of unlocked
  cpu_rq(primary)->nr_running read.
- Remove hardcoded Per-task EMA range row (static string, no diagnostic value).
- Reorganize all EXPORT_SYMBOL declarations to immediately follow their
  variable definitions per kernel convention.
- Update version string to v4.7-gpu.

Signed-off-by: Galih Tama <galpt@v.recipes>
---
 kernel/sched/fair.c           |  4 +++-
 kernel/sched/infinity_sched.c | 33 +++++++++++++++------------------
 kernel/sched/infinity_sched.h |  2 ++
 3 files changed, 20 insertions(+), 19 deletions(-)

diff --git a/kernel/sched/fair.c b/kernel/sched/fair.c
index 9daf12bd3..ebaa23111 100644
--- a/kernel/sched/fair.c
+++ b/kernel/sched/fair.c
@@ -5903,6 +5903,7 @@ pick_next_entity(struct rq *rq, struct cfs_rq *cfs_rq, bool protect)
 		struct task_struct *p = task_of(se);
 		if (p->infinity.ema == 0)
 			cpufreq_update_util(rq, SCHED_CPUFREQ_INTERACTIVE);
+			atomic_inc(&infinity_cpufreq_interactive_count);
 	}
 
 	return se;
@@ -9094,8 +9095,9 @@ select_task_rq_fair(struct task_struct *p, int prev_cpu, int wake_flags)
 				topology_sibling_cpumask(new_cpu));
 
 			if (primary != new_cpu &&
-			    cpu_rq(primary)->nr_running == 0)
+			    available_idle_cpu(primary)) {
 				new_cpu = primary;
+			    atomic_inc(&infinity_smt_interactive_count);
 		}
 #endif
 
diff --git a/kernel/sched/infinity_sched.c b/kernel/sched/infinity_sched.c
index b91d23892..2337a4c11 100644
--- a/kernel/sched/infinity_sched.c
+++ b/kernel/sched/infinity_sched.c
