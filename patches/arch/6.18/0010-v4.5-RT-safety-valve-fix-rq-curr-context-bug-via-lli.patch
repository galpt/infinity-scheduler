From 267362c1f0f8dd3b0a79f20ed3192c84f2b6554a Mon Sep 17 00:00:00 2001
From: Galih Tama <galpt@v.recipes>
Date: Mon, 6 Jul 2026 20:07:17 +0700
Subject: [PATCH] v4.5: RT safety valve: fix rq->curr context bug via llist

Signed-off-by: Galih Tama <galpt@v.recipes>
---
 include/linux/sched.h         |  3 +++
 kernel/sched/fair.c           |  9 ++++---
 kernel/sched/infinity_sched.c | 47 ++++++++++++++++++++---------------
 kernel/sched/infinity_sched.h |  2 ++
 kernel/sched/rt.c             |  9 ++++---
 5 files changed, 44 insertions(+), 26 deletions(-)

diff --git a/include/linux/sched.h b/include/linux/sched.h
index b62498c41..f20c4a7fd 100644
--- a/include/linux/sched.h
+++ b/include/linux/sched.h
@@ -35,6 +35,7 @@
 #include <linux/sched/types.h>
 #include <linux/signal_types.h>
 #include <linux/spinlock.h>
+#include <linux/llist.h>
 #include <linux/syscall_user_dispatch_types.h>
 #include <linux/mm_types_task.h>
 #include <linux/netdevice_xmit.h>
@@ -826,6 +827,8 @@ struct infinity_ctx {
 	u32		flags;
 	u32		saved_rt_priority;
 	u32		saved_rt_policy;
+	struct llist_node	demote_node;
+	struct llist_node	restore_node;
 };
 
 
diff --git a/kernel/sched/fair.c b/kernel/sched/fair.c
index 5dfcd5599..d9f516f90 100644
--- a/kernel/sched/fair.c
+++ b/kernel/sched/fair.c
@@ -7128,9 +7128,12 @@ enqueue_task_fair(struct rq *rq, struct task_struct *p, int flags)
 		    p->infinity.rt_ema < INFINITY_RT_RESTORE_WATERMARK &&
 		    !(p->infinity.flags & INFINITY_RT_RESTORE_PENDING)) {
 			p->infinity.flags |= INFINITY_RT_RESTORE_PENDING;
-			queue_balance_callback(rq,
-				&per_cpu(infinity_rt_restore_cb, cpu_of(rq)),
-				infinity_rt_restore_worker);
+			if (llist_add(&p->infinity.restore_node,
+				      this_cpu_ptr(&infinity_rt_restore_list))) {
+				queue_balance_callback(rq,
+					&per_cpu(infinity_rt_restore_cb, cpu_of(rq)),
+					infinity_rt_restore_worker);
+			}
 		}
 
 		if (p->in_iowait)
diff --git a/kernel/sched/infinity_sched.c b/kernel/sched/infinity_sched.c
index f40a7bd1c..bf870fc26 100644
--- a/kernel/sched/infinity_sched.c
+++ b/kernel/sched/infinity_sched.c
@@ -18,6 +18,7 @@
  */
 #include <linux/math64.h>
 #include <linux/sysctl.h>
+#include <linux/llist.h>
 #include <uapi/linux/sched/types.h>
 #include "sched.h"
 #include "infinity_sched.h"
@@ -25,33 +26,39 @@
 /* Per-CPU balance_callback slots for deferred RT demotion/restoration */
 DEFINE_PER_CPU(struct balance_callback, infinity_rt_demote_cb);
 DEFINE_PER_CPU(struct balance_callback, infinity_rt_restore_cb);
+DEFINE_PER_CPU(struct llist_head, infinity_rt_demote_list);
+DEFINE_PER_CPU(struct llist_head, infinity_rt_restore_list);
 
 void infinity_rt_demote_worker(struct rq *rq)
 {
-	struct task_struct *p = rq->curr;
-	if (!(p->infinity.flags & INFINITY_RT_DEMOTE_PENDING))
-		return;
-	p->infinity.flags &= ~INFINITY_RT_DEMOTE_PENDING;
-	struct sched_attr attr = {
-		.sched_policy = SCHED_NORMAL,
-		.sched_nice = INFINITY_RT_DEMOTE_PRIORITY,
-	};
-	if (sched_setattr_nocheck(p, &attr) == 0)
-		p->infinity.flags |= INFINITY_RT_DEMOTED;
+	struct llist_node *node = llist_del_all(this_cpu_ptr(&infinity_rt_demote_list));
+	struct infinity_ctx *ctx, *next;
+	llist_for_each_entry_safe(ctx, next, node, demote_node) {
+		struct task_struct *p = container_of(ctx, struct task_struct, infinity);
+		ctx->flags &= ~INFINITY_RT_DEMOTE_PENDING;
+		struct sched_attr attr = {
+			.sched_policy = SCHED_NORMAL,
+			.sched_nice = INFINITY_RT_DEMOTE_PRIORITY,
+		};
+		if (sched_setattr_nocheck(p, &attr) == 0)
+			ctx->flags |= INFINITY_RT_DEMOTED;
+	}
 }
 
 void infinity_rt_restore_worker(struct rq *rq)
 {
-	struct task_struct *p = rq->curr;
-	if (!(p->infinity.flags & INFINITY_RT_RESTORE_PENDING))
-		return;
-	p->infinity.flags &= ~INFINITY_RT_RESTORE_PENDING;
-	struct sched_attr attr = {
-		.sched_policy = p->infinity.saved_rt_policy,
-		.sched_priority = p->infinity.saved_rt_priority,
-	};
-	if (sched_setattr_nocheck(p, &attr) == 0)
-		p->infinity.flags &= ~INFINITY_RT_DEMOTED;
+	struct llist_node *node = llist_del_all(this_cpu_ptr(&infinity_rt_restore_list));
+	struct infinity_ctx *ctx, *next;
+	llist_for_each_entry_safe(ctx, next, node, restore_node) {
+		struct task_struct *p = container_of(ctx, struct task_struct, infinity);
+		ctx->flags &= ~INFINITY_RT_RESTORE_PENDING;
+		struct sched_attr attr = {
+			.sched_policy = ctx->saved_rt_policy,
+			.sched_priority = ctx->saved_rt_priority,
+		};
+		if (sched_setattr_nocheck(p, &attr) == 0)
+			ctx->flags &= ~INFINITY_RT_DEMOTED;
+	}
 }
 /* ------------------------------------------------------------------ */
 /* Sysctl tunables                                                     */
diff --git a/kernel/sched/infinity_sched.h b/kernel/sched/infinity_sched.h
index 994911bd1..e8b5dc958 100644
--- a/kernel/sched/infinity_sched.h
+++ b/kernel/sched/infinity_sched.h
@@ -153,6 +153,8 @@ extern void infinity_rt_restore_worker(struct rq *rq);
 /* Per-CPU callback slots */
 DECLARE_PER_CPU(struct balance_callback, infinity_rt_demote_cb);
 DECLARE_PER_CPU(struct balance_callback, infinity_rt_restore_cb);
+DECLARE_PER_CPU(struct llist_head, infinity_rt_demote_list);
+DECLARE_PER_CPU(struct llist_head, infinity_rt_restore_list);
 /* ------------------------------------------------------------------ */
 /* External sysctl tunables                                            */
 /* ------------------------------------------------------------------ */
diff --git a/kernel/sched/rt.c b/kernel/sched/rt.c
index c22df24f1..01de70f1f 100644
--- a/kernel/sched/rt.c
+++ b/kernel/sched/rt.c
@@ -993,9 +993,12 @@ static void update_curr_rt(struct rq *rq)
 		donor->infinity.flags |= INFINITY_RT_DEMOTE_PENDING;
 		donor->infinity.saved_rt_policy = donor->policy;
 		donor->infinity.saved_rt_priority = donor->rt_priority;
-		queue_balance_callback(rq,
-			&per_cpu(infinity_rt_demote_cb, cpu_of(rq)),
-			infinity_rt_demote_worker);
+		if (llist_add(&donor->infinity.demote_node,
+			      this_cpu_ptr(&infinity_rt_demote_list))) {
+			queue_balance_callback(rq,
+				&per_cpu(infinity_rt_demote_cb, cpu_of(rq)),
+				infinity_rt_demote_worker);
+		}
 	}
 
 #ifdef CONFIG_RT_GROUP_SCHED
-- 
2.55.0

