From a4f8b1887e61ad6db52e4800d06087feb51ada26 Mon Sep 17 00:00:00 2001
From: Galih Tama <galpt@v.recipes>
Date: Sat, 1 Aug 2026 07:56:22 +0700
Subject: [PATCH 17/23] v4.7-gpu: add /proc/<pid>/infinity per-process EMA
 visibility

Show ema, rt_ema, futex_waiting, and gpu_passovers for each process.
Allows users and developers to see which processes Infinity treats
as interactive versus batch.

Signed-off-by: Galih Tama <galpt@v.recipes>
---
 fs/proc/base.c | 18 ++++++++++++++++++
 1 file changed, 18 insertions(+)

diff --git a/fs/proc/base.c b/fs/proc/base.c
index c8d783f3b..72d084e6e 100644
--- a/fs/proc/base.c
+++ b/fs/proc/base.c
@@ -3288,6 +3288,21 @@ static int proc_stack_depth(struct seq_file *m, struct pid_namespace *ns,
 }
 #endif /* CONFIG_KSTACK_ERASE_METRICS */
 
+#ifdef CONFIG_INFINITY_SCHED
+static int proc_infinity_show(struct seq_file *m, struct pid_namespace *ns,
+			      struct pid *pid, struct task_struct *task)
+{
+	struct infinity_ctx *ctx = &task->infinity;
+
+	seq_printf(m, "ema:\t\t%llu\n", ctx->ema);
+	seq_printf(m, "rt_ema:\t\t%llu\n", ctx->rt_ema);
+	seq_printf(m, "futex_waiting:\t%d\n", ctx->futex_waiting);
+	seq_printf(m, "gpu_passovers:\t%d\n",
+		   atomic_read(&ctx->gpu_passovers));
+	return 0;
+}
+#endif
+
 /*
  * Thread groups
  */
@@ -3312,6 +3327,9 @@ static const struct pid_entry tgid_base_stuff[] = {
 #ifdef CONFIG_SCHED_AUTOGROUP
 	REG("autogroup",  S_IRUGO|S_IWUSR, proc_pid_sched_autogroup_operations),
 #endif
+#ifdef CONFIG_INFINITY_SCHED
+	ONE("infinity",   0444, proc_infinity_show),
+#endif
 #ifdef CONFIG_TIME_NS
 	REG("timens_offsets",  S_IRUGO|S_IWUSR, proc_timens_offsets_operations),
 #endif
-- 
