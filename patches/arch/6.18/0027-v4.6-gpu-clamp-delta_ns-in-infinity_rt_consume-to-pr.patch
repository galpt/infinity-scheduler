From 8b6530e1b730f0697febe81a361630eb104e0a95 Mon Sep 17 00:00:00 2001
From: Galih Tama <galpt@v.recipes>
Date: Wed, 8 Jul 2026 10:27:36 +0700
Subject: [PATCH] v4.6-gpu: clamp delta_ns in infinity_rt_consume to prevent
 u64 overflow under NO_HZ_FULL

Signed-off-by: Galih Tama <galpt@v.recipes>
---
 kernel/sched/infinity_sched.c | 6 ++++++
 1 file changed, 6 insertions(+)

diff --git a/kernel/sched/infinity_sched.c b/kernel/sched/infinity_sched.c
index bf124d8fb..6c1d404ae 100644
--- a/kernel/sched/infinity_sched.c
+++ b/kernel/sched/infinity_sched.c
@@ -169,6 +169,12 @@ void infinity_rt_consume(struct infinity_ctx *ctx, u64 delta_ns)
 		ctx->rt_ema = INFINITY_RT_BUDGET_NS;
 		return;
 	}
+	/* Clamp delta_ns to prevent u64 overflow in the numerator for
+	 * tickless (NO_HZ_FULL) configurations where delta_ns can span
+	 * hundreds of seconds between calls.  Matches the same clamp
+	 * used in infinity_consume for the Fair class. */
+	if (delta_ns > INFINITY_RT_BUDGET_NS)
+		delta_ns = INFINITY_RT_BUDGET_NS;
 	step = div64_u64((INFINITY_RT_BUDGET_NS - ctx->rt_ema) * delta_ns *
 			   INFINITY_RT_ALPHA,
 			   INFINITY_RT_BUDGET_NS * INFINITY_FP_ONE);
-- 
