From 97f3df7620f98dad9c05d468cbd76d171755b6fa Mon Sep 17 00:00:00 2001
From: Galih Tama <galpt@v.recipes>
Date: Sat, 1 Aug 2026 07:54:40 +0700
Subject: [PATCH 14/47] v4.6-gpu: fix idle compensation formula, init
 gpu_passovers on fork, clean up stats descriptions

- Swap the terms in the idle compensation blend formula so that idle
  entities get scheduling priority instead of active ones:
  effective_total = min_gpu_vtime * (1 - idle_ratio)
                  + gpu_time_total * idle_ratio

- Add atomic_set(&ctx->gpu_passovers, 0) and ctx->futex_waiting = false
  to infinity_fork_init() to prevent forked children from inheriting
  stale GPU scheduler signals from the parent.

- Rename 'Lock drain rounds' to 'Drain count' with description
  'batch drain operations' to clarify this is a cumulative counter.

- Fix RT throttles description from static '0 rogue SCHED_FIFO' to
  'FIFO rogue demotions' which accurately describes what is counted.

Reported-by: RiverOnVenus <riveronvenus@github>
Closes: https://github.com/galpt/infinity-scheduler/issues/16#issuecomment-5083978040
Signed-off-by: Galih Tama <galpt@v.recipes>
---
 drivers/gpu/drm/scheduler/sched_main.c | 4 ++--
 kernel/sched/infinity_sched.c          | 9 +++++----
 2 files changed, 7 insertions(+), 6 deletions(-)

diff --git a/drivers/gpu/drm/scheduler/sched_main.c b/drivers/gpu/drm/scheduler/sched_main.c
index 0b9fedff8..55c38c0b8 100644
--- a/drivers/gpu/drm/scheduler/sched_main.c
+++ b/drivers/gpu/drm/scheduler/sched_main.c
@@ -188,9 +188,9 @@ static inline u64 drm_sched_entity_calc_vtime(struct drm_sched_entity *entity)
 					       INFINITY_GPU_EMA_HALFLIFE_NS);
 
 			effective_total =
-				(entity->gpu_time_total *
+				(rq->min_gpu_vtime *
 				 ((1ULL << 16) - idle_ratio) +
-				 rq->min_gpu_vtime * idle_ratio) >> 16;
+				 entity->gpu_time_total * idle_ratio) >> 16;
 		}
 
 		atomic_inc(&infinity_gpu_idle_compensations);
diff --git a/kernel/sched/infinity_sched.c b/kernel/sched/infinity_sched.c
index 237d4a9c3..d8badbd07 100644
--- a/kernel/sched/infinity_sched.c
+++ b/kernel/sched/infinity_sched.c
@@ -285,7 +285,7 @@ static int infinity_stats_proc_handler(const struct ctl_table *ctl, int write,
 	scnprintf(buf + strlen(buf), bufsz - strlen(buf), ROW,
 		  "RT throttles",
 		  fill_pretty_llu(v1, sizeof(v1), rtc),
-		  "0 rogue SCHED_FIFO");
+		  "FIFO rogue demotions");
 
 	strlcat(buf, SEP, bufsz);
 	strlcat(buf, "\n\n", bufsz);
@@ -343,9 +343,9 @@ static int infinity_stats_proc_handler(const struct ctl_table *ctl, int write,
 		  "passover EMA boost");
 
 	scnprintf(buf + strlen(buf), bufsz - strlen(buf), ROW,
-		  "Lock drain rounds",
+		  "Drain count",
 		  fill_pretty_llu(v1, sizeof(v1), gldr),
-		  "pending_ns drained");
+		  "batch drain operations");
 
 	strlcat(buf, SEP, bufsz);
 	strlcat(buf, "\n\n", bufsz);
@@ -536,7 +536,8 @@ void infinity_fork_init(struct infinity_ctx *ctx, u64 now)
 	ctx->rt_ema = 0;
 	ctx->last_sleep_ns = now;
 	ctx->rt_last_sleep_ns = 0;
-
+	atomic_set(&ctx->gpu_passovers, 0);
+	ctx->futex_waiting = false;
 }
