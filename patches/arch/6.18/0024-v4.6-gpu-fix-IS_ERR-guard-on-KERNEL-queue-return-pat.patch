From c1cc2d506d0a6176313aac4b0f09eddd4adb7d73 Mon Sep 17 00:00:00 2001
From: Galih Tama <galpt@v.recipes>
Date: Wed, 8 Jul 2026 00:53:24 +0700
Subject: [PATCH] v4.6-gpu: fix IS_ERR guard on KERNEL queue return path

Signed-off-by: Galih Tama <galpt@v.recipes>
---
 drivers/gpu/drm/scheduler/sched_main.c | 2 ++
 1 file changed, 2 insertions(+)

diff --git a/drivers/gpu/drm/scheduler/sched_main.c b/drivers/gpu/drm/scheduler/sched_main.c
index a5dc10848..92eb5c955 100644
--- a/drivers/gpu/drm/scheduler/sched_main.c
+++ b/drivers/gpu/drm/scheduler/sched_main.c
@@ -1242,6 +1242,7 @@ drm_sched_select_entity(struct drm_gpu_scheduler *sched)
 	entity = drm_sched_rq_select_entity_fifo(sched,
 				sched->sched_rq[DRM_SCHED_PRIORITY_KERNEL]);
 	if (entity)
+		return IS_ERR(entity) ? NULL : entity;
 		return entity;
 
 	if (drm_sched_policy == DRM_SCHED_POLICY_INFINITY) {
@@ -1260,6 +1261,7 @@ drm_sched_select_entity(struct drm_gpu_scheduler *sched)
 			drm_sched_rq_select_entity_fifo(sched, sched->sched_rq[i]) :
 			drm_sched_rq_select_entity_rr(sched, sched->sched_rq[i]);
 		if (entity)
+		return IS_ERR(entity) ? NULL : entity;
 			break;
 	}
 	return IS_ERR(entity) ? NULL : entity;
-- 
2.55.0

