From d47a4923b82cf425101db76d9aff0916fcb0c709 Mon Sep 17 00:00:00 2001
From: Galih Tama <galpt@v.recipes>
Date: Sat, 1 Aug 2026 07:50:52 +0700
Subject: [PATCH 11/49] v4.6-gpu: fix group_ema placement outside
 CONFIG_FAIR_GROUP_SCHED guard

The group_ema and group_ema_sleep_start fields in struct cfs_rq were
placed inside the #ifdef CONFIG_FAIR_GROUP_SCHED guard, but the code
that accesses them in fair.c (update_curr, update_cfs_group) is
unconditional.  This causes a compile error when CONFIG_FAIR_GROUP_SCHED
is not enabled:

  error: 'struct cfs_rq' has no member named 'group_ema'

Move both fields before the guard so they are always available
regardless of the FAIR_GROUP_SCHED config.

Signed-off-by: Galih Tama <galpt@v.recipes>
---
 kernel/sched/sched.h | 7 ++++---
 1 file changed, 4 insertions(+), 3 deletions(-)

diff --git a/kernel/sched/sched.h b/kernel/sched/sched.h
index c01eb83e5..24f63cacb 100644
--- a/kernel/sched/sched.h
+++ b/kernel/sched/sched.h
@@ -713,6 +713,10 @@ struct cfs_rq {
 		unsigned long	runnable_avg;
 	} removed;
 
+	/* Infinity: aggregate group EMA and idle timestamp */
+	u64			group_ema;
+	u64			group_ema_sleep_start;
+
 #ifdef CONFIG_FAIR_GROUP_SCHED
 	u64			last_update_tg_load_avg;
 	unsigned long		tg_load_avg_contrib;
@@ -750,9 +754,6 @@ struct cfs_rq {
 
 #ifdef CONFIG_CFS_BANDWIDTH
 	int			runtime_enabled;
-	/* Infinity: aggregate group EMA and idle timestamp */
-	u64			group_ema;
-	u64			group_ema_sleep_start;
 
 	s64			runtime_remaining;
 
-- 
