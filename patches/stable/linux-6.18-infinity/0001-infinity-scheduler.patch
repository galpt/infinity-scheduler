From d5ecb90274a4b1eced314d8b01cda114c5ce3241 Mon Sep 17 00:00:00 2001
From: Galih Tama <galpt@v.recipes>
Date: Mon, 6 Jul 2026 07:55:57 +0700
Subject: [PATCH 4/5] v4.5: hardware-adaptive alpha via cpu_capacity, freq
 boost on futex/interactive
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

- infinity_consume now takes cpu_capacity and computes a dynamic alpha
  between 2048 (low cap) and 4096 (max perf) using the runqueue's
  native SCHED_CAPACITY_SCALE telemetry — zero overhead, no cpufreq API
- Futex wakeup path: boost frequency via cpufreq_update_util when a
  futex-woken task is enqueued (fills the gap left by wake_up_q not
  passing WF_SYNC)
- Interactive pick path: boost frequency when a zero-EMA task is
  selected, bypassing PELT ramp delay
- Preemption cushion (PRD Req 2) skipped — EEVDF already handles it
  natively through weight modulation

Signed-off-by: Galih Tama <galpt@v.recipes>
---
 kernel/sched/fair.c           | 29 +++++++++++++++++++++++++----
 kernel/sched/infinity_sched.c | 23 ++++++++++++++++++++---
 kernel/sched/infinity_sched.h |  2 +-
 3 files changed, 46 insertions(+), 8 deletions(-)

diff --git a/kernel/sched/fair.c b/kernel/sched/fair.c
index 2a9ca694b..8f761839e 100644
--- a/kernel/sched/fair.c
+++ b/kernel/sched/fair.c
@@ -1276,7 +1276,8 @@ static void update_curr(struct cfs_rq *cfs_rq)
 	/* Infinity: EMA budget consumption */
 	if (entity_is_task(curr)) {
 		struct task_struct *p__ = task_of(curr);
-		infinity_consume(&p__->infinity, delta_exec);
+		infinity_consume(&p__->infinity, delta_exec,
+				 rq_of(cfs_rq)->cpu_capacity);
 	}

 	curr->vruntime += calc_delta_fair(delta_exec, curr);
@@ -5605,6 +5606,17 @@ pick_next_entity(struct rq *rq, struct cfs_rq *cfs_rq)
 		 */
 		return NULL;
 	}
+	/*
+	 * Hint the cpufreq governor when an interactive task (zero EMA)
+	 * is picked, so it ramps frequency immediately rather than waiting
+	 * for PELT to accumulate.
+	 */
+	if (entity_is_task(se)) {
+		struct task_struct *p = task_of(se);
+		if (p->infinity.ema == 0)
+			cpufreq_update_util(rq, SCHED_CPUFREQ_IOWAIT);
+	}
+
 	return se;
 }

@@ -7065,8 +7077,11 @@ enqueue_task_fair(struct rq *rq, struct task_struct *p, int flags)
 		flags = ENQUEUE_WAKEUP;
 	}

-	if (flags & ENQUEUE_WAKEUP)
+	if (flags & ENQUEUE_WAKEUP) {
 		p->infinity.futex_waiting = false;
+		if (p->in_iowait)
+			cpufreq_update_util(rq, SCHED_CPUFREQ_IOWAIT);
+	}

