From a2e9dcc7025b92b8d0b1e1f60bb3a5056968ebcc Mon Sep 17 00:00:00 2001
From: Galih Tama <galpt@v.recipes>
Date: Mon, 6 Jul 2026 19:23:29 +0700
Subject: [PATCH 6/9] v4.5: Infinity EMA-driven migration hysteresis

Signed-off-by: Galih Tama <galpt@v.recipes>
---
 kernel/sched/fair.c | 12 ++++++++++++
 1 file changed, 12 insertions(+)

diff --git a/kernel/sched/fair.c b/kernel/sched/fair.c
index ffa8ae45f..2680dd535 100644
--- a/kernel/sched/fair.c
+++ b/kernel/sched/fair.c
@@ -9582,6 +9582,18 @@ int can_migrate_task(struct task_struct *p, struct lb_env *env)
 		return 0;
 	}
 
+	/*
+	 * Infinity: protect interactive (EMA=0) tasks from migration.
+	 * Keeping low-latency tasks cache-warm on their home CPU avoids the
+	 * L1/L2/L3 refill penalty that destroys frame-time consistency.
+	 * Active balance and desperate imbalance bypass this gate.
+	 */
+	if (!(env->flags & LBF_ACTIVE_LB) &&
+	    env->sd->nr_balance_failed <= env->sd->cache_nice_tries &&
+	    p->infinity.ema == 0) {
+		return 0;
+	}
+
 	/*
 	 * Aggressive migration if:
 	 * 1) active balance
