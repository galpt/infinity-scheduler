From 69fd8b89375f5a65aa4cc6846622709a7f3ef2a9 Mon Sep 17 00:00:00 2001
From: Galih Tama <galpt@v.recipes>
Date: Sat, 4 Jul 2026 19:47:17 +0700
Subject: [PATCH 2/9] add place_entity futex check to 6.18

Signed-off-by: Galih Tama <galpt@v.recipes>
---
 kernel/sched/fair.c | 9 ++++++++-
 1 file changed, 8 insertions(+), 1 deletion(-)

diff --git a/kernel/sched/fair.c b/kernel/sched/fair.c
index feda5474d..93fbf23c1 100644
--- a/kernel/sched/fair.c
+++ b/kernel/sched/fair.c
@@ -5283,7 +5283,14 @@ place_entity(struct cfs_rq *cfs_rq, struct sched_entity *se, int flags)
 	 * get a shorter vslice, placing their deadline earlier in the
 	 * EEVDF tree so they are picked sooner after wakeup.
 	 */
-	/* Infinity: weight handles wakeup priority, no vslice manipulation needed */
+	/*
+	 * Infinity: when a task wakes from a futex (futex_waiting is true),
+	 * halve its vslice so it gets an earlier deadline and runs sooner,
+	 * reducing IPC wakeup latency.
+	 */
+	if (entity_is_task(se) && (flags & ENQUEUE_WAKEUP) &&
+	    task_of(se)->infinity.futex_waiting)
+		vslice >>= 1;
 
 	/*
 	 * EEVDF: vd_i = ve_i + r_i/w_i
-- 
