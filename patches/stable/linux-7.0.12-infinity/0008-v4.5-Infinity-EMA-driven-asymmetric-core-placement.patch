From afe3ffa33e08222a2896cfbfe9d9ee7734f4cded Mon Sep 17 00:00:00 2001
From: Galih Tama <galpt@v.recipes>
Date: Mon, 6 Jul 2026 19:38:46 +0700
Subject: [PATCH 8/8] v4.5: Infinity EMA-driven asymmetric core placement

Signed-off-by: Galih Tama <galpt@v.recipes>
---
 kernel/sched/fair.c | 18 ++++++++++++++++++
 1 file changed, 18 insertions(+)

diff --git a/kernel/sched/fair.c b/kernel/sched/fair.c
index 2cdeb72f0..64db56230 100644
--- a/kernel/sched/fair.c
+++ b/kernel/sched/fair.c
@@ -8776,6 +8776,24 @@ select_task_rq_fair(struct task_struct *p, int prev_cpu, int wake_flags)
 		    cpumask_test_cpu(cpu, p->cpus_ptr))
 			return cpu;
 
+		/*
+		 * Infinity: on asymmetric topologies (Intel hybrid, ARM big.LITTLE),
+		 * bias interactive tasks (EMA == 0) toward the highest-capacity
+		 * P-cores.  READ_ONCE guards the lockless ema read.
+		 */
+		if (sched_asym_cpucap_active() && READ_ONCE(p->infinity.ema) == 0) {
+			struct asym_cap_data *entry;
+			rcu_read_lock();
+			list_for_each_entry_rcu(entry, &asym_cap_list, link) {
+				int __cpu = cpumask_first_and(cpu_capacity_span(entry), p->cpus_ptr);
+				if (__cpu < nr_cpu_ids) {
+					rcu_read_unlock();
+					return __cpu;
+				}
+			}
+			rcu_read_unlock();
+		}
+
 		if (!is_rd_overutilized(this_rq()->rd)) {
 			new_cpu = find_energy_efficient_cpu(p, prev_cpu);
 			if (new_cpu >= 0)
-- 
