 	 * EEVDF: vd_i = ve_i + r_i / w_i
 	 */
@@ -1298,6 +1351,12 @@ static void update_curr(struct cfs_rq *cfs_rq)
 	if (unlikely(delta_exec <= 0))
 		return;
 
+	/* Infinity: EMA budget consumption */
