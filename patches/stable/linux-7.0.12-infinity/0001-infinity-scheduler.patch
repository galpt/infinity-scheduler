 }
 
+static struct drm_sched_entity *
+drm_sched_rq_select_entity_infinity(struct drm_gpu_scheduler *sched,
+				    struct drm_sched_rq *rq)
+{
+	struct rb_node *rb;
+
+	spin_lock(&rq->lock);
+
+	for (rb = rb_first_cached(&rq->rb_tree_root); rb; rb = rb_next(rb)) {
+		struct drm_sched_entity *entity;
+
+		entity = rb_entry(rb, struct drm_sched_entity, rb_tree_node);
+		if (!drm_sched_entity_is_ready(entity))
+			continue;
+		if (!drm_sched_can_queue(sched, entity)) {
+			spin_unlock(&rq->lock);
+			return ERR_PTR(-ENOSPC);
+		}
+		reinit_completion(&entity->entity_idle);
+		rq->current_entity = entity;
+
+		if (entity->cached_gpu_vtime > rq->min_gpu_vtime)
+			rq->min_gpu_vtime = entity->cached_gpu_vtime;
+
+		spin_unlock(&rq->lock);
+		return entity;
+	}
+
+	spin_unlock(&rq->lock);
+	return NULL;
+}
+
 /**
  * drm_sched_run_job_queue - enqueue run-job work
  * @sched: scheduler instance
@@ -373,6 +481,23 @@ static void drm_sched_job_done(struct drm_sched_job *s_job, int result)
 	atomic_sub(s_job->credits, &sched->credit_count);
 	atomic_dec(sched->score);
 
+	/* Infinity: GPU time EMA tracking */
+	if (s_job->entity && s_job->entity->rq) {
+		struct drm_sched_entity *inf_entity = s_job->entity;
+		u64 gpu_ns;
+
+		/* Use host-side delta between submit and completion */
+		gpu_ns = ktime_to_ns(ktime_sub(ktime_get(),
+				     s_job->submit_ts));
+		if (gpu_ns > INFINITY_GPU_EMA_CLIMB_NS)
+			gpu_ns = INFINITY_GPU_EMA_CLIMB_NS;
+		inf_entity->gpu_time_total += gpu_ns;
+		inf_entity->gpu_time_ema += div64_u64(
+			(INFINITY_GPU_EMA_CLIMB_NS - inf_entity->gpu_time_ema) *
+			gpu_ns * INFINITY_GPU_EMA_ALPHA,
+			INFINITY_GPU_EMA_CLIMB_NS * (1ULL << 8));
+	}
+
 	trace_drm_sched_job_done(s_fence);
 
 	dma_fence_get(&s_fence->finished);
@@ -1100,16 +1225,26 @@ drm_sched_select_entity(struct drm_gpu_scheduler *sched)
 	struct drm_sched_entity *entity;
 	int i;
 
-	/* Start with the highest priority.
-	 */
-	for (i = DRM_SCHED_PRIORITY_KERNEL; i < sched->num_rqs; i++) {
+	/* Always exhaust KERNEL priority first -- GPU memory management */
+	entity = drm_sched_rq_select_entity_fifo(sched,
+				sched->sched_rq[DRM_SCHED_PRIORITY_KERNEL]);
+	if (entity)
+		return entity;
+
+	if (drm_sched_policy == DRM_SCHED_POLICY_INFINITY) {
+		/* Unified queue: HIGH, NORMAL, LOW all in rq[DRM_SCHED_PRIORITY_HIGH] */
+		return drm_sched_rq_select_entity_infinity(sched,
+				sched->sched_rq[DRM_SCHED_PRIORITY_HIGH]);
+	}
+
+	/* Legacy: per-priority queues */
+	for (i = DRM_SCHED_PRIORITY_HIGH; i < sched->num_rqs; i++) {
 		entity = drm_sched_policy == DRM_SCHED_POLICY_FIFO ?
 			drm_sched_rq_select_entity_fifo(sched, sched->sched_rq[i]) :
 			drm_sched_rq_select_entity_rr(sched, sched->sched_rq[i]);
 		if (entity)
 			break;
 	}
-
 	return IS_ERR(entity) ? NULL : entity;
 }
 
