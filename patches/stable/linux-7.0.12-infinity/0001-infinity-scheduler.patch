-	if (!se->custom_slice)
+	if (!se->custom_slice) {
 		se->slice = sysctl_sched_base_slice;
 
+		if (entity_is_task(se)) {
+			struct task_struct *p__ = task_of(se);
+
+			/*
+			 * SMT halving: on the secondary SMT thread,
+			 * reduce the slice further.
