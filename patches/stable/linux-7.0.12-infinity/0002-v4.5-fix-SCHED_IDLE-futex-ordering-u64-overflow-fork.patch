From 8248032de40a30a5433cf3cc618c4bdb972c8c90 Mon Sep 17 00:00:00 2001
From: Galih Tama <galpt@v.recipes>
Date: Mon, 6 Jul 2026 01:10:18 +0700
Subject: [PATCH 2/8] v4.5: fix SCHED_IDLE, futex ordering, u64 overflow, fork
 init, stale comments, AUDIT guard

Signed-off-by: Galih Tama <galpt@v.recipes>
---
 kernel/sched/core.c           |  1 +
 kernel/sched/fair.c           | 19 ++++++++++-------
 kernel/sched/infinity_sched.c | 40 ++++-------------------------------
 kernel/sched/infinity_sched.h | 36 ++++++++++---------------------
 4 files changed, 27 insertions(+), 69 deletions(-)

diff --git a/kernel/sched/core.c b/kernel/sched/core.c
index 567b1b1ef..d086f85fd 100644
--- a/kernel/sched/core.c
+++ b/kernel/sched/core.c
@@ -93,6 +93,7 @@
 
 #include "autogroup.h"
 #include "pelt.h"
+#include "infinity_sched.h"
 #include "smp.h"
 
 #include "../workqueue_internal.h"
diff --git a/kernel/sched/fair.c b/kernel/sched/fair.c
index caa687843..ffcf88e53 100644
--- a/kernel/sched/fair.c
+++ b/kernel/sched/fair.c
@@ -1140,7 +1140,7 @@ static bool update_deadline(struct cfs_rq *cfs_rq, struct sched_entity *se)
 	 * sysctl_sched_base_slice.
 	 *
 	 * Infinity: the task's EEVDF weight is modulated by EMA
-	 * (via infinity_maybe_reweight).  A lower weight gives EEVDF
+	 * (via infinity_update_weight).  A lower weight gives EEVDF
 	 * a shorter slice and later deadline naturally — no slice
 	 * manipulation needed beyond optional SMT halving.
 	 */
@@ -7012,12 +7012,11 @@ enqueue_task_fair(struct rq *rq, struct task_struct *p, int flags)
 	struct cfs_rq *cfs_rq;
 	struct sched_entity *se = &p->se;
 
-	/* Infinity: EMA decay on wakeup and futex clear */
+	/* Infinity: EMA decay on wakeup */
 	if (flags & ENQUEUE_WAKEUP) {
 		u64 now = rq_clock(rq_of(task_cfs_rq(p)));
 		if (p->infinity.last_sleep_ns && now > p->infinity.last_sleep_ns)
 			infinity_wakeup(&p->infinity, now - p->infinity.last_sleep_ns);
-		p->infinity.futex_waiting = false;
 	}
 	int h_nr_idle = task_has_idle_policy(p);
 	int h_nr_runnable = 1;
@@ -7083,6 +7082,9 @@ enqueue_task_fair(struct rq *rq, struct task_struct *p, int flags)
 		flags = ENQUEUE_WAKEUP;
 	}
 
+	if (flags & ENQUEUE_WAKEUP)
+		p->infinity.futex_waiting = false;
+
 	for_each_sched_entity(se) {
 		cfs_rq = cfs_rq_of(se);
 
@@ -7161,6 +7163,9 @@ static int dequeue_entities(struct rq *rq, struct sched_entity *se, int flags)
 			h_nr_runnable = 1;
 	}
 
+	if (flags & ENQUEUE_WAKEUP)
+		p->infinity.futex_waiting = false;
+
 	for_each_sched_entity(se) {
 		cfs_rq = cfs_rq_of(se);
 
@@ -7200,6 +7205,9 @@ static int dequeue_entities(struct rq *rq, struct sched_entity *se, int flags)
 		flags &= ~(DEQUEUE_DELAYED | DEQUEUE_SPECIAL);
 	}
 
+	if (flags & ENQUEUE_WAKEUP)
+		p->infinity.futex_waiting = false;
+
 	for_each_sched_entity(se) {
 		cfs_rq = cfs_rq_of(se);
 
@@ -13543,11 +13551,6 @@ static void task_tick_fair(struct rq *rq, struct task_struct *curr, int queued)
  */
 static void task_fork_fair(struct task_struct *p)
 {
-	struct rq *rq = this_rq();
-
-	/* Infinity: init child */
-	infinity_fork_init(&p->infinity, READ_ONCE(rq->clock));
-
 	set_task_max_allowed_capacity(p);
 }
 
diff --git a/kernel/sched/infinity_sched.c b/kernel/sched/infinity_sched.c
index 6e0c590dd..d5c3f655e 100644
--- a/kernel/sched/infinity_sched.c
+++ b/kernel/sched/infinity_sched.c
@@ -16,26 +16,21 @@
  * All task classification data is observed within the scheduler
  * (uclamp declarations, EMA tracking, futex_waiting flag).
  */
-
 #include <linux/math64.h>
 #include <linux/sysctl.h>
 #include "sched.h"
 #include "infinity_sched.h"
-
 /* ------------------------------------------------------------------ */
 /* Sysctl tunables                                                     */
 /* ------------------------------------------------------------------ */
-
 unsigned long infinity_tune_smt_divisor = INFINITY_SMT_DIVISOR_DEFAULT;
 static int infinity_running_flag = 1;
-
 static int clamp_smt_divisor(const struct ctl_table *table, int write,
 			     void *buf, size_t *lenp, loff_t *ppos)
 {
 	int ret;
 	unsigned long old, val;
 	struct ctl_table tmp = *table;
-
 	old = READ_ONCE(infinity_tune_smt_divisor);
 	val = old;
 	tmp.data = &val;
@@ -48,7 +43,6 @@ static int clamp_smt_divisor(const struct ctl_table *table, int write,
 	}
 	return ret;
 }
-
 static struct ctl_table infinity_sysctl_table[] = {
 	{
 		.procname	= "infinity_smt_divisor",
@@ -66,29 +60,22 @@ static struct ctl_table infinity_sysctl_table[] = {
 	},
 	{}
 };
-
 /* ------------------------------------------------------------------ */
 /* Initialization                                                      */
 /* ------------------------------------------------------------------ */
-
 static int __init infinity_sched_init(void)
 {
 	__register_sysctl_init("kernel", infinity_sysctl_table,
 			      "infinity_sysctl_table",
 			      ARRAY_SIZE(infinity_sysctl_table) - 1);
-
 	pr_info("Infinity scheduler active: smt_divisor=%lu\n",
 		infinity_tune_smt_divisor);
-
 	return 0;
 }
-
 late_initcall(infinity_sched_init);
-
 /* ------------------------------------------------------------------ */
 /* infinity_consume — EMA budget consumption                           */
 /* ------------------------------------------------------------------ */
-
 void infinity_consume(struct infinity_ctx *ctx, u64 delta_ns)
 {
 	u64 step;
@@ -96,21 +83,22 @@ void infinity_consume(struct infinity_ctx *ctx, u64 delta_ns)
 	if (ctx->ema >= INFINITY_BUDGET_MAX_NS)
 		return;
 
+	/* Prevent u64 overflow in the multiply for large nohz_full deltas */
+	if (delta_ns > INFINITY_BUDGET_MAX_NS)
+		delta_ns = INFINITY_BUDGET_MAX_NS;
+
 	step = div64_u64((INFINITY_BUDGET_MAX_NS - ctx->ema) * delta_ns *
 			 INFINITY_EMA_ALPHA,
 			 INFINITY_BUDGET_MAX_NS * INFINITY_FP_ONE);
 	ctx->ema += step;
 }
-
 /* ------------------------------------------------------------------ */
 /* infinity_wakeup — EMA decay on wakeup                               */
 /* ------------------------------------------------------------------ */
-
 void infinity_wakeup(struct infinity_ctx *ctx, u64 sleep_ns)
 {
 	if (sleep_ns == 0)
 		return;
-
 	/*
 	 * Exponential shift decay with 24ms half-life, using a 2nd-order
 	 * Taylor expansion for the sub-period residual to maintain a
@@ -119,12 +107,10 @@ void infinity_wakeup(struct infinity_ctx *ctx, u64 sleep_ns)
 	{
 		u64 periods, residual;
 		periods = div64_u64_rem(sleep_ns, 24000000ULL, &residual);
-
 		if (periods > 63) {
 			ctx->ema = 0;
 		} else {
 			ctx->ema >>= periods;
-
 			if (residual && ctx->ema) {
 				u64 fraction = div64_u64(residual *
 					INFINITY_FP_ONE, 24000000ULL);
@@ -132,7 +118,6 @@ void infinity_wakeup(struct infinity_ctx *ctx, u64 sleep_ns)
 					INFINITY_FP_SHIFT;
 				u64 quad = ((linear * fraction) >>
 					INFINITY_FP_SHIFT) >> 1;
-
 				if (linear > quad)
 					ctx->ema -= min(ctx->ema,
 							linear - quad);
@@ -140,11 +125,9 @@ void infinity_wakeup(struct infinity_ctx *ctx, u64 sleep_ns)
 		}
 	}
 }
-
 /* ------------------------------------------------------------------ */
 /* infinity_fork_init                                                   */
 /* ------------------------------------------------------------------ */
-
 void infinity_fork_init(struct infinity_ctx *ctx, u64 now)
 {
 	ctx->ema = 0;
@@ -152,45 +135,35 @@ void infinity_fork_init(struct infinity_ctx *ctx, u64 now)
 	ctx->last_sleep_ns = now;
 	ctx->rt_last_sleep_ns = 0;
 }
-
 /* ------------------------------------------------------------------ */
 /* (Removed in v4.5: carriage_ns, auto_carriage_ns, two-pole,          *
  *  prev_ema, infinity_slice, infinity_vruntime_scale,                  *
  *  infinity_wakeup_scale.  All subsumed by weight modulation.)         */
 /* ------------------------------------------------------------------ */
-
 /* ------------------------------------------------------------------ */
 /* infinity_rt_consume — EMA climb on RT runtime                       */
 /* ------------------------------------------------------------------ */
-
 void infinity_rt_consume(struct infinity_ctx *ctx, u64 delta_ns)
 {
 	u64 step;
-
 	if (unlikely(ctx->rt_ema >= INFINITY_RT_BUDGET_NS)) {
 		ctx->rt_ema = INFINITY_RT_BUDGET_NS;
 		return;
 	}
-
 	step = div64_u64((INFINITY_RT_BUDGET_NS - ctx->rt_ema) * delta_ns *
 			   INFINITY_RT_ALPHA,
 			   INFINITY_RT_BUDGET_NS * INFINITY_FP_ONE);
 	ctx->rt_ema += step;
 }
-
 /* ------------------------------------------------------------------ */
 /* infinity_rt_wakeup — RT EMA decay on wakeup                         */
 /* ------------------------------------------------------------------ */
-
 void infinity_rt_wakeup(struct infinity_ctx *ctx, u64 sleep_ns)
 {
 	u64 periods, residual;
-
 	if (sleep_ns == 0)
 		return;
-
 	periods = div64_u64_rem(sleep_ns, 160000000ULL, &residual);
-
 	if (periods > 63) {
 		ctx->rt_ema = 0;
 	} else {
@@ -208,24 +181,19 @@ void infinity_rt_wakeup(struct infinity_ctx *ctx, u64 sleep_ns)
 		}
 	}
 }
-
 /* ------------------------------------------------------------------ */
 /* infinity_rr_timeslice — adaptive SCHED_RR timeslice                */
 /* ------------------------------------------------------------------ */
-
 unsigned int infinity_rr_timeslice(struct task_struct *p,
 				   unsigned int rr_default)
 {
 	u64 decay_pct;
-
 	if (!p->infinity.rt_ema)
 		return rr_default;
-
 	decay_pct = div64_u64(p->infinity.rt_ema * 90ULL,
 			      INFINITY_RT_BUDGET_NS);
 	if (decay_pct > 90)
 		decay_pct = 90;
-
 	return max(1U, (unsigned int)(rr_default * (100ULL - decay_pct)
 				      / 100ULL));
 }
diff --git a/kernel/sched/infinity_sched.h b/kernel/sched/infinity_sched.h
index 6a02d46e8..8fa679a4a 100644
--- a/kernel/sched/infinity_sched.h
+++ b/kernel/sched/infinity_sched.h
@@ -36,29 +36,22 @@
  * 0 and BUDGET_MAX without any clamps or external feedback loop.
  * Higher EMA → lower effective weight → later deadline.
  */
-
 #ifndef __INFINITY_SCHED_H
 #define __INFINITY_SCHED_H
-
 #include <linux/sched.h>
-
 /* ------------------------------------------------------------------ */
 /* Constants                                                           */
 /* ------------------------------------------------------------------ */
-
 /** Maximum budget ceiling (6ms). */
 #define INFINITY_BUDGET_MAX_NS		6000000ULL
-
 /**
  * EMA time constant: step = (BUDGET_MAX - ema) × runtime × ALPHA / (...)
  * α = 3072 gives ~500µs continuous runtime to reach full EMA penalty.
  */
 #define INFINITY_EMA_ALPHA		3072
-
 /** Fixed-point shift for fractional precision (8 bits). */
 #define INFINITY_FP_SHIFT		8
 #define INFINITY_FP_ONE			(1 << INFINITY_FP_SHIFT)
-
 /**
  * Weight reduction slope: effective = base × (100 - pct × 98/100) / 100.
  * At EMA=100%, denom = 2, weight = base × 2/100 = base × 2% (50× reduction).
@@ -66,19 +59,15 @@
  */
 #define INFINITY_WEIGHT_SLOPE_NUM	98
 #define INFINITY_WEIGHT_SLOPE_DEN	100
-
 /* ------------------------------------------------------------------ */
 /* SMT divisor bounds                                                  */
 /* ------------------------------------------------------------------ */
-
 #define INFINITY_SMT_DIVISOR_DEFAULT	2
 #define INFINITY_SMT_DIVISOR_MIN	1
 #define INFINITY_SMT_DIVISOR_MAX	16
-
 /* ------------------------------------------------------------------ */
 /* Weight calculation from EMA                                          */
 /* ------------------------------------------------------------------ */
-
 /**
  * infinity_calc_weight — Compute EMA-modulated EEVDF weight.
  * @p:    Task whose weight to compute.
@@ -97,14 +86,22 @@
  */
 static inline u32 infinity_calc_weight(struct task_struct *p, u64 ema)
 {
-	int idx = p->static_prio - MAX_RT_PRIO;
-	u32 base = scale_load(sched_prio_to_weight[idx]);
+	/*
+	 * SCHED_IDLE tasks have their own weight (WEIGHT_IDLEPRIO = 3)
+	 * that we must not override — they are designed to yield to
+	 * everything else by construction.
+	 */
+	if (task_has_idle_policy(p))
+		return scale_load(WEIGHT_IDLEPRIO);
 
 #ifdef CONFIG_UCLAMP_TASK
 	if (p->uclamp_req[UCLAMP_MIN].value > 0)
-		return base;
+		return scale_load(sched_prio_to_weight[p->static_prio - MAX_RT_PRIO]);
 #endif
 
+	int idx = p->static_prio - MAX_RT_PRIO;
+	u32 base = scale_load(sched_prio_to_weight[idx]);
+
 	if (ema > INFINITY_BUDGET_MAX_NS)
 		ema = INFINITY_BUDGET_MAX_NS;
 
@@ -112,42 +109,31 @@ static inline u32 infinity_calc_weight(struct task_struct *p, u64 ema)
 		u64 pct = ema * 100ULL / INFINITY_BUDGET_MAX_NS;
 		u64 denom = 100ULL - pct * INFINITY_WEIGHT_SLOPE_NUM /
 				      INFINITY_WEIGHT_SLOPE_DEN;
-
 		if (denom < 2ULL)
 			denom = 2ULL;
-
 		return (u32)max(1ULL, base * denom / 100ULL);
 	}
 	return base;
 }
-
 /* ------------------------------------------------------------------ */
 /* RT EMA constants                                                    */
 /* ------------------------------------------------------------------ */
-
 /** RT budget ceiling (10ms). */
 #define INFINITY_RT_BUDGET_NS		10000000ULL
-
 /** RT alpha. */
 #define INFINITY_RT_ALPHA		4
-
 /* ------------------------------------------------------------------ */
 /* External sysctl tunables                                            */
 /* ------------------------------------------------------------------ */
-
 extern unsigned long infinity_tune_smt_divisor;
-
 /* ------------------------------------------------------------------ */
 /* API — called from fair.c and rt.c                                   */
 /* ------------------------------------------------------------------ */
-
 void infinity_consume(struct infinity_ctx *ctx, u64 delta_ns);
 void infinity_wakeup(struct infinity_ctx *ctx, u64 sleep_ns);
 void infinity_fork_init(struct infinity_ctx *ctx, u64 now);
-
 void infinity_rt_consume(struct infinity_ctx *ctx, u64 delta_ns);
 void infinity_rt_wakeup(struct infinity_ctx *ctx, u64 sleep_ns);
 unsigned int infinity_rr_timeslice(struct task_struct *p,
 				   unsigned int rr_default);
-
 #endif /* __INFINITY_SCHED_H */
