From 0d35d1c9dfd8dc85dd14d7da638ded965473f96d Mon Sep 17 00:00:00 2001
From: Galih Tama <galpt@v.recipes>
Date: Tue, 7 Jul 2026 23:40:45 +0700
Subject: [PATCH 23/24] v4.6-gpu: add missing EMA idle decay to prevent sticky
 throttle

The gpu_time_ema only climbed on job completion but never decayed
during idle periods.  An application that had one burst of GPU
activity would carry that penalty permanently.

Fix: in drm_sched_rq_update_fifo_locked(), when the INFINITY policy
is active, compute idle time from gpu_time_last_active to the new
job submission timestamp and decay gpu_time_ema exponentially
using the 32ms half-life constant.  Record the new active timestamp.

This completes the EMA feedback loop: climb on activity, decay on idle.

Signed-off-by: Galih Tama <galpt@v.recipes>
---
 drivers/gpu/drm/scheduler/sched_main.c | 17 +++++++++++++++++
 1 file changed, 17 insertions(+)

diff --git a/drivers/gpu/drm/scheduler/sched_main.c b/drivers/gpu/drm/scheduler/sched_main.c
index 53b24a43b..e057e0361 100644
--- a/drivers/gpu/drm/scheduler/sched_main.c
+++ b/drivers/gpu/drm/scheduler/sched_main.c
@@ -236,6 +236,23 @@ void drm_sched_rq_update_fifo_locked(struct drm_sched_entity *entity,
 	entity->oldest_job_waiting = ts;
 
 	if (drm_sched_policy == DRM_SCHED_POLICY_INFINITY) {
+		/* Infinity EMA decay on idle: if the entity went idle
+		 * between its last active timestamp and the current job
+		 * submission, decay gpu_time_ema proportionally.  Without
+		 * this the EMA would be permanently sticky (maxed out
+		 * after any burst) and never recover. */
+		if (entity->gpu_time_last_active) {
+			u64 idle_ns = ktime_to_ns(ktime_sub(ts,
+				entity->gpu_time_last_active));
+			u64 periods = div64_u64(idle_ns,
+				INFINITY_GPU_EMA_HALFLIFE_NS);
+			if (periods > 63)
+				entity->gpu_time_ema = 0;
+			else if (periods)
+				entity->gpu_time_ema >>= periods;
+		}
+		entity->gpu_time_last_active = ts;
+
 		entity->cached_gpu_vtime = drm_sched_entity_calc_vtime(entity);
 		entity->normalized_base = entity->gpu_time_total;
 		rb_add_cached(&entity->rb_tree_node, &rq->rb_tree_root,
-- 
