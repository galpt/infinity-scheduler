From c16254ac1628eec6ecb5f0513d2780c0ad38d2ad Mon Sep 17 00:00:00 2001
From: Galih Tama <galpt@v.recipes>
Date: Sat, 4 Jul 2026 19:16:19 +0700
Subject: [PATCH 02/11] v4.5: complete implementation

Signed-off-by: Galih Tama <galpt@v.recipes>
---
 include/linux/sched.h   | 1 -
 init/init_task.c        | 1 -
 kernel/futex/waitwake.c | 6 +++++-
 kernel/sched/fair.c     | 4 +++-
 4 files changed, 8 insertions(+), 4 deletions(-)

diff --git a/include/linux/sched.h b/include/linux/sched.h
index 891a84d18..0f82edaa3 100644
--- a/include/linux/sched.h
+++ b/include/linux/sched.h
@@ -819,7 +819,6 @@ struct kmap_ctrl {
 
 struct infinity_ctx {
 	u64		ema;
-	u64		prev_ema;
 	u64		rt_ema;		/* RT EMA: tracks RT CPU burstiness */
 	u64		last_sleep_ns;
 	u64		rt_last_sleep_ns; /* Sleep timestamp for RT EMA decay */
diff --git a/init/init_task.c b/init/init_task.c
index 093f34eeb..ca4ba3887 100644
--- a/init/init_task.c
+++ b/init/init_task.c
@@ -150,7 +150,6 @@ struct task_struct init_task __aligned(L1_CACHE_BYTES) = {
 	.group_leader	= &init_task,
 	.infinity		= {
 				.ema		= 0,
-				.prev_ema	= 0,
 				.rt_ema		= 0,
 				.last_sleep_ns	= 0,
 				.rt_last_sleep_ns = 0,
diff --git a/kernel/futex/waitwake.c b/kernel/futex/waitwake.c
index ceed9d879..0a860c2fc 100644
--- a/kernel/futex/waitwake.c
+++ b/kernel/futex/waitwake.c
@@ -354,8 +354,12 @@ void futex_do_wait(struct futex_q *q, struct hrtimer_sleeper *timeout)
 		 * flagged for rescheduling. Only call schedule if there
 		 * is no timeout, or if it has yet to expire.
 		 */
-		if (!timeout || timeout->task)
+		if (!timeout || timeout->task) {
+			/* Infinity: signal futex-waiting for vslice boost on wakeup */
+			current->infinity.futex_waiting = true;
 			schedule();
+			current->infinity.futex_waiting = false;
+		}
 	}
 	__set_current_state(TASK_RUNNING);
 }
diff --git a/kernel/sched/fair.c b/kernel/sched/fair.c
index 59732b03b..7ff59274f 100644
--- a/kernel/sched/fair.c
+++ b/kernel/sched/fair.c
@@ -69,7 +69,9 @@ static void infinity_update_weight(struct cfs_rq *cfs_rq,
 	u64 ema;
 	u32 new_weight;
 
-	ema = infinity_effective_ema(&p->infinity);
+	ema = p->infinity.ema;
+	if (ema > INFINITY_BUDGET_MAX_NS)
+		ema = INFINITY_BUDGET_MAX_NS;
 	new_weight = infinity_calc_weight(p, ema);
 
 	if (new_weight != se->load.weight)
-- 
