From 665c5009e5068ced35aed511b1fd7e8d9a74b461 Mon Sep 17 00:00:00 2001
From: Galih Tama <galpt@v.recipes>
Date: Tue, 4 Aug 2026 14:29:11 +0700
Subject: [PATCH 26/50] v4.8-gpu: harden the EMA math

Clamp the task EMA climb step at the remaining gap to the budget
ceiling: with the hardware-adaptive alpha at 4096 and FP_ONE at 256 a
single step can overshoot INFINITY_BUDGET_MAX_NS, pushing the raw ema
past the 6ms ceiling (the weight math clamps downstream, but the raw
value must stay within [0, BUDGET]).  Add monotonicity guards to the
cgroup group_ema climb and decay: the decay path lacked the guard the
task and RT paths already have, and its sleep stamp can cross rq-clock
domains after migration, so a backward clock retains the EMA (the safe
direction) while WARN_ON_ONCE surfaces any wraparound or corruption.

Signed-off-by: Galih Tama <galpt@v.recipes>
---
 kernel/sched/fair.c           | 34 +++++++++++++++++++++++++++-------
 kernel/sched/infinity_sched.c |  9 +++++++++
 2 files changed, 36 insertions(+), 7 deletions(-)

diff --git a/kernel/sched/fair.c b/kernel/sched/fair.c
index f41ccb149..f6e2f54d0 100644
--- a/kernel/sched/fair.c
+++ b/kernel/sched/fair.c
@@ -1371,10 +1371,15 @@ static void update_curr(struct cfs_rq *cfs_rq)
 
 			if (delta > INFINITY_CGROUP_EMA_CLIMB_NS)
 				delta = INFINITY_CGROUP_EMA_CLIMB_NS;
+			u64 old = gcfs_rq->group_ema;
 			gcfs_rq->group_ema += div64_u64(
 				(INFINITY_CGROUP_EMA_CLIMB_NS - gcfs_rq->group_ema) *
 				delta * INFINITY_CGROUP_EMA_ALPHA,
 				INFINITY_CGROUP_EMA_CLIMB_NS * INFINITY_FP_ONE);
+			/* Infinity: the climb is saturating at INFINITY_CGROUP_EMA_CLIMB_NS;
+			 * a regression here indicates wraparound/corruption.
+			 */
+			WARN_ON_ONCE(gcfs_rq->group_ema < old);
 		}
 	}
 
@@ -7085,13 +7090,28 @@ enqueue_task_fair(struct rq *rq, struct task_struct *p, int flags)
 
 		if (pcfs_rq->group_ema_sleep_start) {
 			u64 now = rq_clock(rq_of(pcfs_rq));
-			u64 sleep_ns = now - pcfs_rq->group_ema_sleep_start;
-			u64 periods = div64_u64(sleep_ns,
-				INFINITY_CGROUP_EMA_HALFLIFE_NS);
-			if (periods > 63)
-				pcfs_rq->group_ema = 0;
-			else
-				pcfs_rq->group_ema >>= periods;
+
+			/*
+			 * Infinity: group_ema stamps are rq_clock() taken under the
+			 * owning rq's lock (fresh at stamp time).  The arrival may be
+			 * on another rq after migration, so the delta is guarded: a
+			 * backward clock (broken TSC sync / cross-rq skew) retains
+			 * the EMA -- the safe direction, same pattern as the task
+			 * (fair.c) and RT paths.
+			 */
+			if (now > pcfs_rq->group_ema_sleep_start) {
+				u64 old = pcfs_rq->group_ema;
+				u64 sleep_ns = now - pcfs_rq->group_ema_sleep_start;
+				u64 periods = div64_u64(sleep_ns,
+							 INFINITY_CGROUP_EMA_HALFLIFE_NS);
+
+				if (periods > 63)
+					pcfs_rq->group_ema = 0;
+				else
+					pcfs_rq->group_ema >>= periods;
+				/* Infinity: decay must never raise the EMA. */
+				WARN_ON_ONCE(pcfs_rq->group_ema > old);
+			}
 			pcfs_rq->group_ema_sleep_start = 0;
 		}
 	}
diff --git a/kernel/sched/infinity_sched.c b/kernel/sched/infinity_sched.c
index 5ac60566d..eeb046d9b 100644
--- a/kernel/sched/infinity_sched.c
+++ b/kernel/sched/infinity_sched.c
@@ -507,6 +507,15 @@ void infinity_consume(struct infinity_ctx *ctx, u64 delta_ns,
 	step = div64_u64((INFINITY_BUDGET_MAX_NS - ctx->ema) * delta_ns *
 			 alpha,
 			 INFINITY_BUDGET_MAX_NS * INFINITY_FP_ONE);
+	/*
+	 * With alpha up to 4096 (FP_ONE = 256) the step can exceed the
+	 * remaining gap to the ceiling, which would push ema past
+	 * INFINITY_BUDGET_MAX_NS (the weight math clamps it downstream,
+	 * but the raw value must stay within [0, BUDGET] so the
+	 * /proc/<pid>/infinity reading and the EMA invariants hold).
+	 */
+	if (step > INFINITY_BUDGET_MAX_NS - ctx->ema)
+		step = INFINITY_BUDGET_MAX_NS - ctx->ema;
 	ctx->ema += step;
 	atomic64_inc(this_cpu_ptr(&infinity_ema_climb_count));
 }
-- 
