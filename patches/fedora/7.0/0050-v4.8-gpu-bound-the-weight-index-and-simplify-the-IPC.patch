From 4d55ad81bcb66573df2b85de2e6109d1a5233f6a Mon Sep 17 00:00:00 2001
From: Galih Tama <galpt@v.recipes>
Date: Fri, 14 Aug 2026 23:15:53 +0700
Subject: [PATCH 50/50] v4.8-gpu: bound the weight index and simplify the IPC
 gradient math

Adds a bounds check for the sched_prio_to_weight index in
infinity_calc_weight() and rewrites infinity_ipc_gradient() with
mul_u64_u32_div.  The gradient result is bit-identical to the previous
math, and the bounds check falls back to WEIGHT_IDLEPRIO on an
out-of-range index.

Adapted from the contribution by Salman Wahib (sxlmnwb) via PR #22.

Signed-off-by: Galih Tama <galpt@v.recipes>
---
 kernel/sched/infinity_sched.h | 17 +++++++++++------
 1 file changed, 11 insertions(+), 6 deletions(-)

diff --git a/kernel/sched/infinity_sched.h b/kernel/sched/infinity_sched.h
index 7c6a3e833..c545ead63 100644
--- a/kernel/sched/infinity_sched.h
+++ b/kernel/sched/infinity_sched.h
@@ -84,8 +84,9 @@ static inline u64 infinity_ipc_gradient(u64 sleep_ns)
 		return INFINITY_FP_ONE / 2;
 	if (sleep_ns >= INFINITY_IPC_GRADIENT_MAX_NS)
 		return 0;
-	return div64_u64((span - (sleep_ns - INFINITY_IPC_GRADIENT_FULL_NS)) *
-			 INFINITY_FP_ONE / 2, span);
+	u64 diff = span - (sleep_ns - INFINITY_IPC_GRADIENT_FULL_NS);
+	/* Use mul_u64_u32_div for better precision and efficiency */
+	return mul_u64_u32_div(diff, INFINITY_FP_ONE / 2, span);
 }
 /**
  * Weight reduction slope: effective = base × (100 - pct × 98/100) / 100.
@@ -129,14 +130,18 @@ static inline u32 infinity_calc_weight(struct task_struct *p, u64 ema)
 	if (task_has_idle_policy(p))
 		return scale_load(WEIGHT_IDLEPRIO);
 
+	int idx = p->static_prio - MAX_RT_PRIO;
+
+	if (idx < 0 || idx >= ARRAY_SIZE(sched_prio_to_weight))
+		return scale_load(WEIGHT_IDLEPRIO);
+
+	u32 base = scale_load(sched_prio_to_weight[idx]);
+
 #ifdef CONFIG_UCLAMP_TASK
 	if (p->uclamp_req[UCLAMP_MIN].value > 0)
-		return scale_load(sched_prio_to_weight[p->static_prio - MAX_RT_PRIO]);
+		return base;
 #endif
 
-	int idx = p->static_prio - MAX_RT_PRIO;
-	u32 base = scale_load(sched_prio_to_weight[idx]);
-
 	if (ema > INFINITY_BUDGET_MAX_NS)
 		ema = INFINITY_BUDGET_MAX_NS;
 
