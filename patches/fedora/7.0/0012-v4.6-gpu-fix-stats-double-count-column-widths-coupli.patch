From 65cdb22d8e5302e088869ebca87dfa51109c8a95 Mon Sep 17 00:00:00 2001
From: Galih Tama <galpt@v.recipes>
Date: Sun, 26 Jul 2026 18:24:46 +0700
Subject: [PATCH 12/49] v4.6-gpu: fix stats double-count, column widths,
 coupling guards

- Remove double-count of infinity_gpu_accounting_applied: keep the
  per-job increment in get_finished_job, remove the per-drain one
  from update_vtime_locked (the correct fix per QA review)
- Widen stats description column from 26 to 30 to accommodate
  'interactive vtime reduction' label
- Fix verdict logic: check !gcb first; treat gapp >= gcb as healthy
- Remove all #ifdef CONFIG_INFINITY_SCHED guards (no such Kconfig
  option exists in Infinity -- cross-scheduler coupling must always
  compile when Infinity patches are applied)

Signed-off-by: Galih Tama <galpt@v.recipes>
---
 drivers/gpu/drm/scheduler/sched_entity.c |  4 ----
 drivers/gpu/drm/scheduler/sched_main.c   |  5 -----
 kernel/sched/infinity_sched.c            | 21 +++++++++------------
 3 files changed, 9 insertions(+), 21 deletions(-)

diff --git a/drivers/gpu/drm/scheduler/sched_entity.c b/drivers/gpu/drm/scheduler/sched_entity.c
index 7a5d59358..f5557c3cb 100644
--- a/drivers/gpu/drm/scheduler/sched_entity.c
+++ b/drivers/gpu/drm/scheduler/sched_entity.c
@@ -117,7 +117,6 @@ int drm_sched_entity_init(struct drm_sched_entity *entity,
 	atomic_set(&entity->fence_seq, 0);
 	entity->fence_context = dma_fence_context_alloc(2);
 
-#ifdef CONFIG_INFINITY_SCHED
 	/* Capture the owning process PID for cross-scheduler coupling.
 	 * get_task_pid() takes a reference on the pid struct -- safe even
 	 * if the process exits before entity_fini releases it.
@@ -126,7 +125,6 @@ int drm_sched_entity_init(struct drm_sched_entity *entity,
 	 */
 	entity->infinity_pid = get_task_pid(current->group_leader,
 					    PIDTYPE_PID);
-#endif
 
 	return 0;
 }
@@ -395,12 +393,10 @@ void drm_sched_entity_fini(struct drm_sched_entity *entity)
 	dma_fence_put(rcu_dereference_check(entity->last_scheduled, true));
 	RCU_INIT_POINTER(entity->last_scheduled, NULL);
 
-#ifdef CONFIG_INFINITY_SCHED
 	if (entity->infinity_pid) {
 		put_pid(entity->infinity_pid);
 		entity->infinity_pid = NULL;
 	}
-#endif
 }
 EXPORT_SYMBOL(drm_sched_entity_fini);
 
diff --git a/drivers/gpu/drm/scheduler/sched_main.c b/drivers/gpu/drm/scheduler/sched_main.c
index 33eaf6323..659322adb 100644
--- a/drivers/gpu/drm/scheduler/sched_main.c
+++ b/drivers/gpu/drm/scheduler/sched_main.c
@@ -198,7 +198,6 @@ static inline u64 drm_sched_entity_calc_vtime(struct drm_sched_entity *entity)
 		effective_total = entity->gpu_time_total;
 	}
 
-#ifdef CONFIG_INFINITY_SCHED
 	/* CPU-to-GPU cross-scheduler coupling.
 	 *
 	 * Read the owning task's CPU-side interactivity signals via the
@@ -238,7 +237,6 @@ static inline u64 drm_sched_entity_calc_vtime(struct drm_sched_entity *entity)
 
 		effective_total -= coupling_boost;
 	}
-#endif
 
 	vtime = effective_total;
 
@@ -313,7 +311,6 @@ void drm_sched_rq_update_vtime_locked(struct drm_sched_entity *entity,
 				climb_ns * INFINITY_GPU_EMA_ALPHA,
 				INFINITY_GPU_EMA_CLIMB_NS * (1ULL << 8));
 
-			atomic_inc(&infinity_gpu_accounting_applied);
 			atomic_inc(&infinity_gpu_lock_drain_rounds);
 		}
 	}
@@ -430,7 +427,6 @@ drm_sched_rq_select_entity_infinity(struct drm_gpu_scheduler *sched,
 		if (entity->cached_gpu_vtime > rq->min_gpu_vtime)
 			rq->min_gpu_vtime = entity->cached_gpu_vtime;
 
-#ifdef CONFIG_INFINITY_SCHED
 		/* GPU-to-CPU feedback: increment gpu_passovers on all other
 		 * ready entities that are further right in the rbtree (higher
 		 * vtime), so their owning tasks' CPU-side infinity_wakeup()
@@ -457,7 +453,6 @@ drm_sched_rq_select_entity_infinity(struct drm_gpu_scheduler *sched,
 				rcu_read_unlock();
 			}
 		}
-#endif
 
 		spin_unlock(&rq->lock);
 		return entity;
diff --git a/kernel/sched/infinity_sched.c b/kernel/sched/infinity_sched.c
index f760ce087..237d4a9c3 100644
--- a/kernel/sched/infinity_sched.c
+++ b/kernel/sched/infinity_sched.c
@@ -205,14 +205,11 @@ static int infinity_stats_proc_handler(const struct ctl_table *ctl, int write,
 	/*
 	 * Table layout (printf-style, auto-aligned):
 	 *
-	 *   | %-22s | %13s | %-26s |
-	 *   +------------------------+---------------+----------------------------+
-	 *
-	 * %-22s accounts for Unicode box-drawing in tree branch labels
-	 * (each Unicode char = 3 bytes, 1 visible).  Total row width: 71.
+	 *   | %-22s | %13s | %-30s |
+	 *   +------------------------+---------------+--------------------------------+
 	 */
-	const char *SEP = "+------------------------+---------------+----------------------------+";
-	const char *ROW = "| %-22s | %13s | %-26s |\n";
+	const char *SEP = "+------------------------+---------------+---------------------------+";
+	const char *ROW = "| %-22s | %13s | %-30s |\n";
 
 	if (write)
 		return -EROFS;
@@ -377,17 +374,17 @@ static int infinity_stats_proc_handler(const struct ctl_table *ctl, int write,
 			bufsz);
 	}
 
-	if (gcb && gapp == gcb)
+	if (!gcb)
+		strlcat(buf, "Verdict: No GPU jobs recorded yet\n",
+			bufsz);
+	else if (gapp >= gcb)
 		strlcat(buf,
 			"Verdict: All counters healthy -- system operating normally\n",
 			bufsz);
-	else if (gcb && gapp < gcb)
+	else
 		strlcat(buf,
 			"Verdict: Accounting mismatch detected -- see above for details\n",
 			bufsz);
-	else
-		strlcat(buf, "Verdict: No GPU jobs recorded yet\n",
-			bufsz);
 
 	*lenp = simple_read_from_buffer(buffer, *lenp, ppos, buf,
 					strnlen(buf, bufsz));
-- 
