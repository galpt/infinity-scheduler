From 963913103122a7cf4fce1634ef84f276bd620dba Mon Sep 17 00:00:00 2001
From: Galih Tama <galpt@v.recipes>
Date: Sun, 26 Jul 2026 16:19:31 +0700
Subject: [PATCH 07/50] v4.6-gpu: replace fixed catch-up with proportional idle
 compensation

Replace the EMA-gated idle-start (gpu_time_ema == 0 gate) and fixed
5ms catch-up bonus with a continuously-scaled blend based on actual
wall-clock idle duration:

  idle_ratio = idle_ns / (idle_ns + EMA_HALFLIFE_NS)
  effective_total = gpu_time_total * (1 - idle_ratio)
                  + min_gpu_vtime * idle_ratio

Properties:
- Continuous, not binary: no EMA == 0 gate that never triggers in
  practice due to periodic compositing keeping EMA > 0.
- Scales with min_gpu_vtime: when min_gpu_vtime is large and the
  entity has been idle for seconds, effective_total converges to
  the entity's actual small gpu_time_total (full idle boost).
- After 64+ half-lives (~2s) the fully-idle path is taken:
  effective_total = gpu_time_total with no catch-up.
- No new kernel constants needed -- uses existing
  INFINITY_GPU_EMA_HALFLIFE_NS (32ms).
- Implemented as 16.16 fixed-point, u64-safe across all realistic
  GPU time scales.

Signed-off-by: Galih Tama <galpt@v.recipes>
---
 drivers/gpu/drm/scheduler/sched_main.c | 54 +++++++++++++++++++-------
 1 file changed, 41 insertions(+), 13 deletions(-)

diff --git a/drivers/gpu/drm/scheduler/sched_main.c b/drivers/gpu/drm/scheduler/sched_main.c
index 362ed1aae..81b7c8482 100644
--- a/drivers/gpu/drm/scheduler/sched_main.c
+++ b/drivers/gpu/drm/scheduler/sched_main.c
@@ -148,22 +148,50 @@ static inline u64 drm_sched_entity_calc_vtime(struct drm_sched_entity *entity)
 
 	if (entity->gpu_time_total < rq->min_gpu_vtime) {
 		/*
-		 * EMA-gated idle-start priority: if this entity has been idle
-		 * (gpu_time_ema == 0, meaning no recent GPU submissions), do
-		 * NOT apply the catch-up boost.  Use the entity's actual small
-		 * gpu_time_total so it gets sustained scheduling priority.
+		 * Proportionally-scaled idle compensation.
 		 *
-		 * This naturally handles multi-process browser architectures:
-		 * the GPU EMA is an entity-level signal that decays to 0 when
-		 * idle regardless of which OS process created the entity or
-		 * submitted the jobs.  No cross-scheduler PID tracking needed.
+		 * When an entity returns from idle, its gpu_time_total is
+		 * far behind min_gpu_vtime.  Rather than a fixed catch-up
+		 * bonus (which doesn't scale when min_gpu_vtime is large),
+		 * compute a weighted blend between the entity's actual
+		 * small total and the front's min_gpu_vtime.
+		 *
+		 * The blend factor (idle_ratio) is a function of actual
+		 * wall-clock idle time: 0 = fully active (no boost),
+		 * approaching 1 = idle for many half-lives (full boost).
+		 *
+		 *    idle_ratio = idle_ns / (idle_ns + HALFLIFE_NS)
+		 *    effective_total = gpu_total * (1 - idle_ratio)
+		 *                    + min_gpu_vtime * idle_ratio
+		 *
+		 * Implemented as 16.16 fixed-point to avoid floating point.
+		 * After 64+ half-lives (~2s) the entity gets its actual
+		 * gpu_time_total with no catch-up at all.
 		 */
-		if (entity->gpu_time_ema == 0)
+		u64 idle_ns;
+		u64 idle_ratio;
+
+		if (entity->gpu_time_last_active) {
+			ktime_t now = ktime_get();
+
+			idle_ns = ktime_to_ns(ktime_sub(now,
+					     entity->gpu_time_last_active));
+		} else {
+			idle_ns = 0;
+		}
+
+		if (idle_ns >= INFINITY_GPU_EMA_HALFLIFE_NS * 64ULL) {
 			effective_total = entity->gpu_time_total;
-		else if (rq->min_gpu_vtime < INFINITY_GPU_CATCHUP_BONUS_NS)
-			effective_total = 0;
-		else
-			effective_total = rq->min_gpu_vtime - INFINITY_GPU_CATCHUP_BONUS_NS;
+		} else {
+			idle_ratio = div64_u64(idle_ns * (1ULL << 16),
+					       idle_ns +
+					       INFINITY_GPU_EMA_HALFLIFE_NS);
+
+			effective_total =
+				(entity->gpu_time_total *
+				 ((1ULL << 16) - idle_ratio) +
+				 rq->min_gpu_vtime * idle_ratio) >> 16;
+		}
 	} else {
 		effective_total = entity->gpu_time_total;
 	}
-- 
