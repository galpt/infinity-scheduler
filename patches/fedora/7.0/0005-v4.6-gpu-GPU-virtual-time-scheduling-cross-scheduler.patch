+/* ------------------------------------------------------------------ */
+/* Human-readable number formatting                                    */
+/* ------------------------------------------------------------------ */
+static __maybe_unused void fmt_human(char *buf, size_t sz, u64 val)
+{
+	static const struct {
+		u64 divisor;
+		const char *unit;
+	} table[] = {
+		{ 1000000000000000000ULL, "E" },
+		{ 1000000000000000ULL,    "P" },
+		{ 1000000000000ULL,       "T" },
+		{ 1000000000ULL,          "B" },
+		{ 1000000ULL,             "M" },
+		{ 1000ULL,                "K" },
+	};
+	int i;
+	char tmp[32];
+
+	for (i = 0; i < ARRAY_SIZE(table); i++) {
+		if (val >= table[i].divisor) {
+			u64 whole = val / table[i].divisor;
+			u64 frac = (val % table[i].divisor) /
+				   (table[i].divisor / 100);
+			scnprintf(tmp, sizeof(tmp), "%llu.%02llu %s",
+				  whole, frac, table[i].unit);
+			strlcat(buf, tmp, sz);
+			return;
+		}
+	}
+
+	scnprintf(tmp, sizeof(tmp), "%llu", (unsigned long long)val);
+	strlcat(buf, tmp, sz);
+}
+/* ------------------------------------------------------------------ */
+/* fmt_val -- Write val to buf with comma separators, right-aligned    *
+ * to @width.  If @width is 0, no padding is applied.                 */
+/* ------------------------------------------------------------------ */
+static void fmt_val(char *buf, size_t sz, u64 val, unsigned int width)
+{
+	char tmp[32];
+	unsigned int len;
+
+	if (val == 0) {
+		scnprintf(tmp, sizeof(tmp), "0");
+	} else {
+		char raw[24];
+		int raw_len, i, pos = 0;
+
+		scnprintf(raw, sizeof(raw), "%llu", (unsigned long long)val);
+		raw_len = strlen(raw);
+
+		for (i = 0; i < raw_len; i++) {
+			if (i > 0 && (raw_len - i) % 3 == 0)
+				tmp[pos++] = ',';
+			tmp[pos++] = raw[i];
+		}
+		tmp[pos] = '\0';
+	}
+
+	len = strlen(tmp);
+	if (width > 0 && len < width) {
+		char padded[32];
+		scnprintf(padded, sizeof(padded), "%*s", width, tmp);
+		strlcat(buf, padded, sz);
+	} else {
+		strlcat(buf, tmp, sz);
+	}
+}
+/* ------------------------------------------------------------------ */
+/* Stats display handler                                               */
+/* ------------------------------------------------------------------ */
+static int infinity_stats_proc_handler(const struct ctl_table *ctl, int write,
+				       void *buffer, size_t *lenp,
+				       loff_t *ppos)
+{
+	/*
+	 * ┌─────────────────────────────────────────────────────────────┐
+	 * │ Output format key (fixed-width columns):                    │
+	 * │   col 0-22: label (left-aligned, 22 chars)                 │
+	 * │   col 23-36: value (right-aligned, 14 chars, comma-sep)    │
+	 * │   col 37+: description                                     │
+	 * └─────────────────────────────────────────────────────────────┘
+	 */
+	char buf[1024];
+	u64 fbc, emc, wkc, rtc, gcb, gapp, gskp, gxcp;
+
+	if (write)
+		return -EROFS;
+
+	/*
+	 * Read counters through unsigned int to prevent sign-extension
+	 * of a wrapped 32-bit atomic_t from producing absurd u64 values.
+	 */
+	fbc  = (u64)(unsigned int)atomic_read(&infinity_futex_boost_count);
+	emc  = (u64)(unsigned int)atomic_read(&infinity_ema_climb_count);
+	wkc  = (u64)(unsigned int)atomic_read(&infinity_wakeup_count);
+	rtc  = (u64)(unsigned int)atomic_read(&infinity_rt_throttle_count);
+	gcb  = (u64)(unsigned int)atomic_read(&infinity_gpu_completion_callbacks);
+	gapp = (u64)(unsigned int)atomic_read(&infinity_gpu_accounting_applied);
+	gskp = (u64)(unsigned int)atomic_read(&infinity_gpu_accounting_skipped);
+	gxcp = (u64)(unsigned int)atomic_read(&infinity_gpu_cross_couplings);
+
+	buf[0] = '\0';
+
+	/* Header */
+	scnprintf(buf + strlen(buf), sizeof(buf) - strlen(buf),
+		  "Infinity Scheduler v4.6-gpu\n");
+	strlcat(buf,
+		"──────────────────────────────────────────────────────────────────────\n",
+		sizeof(buf));
+
+	/* CPU section */
+	strlcat(buf, "CPU\n", sizeof(buf));
+
+	strlcat(buf, "  Futex boosts        ", sizeof(buf));
+	fmt_val(buf, sizeof(buf), fbc, 14);
+	if (emc) {
+		scnprintf(buf + strlen(buf), sizeof(buf) - strlen(buf),
+			  "  %llu%% of tasks\n",
+			  div64_u64(fbc * 100ULL, emc));
+	} else {
+		strlcat(buf, "  N/A\n", sizeof(buf));
+	}
+
+	strlcat(buf, "  EMA climbs          ", sizeof(buf));
+	fmt_val(buf, sizeof(buf), emc, 14);
+	strlcat(buf, "\n", sizeof(buf));
+
+	strlcat(buf, "  Wakeup decays       ", sizeof(buf));
+	fmt_val(buf, sizeof(buf), wkc, 14);
+	strlcat(buf, "\n", sizeof(buf));
+
+	strlcat(buf, "  Per-task EMA range  0 - 10,000\n",
+		sizeof(buf));
+
+	/* RT section */
+	strlcat(buf, "\nRT\n", sizeof(buf));
+	strlcat(buf, "  RT throttles        ", sizeof(buf));
+	fmt_val(buf, sizeof(buf), rtc, 14);
+	strlcat(buf, "  0 rogue SCHED_FIFO (>95%% rt_ema)\n",
+		sizeof(buf));
+
+	/* GPU section */
+	strlcat(buf, "\nGPU\n", sizeof(buf));
+
+	strlcat(buf, "  Completion entered  ", sizeof(buf));
+	fmt_val(buf, sizeof(buf), gcb, 14);
+	strlcat(buf, "  fence callbacks fired\n", sizeof(buf));
+
+	strlcat(buf, "  Accounting applied  ", sizeof(buf));
+	fmt_val(buf, sizeof(buf), gapp, 14);
+	if (gcb) {
+		u64 whole = div64_u64(gapp * 100ULL, gcb);
+		u64 frac  = div64_u64(gapp * 10000ULL, gcb) % 100;
+		scnprintf(buf + strlen(buf), sizeof(buf) - strlen(buf),
+			  "  %llu.%02llu%%\n", whole, frac);
+	} else {
+		strlcat(buf, "  N/A\n", sizeof(buf));
+	}
+
+	strlcat(buf, "  \xe2\x94\x9c\xe2\x94\x80 trylock failures  ", sizeof(buf));
+	fmt_val(buf, sizeof(buf), 0, 14);
+	strlcat(buf, "  (lock contention)\n", sizeof(buf));
+
+	strlcat(buf, "  \xe2\x94\x94\xe2\x94\x80 entity not found  ", sizeof(buf));
+	fmt_val(buf, sizeof(buf), gskp, 14);
+	strlcat(buf, "  (entity_kill race)\n", sizeof(buf));
+
+	strlcat(buf, "  Cross-couplings     ", sizeof(buf));
+	fmt_val(buf, sizeof(buf), gxcp, 14);
+	if (gapp) {
+		u64 whole = div64_u64(gxcp * 100ULL, gapp);
+		u64 frac  = div64_u64(gxcp * 10000ULL, gapp) % 100;
+		scnprintf(buf + strlen(buf), sizeof(buf) - strlen(buf),
+			  "  %llu.%02llu%% of total\n", whole, frac);
+	} else {
+		strlcat(buf, "  N/A of total\n", sizeof(buf));
+	}
+
+	/* Footer */
+	strlcat(buf,
+		"──────────────────────────────────────────────────────────────────────\n",
+		sizeof(buf));
+
+	if (gcb) {
+		u64 whole = div64_u64(gapp * 100ULL, gcb);
+		u64 frac  = div64_u64(gapp * 10000ULL, gcb) % 100;
+		scnprintf(buf + strlen(buf), sizeof(buf) - strlen(buf),
+			  "Accounting confidence: %llu.%02llu%%  (", whole, frac);
+		fmt_val(buf, sizeof(buf), gapp, 0);
+		strlcat(buf, " / ", sizeof(buf));
+		fmt_val(buf, sizeof(buf), gcb, 0);
+		strlcat(buf, " completions)\n", sizeof(buf));
+	} else {
+		strlcat(buf,
+			"Accounting confidence: N/A  (no GPU jobs tracked)\n",
+			sizeof(buf));
+	}
+
+	if (gcb && gapp == gcb)
+		strlcat(buf,
+			"Verdict: All counters healthy \xe2\x80\x94 system operating normally\n",
+			sizeof(buf));
+	else if (gcb && gapp < gcb)
+		strlcat(buf,
+			"Verdict: Accounting mismatch detected \xe2\x80\x94 see above for details\n",
+			sizeof(buf));
+	else
+		strlcat(buf, "Verdict: No GPU jobs recorded yet\n",
+			sizeof(buf));
+
+	{
+		struct ctl_table tmp = *ctl;
+		tmp.data = buf;
+		tmp.maxlen = sizeof(buf);
+		return proc_dostring(&tmp, write, buffer, lenp, ppos);
+	}
+}
