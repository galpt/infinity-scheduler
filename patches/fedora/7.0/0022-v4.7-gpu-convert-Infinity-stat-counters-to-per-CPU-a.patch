 		WRITE_ONCE(s_job->infinity_gpu_ns, gpu_ns);
-		atomic_inc(&infinity_gpu_completion_callbacks);
+		atomic_inc(this_cpu_ptr(&infinity_gpu_completion_callbacks));
 	}
 
 	trace_drm_sched_job_done(s_fence);
@@ -1334,9 +1334,9 @@ drm_sched_get_finished_job(struct drm_gpu_scheduler *sched, bool *have_more)
 				if (gpu_ns)
