 include/drm/gpu_scheduler.h            |  15 ++--
 kernel/sched/fair.c                    |   6 +-
 kernel/sched/infinity_sched.c          | 109 +++++++++++++++----------
 kernel/sched/infinity_sched.h          |  20 ++---
 kernel/sched/rt.c                      |   2 +-
 6 files changed, 95 insertions(+), 69 deletions(-)

