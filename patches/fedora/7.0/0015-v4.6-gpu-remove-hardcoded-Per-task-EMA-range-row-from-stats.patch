From cb1d6dda0d90ea4ce531913b3ea580ee9b408d09 Mon Sep 17 00:00:00 2001
From: Galih Tama <galpt@v.recipes>
Date: Tue, 28 Jul 2026 07:56:32 +0700
Subject: [PATCH v4.6-gpu] v4.6-gpu: remove hardcoded Per-task EMA range row
 from stats

This row was a static string that never changed in real time and
provided no diagnostic value.

Signed-off-by: Galih Tama <galpt@v.recipes>
---
 kernel/sched/infinity_sched.c | 3 ---
 1 file changed, 3 deletions(-)

diff --git a/kernel/sched/infinity_sched.c b/kernel/sched/infinity_sched.c
index b91d23892..07cf33101 100644
--- a/kernel/sched/infinity_sched.c
+++ b/kernel/sched/infinity_sched.c
@@ -263,9 +263,6 @@ static int infinity_stats_proc_handler(const struct ctl_table *ctl, int write,
 		  "Wakeup decays",
 		  fill_pretty_llu(v1, sizeof(v1), wkc), "");
 
-	scnprintf(buf + strlen(buf), bufsz - strlen(buf), ROW,
-		  "Per-task EMA range",
-		  "   0 - 10,000", "");
 
 	strlcat(buf, SEP, bufsz);
 	strlcat(buf, "\n\n", bufsz);
-- 
2.55.0

